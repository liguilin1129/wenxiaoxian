/* ===== 全局悬浮 AI 助手（微信聊天风格） ===== */
.ai-wrap {
  display: block;
  height: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ---- 悬浮按钮（FAB） ---- */
.ai-fab {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6E6CF0, #5E5CE6);
  box-shadow:
    0 8rpx 28rpx rgba(94, 92, 230, 0.4),
    0 2rpx 8rpx rgba(94, 92, 230, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 998;
  transition: transform 0.2s ease;
}
.ai-fab.moving {
  transition: none;
  opacity: 0.95;
}
.ai-fab.fab-hover {
  transform: scale(0.92);
}

/* 呼吸光环 */
.fab-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 3rpx solid rgba(22, 208, 106, 0.35);
  animation: ai-pulse 2.5s ease-in-out infinite;
}
@keyframes ai-pulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.18); opacity: 0; }
}
.fab-icon {
  position: relative;
  z-index: 1;
}
.fab-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,.15);
}
.ai-compact { position:fixed; right:30rpx; bottom:42rpx; display:flex; align-items:center; justify-content:center; width:86rpx; height:86rpx; border:4rpx solid rgba(255,255,255,.94); border-radius:50%; color:#fff; background:linear-gradient(145deg,#7C9EF4,#4C7FE3); box-shadow:0 8rpx 22rpx rgba(76,127,227,.28); font-size:25rpx; font-weight:800; z-index:998; }.ai-compact:active { transform:scale(.94); }

/* ---- 遮罩层 ---- */
.ai-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.35);
  z-index: 10000;
  animation: fade-in 0.2s ease;
  margin: 0;
  padding: 0;
  overflow: hidden;
  /* 阻断开发者工具鼠标滚轮的滚动链，避免滚到遮罩后的页面。 */
  overscroll-behavior: contain;
}
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ---- 聊天面板（贴底弹层） ---- */
.ai-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* top 由 JS 动态设置（导航栏底部），不可超出系统导航栏 */
  background: rgba(245, 245, 247, 0.82);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin: 0;
  padding: 0;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
  z-index: 1;
  overscroll-behavior: contain;
  animation: sheet-up 0.28s cubic-bezier(.22, .9, .33, 1);
}
@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 面板头部（微信导航栏风格） */
.panel-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #F7F7F7;
  border-bottom: 1rpx solid #DADADA;
  flex-shrink: 0;
}
.panel-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.panel-back-x {
  font-size: 52rpx;
  color: #181818;
  line-height: 1;
  font-weight: 400;
}
.panel-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 32rpx;
  font-weight: 600;
  color: #181818;
}
.panel-placeholder {
  width: 56rpx;
}

/* ---- 聊天消息区（微信风格） ---- */
.chat-body {
  flex: none;
  min-height: 0;
  background: #EDEDED;
  padding: 24rpx 20rpx 16rpx;
  box-sizing: border-box;
  overscroll-behavior: contain;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}
.msg-row.user {
  flex-direction: row-reverse;
}

/* 头像 */
.msg-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,.06);
}
.avatar-emoji {
  font-size: 42rpx;
  line-height: 1;
}
.msg-row.ai .msg-avatar {
  margin-right: 16rpx;
}
.msg-row.user .msg-avatar {
  margin-left: 16rpx;
}

/* 消息主容器（气泡 + 操作按钮） */
.msg-main {
  max-width: 66%;
  display: flex;
  flex-direction: column;
}
.msg-row.ai .msg-main {
  align-items: flex-start;
}
.msg-row.user .msg-main {
  align-items: flex-end;
}

/* 气泡 */
.msg-bubble {
  padding: 20rpx 24rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-word;
  position: relative;
  color: #181818;
  box-shadow: 0 1rpx 1rpx rgba(0,0,0,.04);
}

/* AI 气泡：白底 + 左尖角 */
.msg-row.ai .msg-bubble {
  background: #FFFFFF;
}
.msg-row.ai .msg-bubble::after {
  content: '';
  position: absolute;
  top: 24rpx;
  left: -11rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 12rpx 12rpx 12rpx 0;
  border-color: transparent #FFFFFF transparent transparent;
}

/* 用户气泡：品牌紫 + 右尖角 */
.msg-row.user .msg-bubble {
  background: #5E5CE6;
  color: #fff;
}
.msg-row.user .msg-bubble::after {
  content: '';
  position: absolute;
  top: 24rpx;
  right: -11rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 12rpx 0 12rpx 12rpx;
  border-color: transparent transparent transparent #5E5CE6;
}

/* 正在输入（三点动画） */
.msg-bubble.typing {
  display: flex;
  gap: 8rpx;
  align-items: center;
  padding: 24rpx 26rpx;
}
.msg-bubble.typing .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #B2B2B2;
  animation: blink 1.2s infinite ease-in-out;
}
.msg-bubble.typing .dot:nth-child(2) { animation-delay: 0.2s; }
.msg-bubble.typing .dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink {
  0%, 60%, 100% { opacity: 0.25; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-4rpx); }
}

/* ---- AI 建议操作按钮 ---- */
.msg-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.msg-action {
  padding: 12rpx 22rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #5E5CE6;
  border: 1rpx solid #5E5CE6;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,.04);
}
.msg-action:active {
  background: #E6F7ED;
}
.msg-action.done {
  color: #5B6B61;
  background: #E6F7ED;
  border-color: #B8DCC5;
}

/* ---- 输入栏（微信风格） ---- */
.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #DADADA;
  background: #F7F7F7;
  flex-shrink: 0;
}
.text-input-mode,
.voice-input-mode {
  width: 100%;
  display: flex;
  align-items: center;
}
.voice-input-mode { gap: 16rpx; }
.mode-switch {
  width: 72rpx;
  height: 72rpx;
  color: #3A3A3C;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 44rpx;
  line-height: 1;
}
.voice-hold {
  flex: 1;
  height: 76rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #202124;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.voice-hold.voice-recording {
  color: #FFFFFF;
  background: #5E5CE6;
  animation: voice-breathe 1.1s ease-in-out infinite;
}
@keyframes voice-breathe {
  50% { transform: scale(.96); opacity: .85; }
}
.chat-input-box {
  flex: 1;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}
.chat-input {
  flex: 1;
  height: 72rpx;
  font-size: 30rpx;
  color: #181818;
  line-height: 72rpx;
}
.input-mic {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mic-symbol {
  position: relative;
  width: 19rpx;
  height: 30rpx;
  border: 4rpx solid #6C6C70;
  border-radius: 13rpx;
  box-sizing: border-box;
}
.mic-symbol::before {
  content: '';
  position: absolute;
  width: 30rpx;
  height: 22rpx;
  border: 4rpx solid #6C6C70;
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
  left: -10rpx;
  top: 12rpx;
  box-sizing: border-box;
}
.mic-symbol::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 10rpx;
  background: #6C6C70;
  border-radius: 4rpx;
  left: 4rpx;
  top: 29rpx;
  box-shadow: -6rpx 9rpx 0 -1rpx #6C6C70, 6rpx 9rpx 0 -1rpx #6C6C70;
}
.chat-ph {
  color: #B2B2B2;
  font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 10rpx;
  background: #E3E3E3;
  color: #9A9A9A;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s ease;
}
.send-btn.send-on {
  background: #5E5CE6;
  color: #FFFFFF;
}
.send-btn.send-on:active { opacity: 0.85; }
