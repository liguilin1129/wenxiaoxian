<!-- 全局悬浮 AI 助手（微信聊天风格） -->
<view class="ai-wrap">
  <view wx:if="{{!showPanel && !tabMode}}" class="ai-compact" bindtap="openPanel"><text>AI</text></view>

  <!-- 聊天面板（贴底弹层） -->
  <scroll-view wx:if="{{showPanel}}" class="ai-mask" scroll-y="{{false}}" bindtap="onClose" catchtouchmove="preventMove">
    <view class="ai-panel" style="top: 0; bottom: {{kbBottom}}" catchtap="preventMove">
      <!-- 面板头部（微信导航栏风格） -->
      <view class="panel-header">
        <view class="panel-back" bindtap="onClose">
          <text class="panel-back-x">‹</text>
        </view>
        <text class="panel-title">小贤 AI 助手</text>
        <view class="panel-placeholder"></view>
      </view>

      <!-- 消息区 -->
      <scroll-view class="chat-body" style="height: {{bodyHeight}}px" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation>
        <view
          wx:for="{{messages}}"
          wx:key="id"
          id="msg-{{item.id}}"
          class="msg-row {{item.role}}"
        >
          <view class="msg-avatar">
            <text class="avatar-emoji">{{item.role === 'user' ? '😊' : '🤖'}}</text>
          </view>
          <view class="msg-main">
            <view class="msg-bubble">{{item.content}}</view>
            <view wx:if="{{item.actions && item.actions.length}}" class="msg-actions">
              <view
                wx:for="{{item.actions}}"
                wx:for-item="act"
                wx:key="label"
                class="msg-action {{act.done ? 'done' : ''}}"
                data-action="{{act}}"
                bindtap="handleAction"
              >{{act.label}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{typing}}" class="msg-row ai">
          <view class="msg-avatar">
            <text class="avatar-emoji">🤖</text>
          </view>
          <view class="msg-bubble typing">
            <text class="dot"></text>
            <text class="dot"></text>
            <text class="dot"></text>
          </view>
        </view>
      </scroll-view>

      <!-- 输入栏（微信风格） -->
      <view class="chat-input-bar" catchtouchmove="preventMove">
        <view wx:if="{{inputMode === 'text'}}" class="text-input-mode">
          <view class="chat-input-box">
          <input
            class="chat-input"
            value="{{draft}}"
            bindinput="onInput"
            adjust-position="{{false}}"
            always-embed="{{true}}"
            bindfocus="onKbFocus"
            bindblur="onKbBlur"
            bindkeyboardheightchange="onKbHeightChange"
            placeholder="发送消息…"
            placeholder-class="chat-ph"
            confirm-type="send"
            bindconfirm="onSend"
            cursor-spacing="10"
          />
            <view class="input-mic" bindtap="switchToVoice" aria-label="切换语音输入">
              <view class="mic-symbol"></view>
            </view>
          </view>
          <view class="send-btn {{draft ? 'send-on' : ''}}" bindtap="onSend">发送</view>
        </view>
        <view wx:else class="voice-input-mode">
          <view class="mode-switch" bindtap="switchToText" aria-label="切换键盘输入">⌨</view>
          <view
            class="voice-hold {{voiceRecording ? 'voice-recording' : ''}}"
            catchtouchstart="startVoiceInput"
            catchtouchend="stopVoiceInput"
            catchtouchcancel="stopVoiceInput"
          >{{voiceRecording ? '松开结束' : '按住 说话'}}</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
