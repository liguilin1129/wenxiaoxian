/* 发现页 · 文章列表 */

.tabs {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
  background: #F5F5F7;
}

.tab {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: var(--ink-3);
  background: #fff;
  border: 1px solid var(--line);
}
.tab.on {
  color: #fff;
  background: var(--brand);
  border-color: var(--brand);
  font-weight: 600;
}

.alist { margin-top: 8rpx; }

.acard {
  display: flex;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.acard-hover { background: var(--surface-2); }

.acover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  color: var(--brand-700);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex: none;
  margin-right: 22rpx;
}

.ainfo { flex: 1; min-width: 0; }
.acat {
  display: inline-flex;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--brand-700);
  background: var(--brand-soft);
  margin-bottom: 10rpx;
}
.atitle {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-1);
  line-height: 1.4;
}
.asummary {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.ameta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.adot { color: var(--ink-4); }
