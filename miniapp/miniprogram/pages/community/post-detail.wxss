.post-page { min-height:100vh; box-sizing:border-box; padding:28rpx 28rpx calc(150rpx + env(safe-area-inset-bottom)); background:#F6F6FA; }.detail-card,.comment-card { border:1rpx solid var(--line); border-radius:24rpx; background:#fff; box-shadow:0 3rpx 10rpx rgba(17,17,26,.035); }.detail-card { padding:28rpx; }.detail-author { display:flex; align-items:center; gap:16rpx; }.detail-author-text { flex:1; }.detail-name,.comment-name { color:var(--ink-1); font-size:28rpx; font-weight:700; }.detail-time,.comment-time { margin-top:5rpx; color:var(--ink-3); font-size:21rpx; }.detail-text { margin-top:22rpx; color:var(--ink-1); font-size:29rpx; line-height:1.75; white-space:pre-wrap; }.detail-media { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }.detail-media-item { position:relative; width:calc((100% - 24rpx) / 3); aspect-ratio:1; overflow:hidden; border-radius:16rpx; background:var(--surface-2); }.detail-media-item image { width:100%; height:100%; }.detail-play { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:48rpx; height:48rpx; border-radius:50%; background:rgba(0,0,0,.55); color:#fff; text-align:center; line-height:48rpx; font-size:20rpx; }.detail-actions { display:flex; gap:20rpx; margin-top:24rpx; padding-top:18rpx; border-top:1rpx solid var(--sep); color:var(--ink-3); font-size:24rpx; }.comment-title { margin:34rpx 8rpx 18rpx; color:var(--ink-1); font-size:31rpx; font-weight:800; }.comment-title text { color:var(--ink-3); font-size:22rpx; font-weight:400; }.comment-card { display:flex; gap:16rpx; margin-bottom:16rpx; padding:22rpx; }.comment-body { flex:1; }.comment-text { margin-top:8rpx; color:var(--ink-2); font-size:27rpx; line-height:1.55; }.comment-empty { padding:46rpx 20rpx; color:var(--ink-3); font-size:25rpx; text-align:center; }.comment-bar { position:fixed; left:0; right:0; bottom:0; z-index:20; display:flex; gap:16rpx; align-items:center; padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--line); background:rgba(255,255,255,.96); }.comment-bar input { flex:1; min-width:0; height:68rpx; padding:0 20rpx; border-radius:999rpx; background:var(--surface-2); color:var(--ink-1); font-size:26rpx; }.comment-bar button { flex:none; margin:0; padding:0 22rpx; border-radius:999rpx; background:var(--brand); color:#fff; font-size:25rpx; line-height:68rpx; }
