<view class="scr-head"><view class="greet">成长社区</view><view class="title">帖子详情</view></view>
<scroll-view wx:if="{{post}}" class="post-page" scroll-y>
  <view class="detail-card"><view class="detail-author"><view class="avatar sm">{{post.avatar}}</view><view class="detail-author-text"><view class="detail-name">{{post.name}}</view><view class="detail-time">{{post.time}}{{post.tag ? ' · #' + post.tag : ''}}</view></view></view><view class="detail-text">{{post.text}}</view><view wx:if="{{post.media && post.media.length}}" class="detail-media"><view wx:for="{{post.media}}" wx:for-item="m" wx:for-index="mi" wx:key="mi" class="detail-media-item" data-list="{{post.media}}" data-index="{{mi}}" bindtap="previewMedia"><image src="{{m.thumb}}" mode="aspectFill"/><view wx:if="{{m.type === 'video'}}" class="detail-play">▶</view></view></view><view class="detail-actions"><text>♡ {{post.likes}}</text><text>💬 {{post.comments}}</text></view></view>
  <view class="comment-title">全部评论 <text>{{comments.length}}</text></view><view class="comment-card" wx:for="{{comments}}" wx:key="index"><view class="avatar sm">{{item.avatar}}</view><view class="comment-body"><view class="comment-name">{{item.name}}</view><view class="comment-text">{{item.text}}</view><view class="comment-time">{{item.time}}</view></view></view>
  <view wx:if="{{!comments.length}}" class="comment-empty">还没有评论，来说一句鼓励的话吧～</view>
</scroll-view>
<view class="comment-bar"><input value="{{commentText}}" bindinput="inputComment" placeholder="说点友善的话…" maxlength="100"/><button bindtap="sendComment">发送</button></view>
<ai-assistant />
