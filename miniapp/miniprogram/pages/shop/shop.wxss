.shop-page { min-height:100vh; box-sizing:border-box; padding:28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background:var(--bg); }
.shop-hero { padding:38rpx 32rpx; border-radius:28rpx; color:#fff; background:linear-gradient(135deg,#4D6957,#93A77D); box-shadow:0 14rpx 30rpx rgba(50,78,58,.18); }.shop-eyebrow { font-size:19rpx; letter-spacing:2rpx; opacity:.72; }.shop-hero-title { margin-top:14rpx; font-size:38rpx; font-weight:750; line-height:1.35; }.shop-hero-sub { margin-top:16rpx; font-size:24rpx; opacity:.8; }
.shop-section-head { display:flex; align-items:end; justify-content:space-between; margin:34rpx 4rpx 20rpx; }.shop-section-title { color:var(--ink-1); font-size:34rpx; font-weight:750; }.shop-section-sub { margin-top:6rpx; color:var(--ink-3); font-size:23rpx; }
.shop-categories { width:calc(100% + 8rpx); white-space:nowrap; margin:0 0 20rpx -4rpx; }.shop-category-list { display:inline-flex; gap:14rpx; padding:0 4rpx; }.shop-category { padding:14rpx 24rpx; border-radius:99rpx; color:var(--ink-2); font-size:25rpx; background:var(--surface); }.shop-category.active { color:#fff; background:#4D6957; }
.shop-empty { padding:84rpx 24rpx; background:#fff; border-radius:24rpx; color:var(--ink-3); text-align:center; font-size:27rpx; line-height:1.7; }.shop-empty-title { margin-bottom:10rpx; color:var(--ink-1); font-size:31rpx; font-weight:700; }
.points-mall-entry { display:flex; align-items:center; justify-content:space-between; padding:28rpx; margin-bottom:20rpx; border-radius:24rpx; background:linear-gradient(135deg,#FFF4E9,#FFFDFC); }
.points-mall-title { color:var(--ink-1); font-size:32rpx; font-weight:700; }.points-mall-sub { margin-top:8rpx; color:var(--ink-3); font-size:24rpx; }.points-mall-arrow { color:#C05D3A; font-size:42rpx; }
.shop-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18rpx; }
.shop-product { min-width:0; overflow:hidden; padding-bottom:22rpx; border-radius:24rpx; background:#fff; box-shadow:0 6rpx 18rpx rgba(40,45,40,.05); }
.shop-image { display:block; width:100%; height:280rpx; background:#ECECF2; }
.shop-product-body { padding:16rpx 20rpx 0; }.shop-product-tag { display:inline-block; padding:4rpx 10rpx; border-radius:8rpx; color:#597364; font-size:19rpx; background:#EDF5EE; }.shop-name { margin-top:12rpx; color:var(--ink-1); font-size:26rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.shop-price { margin-top:10rpx; color:#C05D3A; font-size:30rpx; font-weight:700; }
