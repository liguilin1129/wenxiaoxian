.shop-page { min-height:100vh; box-sizing:border-box; padding:20rpx 0 calc(48rpx + env(safe-area-inset-bottom)); background:#fff; }
.shop-top-bar { display:flex; align-items:center; gap:16rpx; margin:0 28rpx; }.shop-search { display:flex; flex:1; align-items:center; justify-content:space-between; min-width:0; height:76rpx; padding:0 20rpx; border-radius:4rpx; background:#F5F4F8; }.shop-search-text { overflow:hidden; color:#9A99A5; font-size:25rpx; white-space:nowrap; text-overflow:ellipsis; }.shop-search-icon { flex:none; color:var(--ink-2); font-size:38rpx; line-height:1; }
.points-mall-top-button { display:flex; flex:none; align-items:center; justify-content:center; width:102rpx; height:66rpx; margin:0; padding:0; border:0; border-radius:33rpx; color:#fff; font-size:20rpx; font-weight:700; letter-spacing:0; background:var(--brand); box-shadow:0 6rpx 14rpx rgba(94,92,230,.2); box-sizing:border-box; }.points-mall-top-button::after { border:none; }.points-mall-top-button:active { transform:scale(.96); background:var(--brand-700); }
.shop-categories { width:100%; white-space:nowrap; margin:30rpx 0 0; border-bottom:1rpx solid #F0F0F4; }.shop-category-list { display:inline-flex; align-items:center; gap:40rpx; min-width:100%; padding:0 28rpx; box-sizing:border-box; }.shop-category { position:relative; padding:0 0 20rpx; color:var(--ink-2); font-size:29rpx; font-weight:600; background:transparent; }.shop-category.active { color:var(--ink-1); font-size:34rpx; font-weight:750; }.shop-category.active:after { content:''; position:absolute; left:50%; bottom:0; width:42rpx; height:6rpx; border-radius:6rpx; background:var(--brand); transform:translateX(-50%); }.shop-category-more { padding:0 0 20rpx; color:var(--ink-2); font-size:27rpx; white-space:nowrap; }
.shop-topics { width:100%; white-space:nowrap; padding:32rpx 0 28rpx; box-sizing:border-box; }.shop-topic-list { display:inline-flex; gap:30rpx; padding:0 34rpx; }.shop-topic { display:flex; flex-direction:column; align-items:center; min-width:100rpx; color:var(--ink-1); font-size:23rpx; }.shop-topic-icon { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; margin-bottom:12rpx; color:#fff; font-size:34rpx; font-weight:750; border-radius:22rpx 22rpx 22rpx 8rpx; background:linear-gradient(145deg,var(--brand-2),var(--brand-700)); }.topic-brand { background:linear-gradient(145deg,#8B87FF,#5C58D2); }.topic-parent { background:linear-gradient(145deg,#9C99FB,#726FE8); }.topic-growth { background:linear-gradient(145deg,#7775EF,#4F46C8); }.topic-more { background:var(--brand-soft); color:var(--brand-700); }
.shop-notice { display:flex; align-items:center; gap:14rpx; padding:19rpx 28rpx; color:var(--ink-2); background:#FAFAFC; }.shop-notice-badge { padding:5rpx 8rpx; color:#fff; font-size:19rpx; border-radius:5rpx; background:var(--brand-700); }.shop-notice-main { flex:1; overflow:hidden; font-size:25rpx; white-space:nowrap; text-overflow:ellipsis; }.shop-notice-link { flex:none; color:var(--ink-3); font-size:21rpx; }
.shop-empty { margin:22rpx 24rpx 0; padding:70rpx 24rpx; background:#FAFAFC; border-radius:10rpx; color:var(--ink-3); text-align:center; font-size:26rpx; line-height:1.7; }.shop-empty-icon { display:flex; align-items:center; justify-content:center; width:72rpx; height:72rpx; margin:0 auto 18rpx; color:var(--brand); font-size:36rpx; border-radius:24rpx; background:var(--brand-soft); }.shop-empty-title { margin-bottom:10rpx; color:var(--ink-1); font-size:31rpx; font-weight:700; }
.shop-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:4rpx; margin-top:4rpx; background:#F2F2F5; }
.shop-product { min-width:0; overflow:hidden; padding-bottom:20rpx; border-radius:0; background:#fff; box-shadow:none; }.shop-product:active { transform:scale(.985); }
.shop-image-wrap { position:relative; }.shop-image { display:block; width:100%; height:280rpx; background:#ECECF2; }.shop-image-placeholder { display:flex; align-items:center; justify-content:center; color:var(--ink-3); font-size:23rpx; background:linear-gradient(145deg,#F4F3FF,#E9E8FB); }.shop-product-badge { position:absolute; top:14rpx; left:14rpx; max-width:calc(100% - 28rpx); padding:6rpx 12rpx; overflow:hidden; color:#fff; font-size:19rpx; border-radius:8rpx; white-space:nowrap; text-overflow:ellipsis; background:rgba(69,63,195,.9); }
.shop-product-body { padding:16rpx 20rpx 0; }.shop-product-tag { display:inline-block; max-width:100%; padding:4rpx 10rpx; overflow:hidden; border-radius:5rpx; color:var(--brand-700); font-size:19rpx; white-space:nowrap; text-overflow:ellipsis; background:var(--brand-soft); }.shop-name { margin-top:12rpx; color:var(--ink-1); font-size:26rpx; font-weight:600; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.shop-price-row { display:flex; align-items:baseline; gap:10rpx; min-width:0; margin-top:12rpx; }.shop-price { flex:none; color:var(--brand-700); font-size:23rpx; font-weight:700; }.shop-price text { margin-left:2rpx; font-size:34rpx; }.shop-original-price { min-width:0; overflow:hidden; color:var(--ink-3); font-size:20rpx; text-decoration:line-through; white-space:nowrap; text-overflow:ellipsis; }.shop-product-foot { display:flex; align-items:center; justify-content:space-between; gap:8rpx; margin-top:14rpx; padding-top:13rpx; border-top:1rpx solid #F0F0F4; }.shop-sales { overflow:hidden; color:var(--ink-3); font-size:19rpx; white-space:nowrap; text-overflow:ellipsis; }.shop-detail-action { flex:none; color:var(--brand); font-size:20rpx; }
