/* 今日打卡样式复用 app.wxss */

.checkin-section { margin: 30rpx 4rpx 14rpx; }
.checkin-section-title { font-size: 27rpx; font-weight: 700; color: var(--ink-1); }
.checkin-section-title text { margin-left: 8rpx; color: var(--ink-3); font-size: 23rpx; }
.checkin-done-title { margin-top: 38rpx; }
.checkin-completed { opacity: .7; }
.checkin-completed .tn { text-decoration: line-through; color: var(--ink-3); }
.pill-ai { color: #4F46E5; background: #EEEDFE; }
.pill-goal { color: #16835A; background: #EAF8F1; }

.record-section { margin-top: 42rpx; }
.checkin-record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}
.record-name { font-size: 28rpx; color: var(--ink-1); font-weight: 600; }
.record-date { margin-top: 7rpx; font-size: 22rpx; color: var(--ink-3); }
.record-points { font-size: 30rpx; color: var(--brand-600); font-weight: 700; }

.all-done {
  background: linear-gradient(135deg, #ECFDF5, #EEEDFE);
  border: 1px solid var(--brand-soft);
  color: var(--brand-700);
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 24rpx;
}
