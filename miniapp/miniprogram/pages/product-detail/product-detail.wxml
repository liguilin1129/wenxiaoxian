<view class="product-page">
  <block wx:if="{{product}}">
    <view class="detail-nav"><view class="detail-nav-btn" bindtap="goShop">‹</view><view class="detail-nav-actions"><view>⌕</view><view>♡</view><view>•••</view></view></view>
    <swiper wx:if="{{product.gallery.length}}" class="product-gallery" indicator-dots="{{product.gallery.length > 1}}" circular="{{product.gallery.length > 1}}"><swiper-item wx:for="{{product.gallery}}" wx:key="*this"><image class="product-cover" src="{{item}}" mode="aspectFit"/></swiper-item></swiper>
    <view wx:else class="product-cover product-no-image"><view class="product-placeholder-icon">▧</view><view>商品图片展示位</view><view class="product-placeholder-sub">图片将由商城后台发布</view></view>
    <view class="media-switch"><view class="media-switch-active">商品</view><view>视频</view><view>图集</view></view>
    <view class="price-banner"><view class="price-label">商城价</view><view class="price-value">¥<text>{{product.priceText}}</text></view><view wx:if="{{product.originalPrice}}" class="original-price">¥{{product.originalPrice}}</view><view wx:if="{{product.salesText}}" class="sales-text">{{product.salesText}}</view><view wx:if="{{product.promotion}}" class="promotion-text">{{product.promotion}}</view></view>
    <view class="detail-card product-summary"><view class="product-preview-label" wx:if="{{product.isPreview}}">商品信息待发布</view><view class="product-title">{{product.name}}</view><view wx:if="{{product.tags.length}}" class="tag-row"><text wx:for="{{product.tags}}" wx:key="*this" class="trust-tag">{{item}}</text></view><view wx:if="{{product.pointsDeductionText}}" class="product-points-tip">{{product.pointsDeductionText}}</view></view>
    <view wx:if="{{product.skuOptions.length}}" class="detail-card"><view class="detail-row-head"><view class="product-heading">选择规格</view><text>共 {{product.skuOptions.length}} 款 ›</text></view><scroll-view class="sku-scroll" scroll-x="true" show-scrollbar="false"><view class="sku-list"><view wx:for="{{product.skuOptions}}" wx:key="id" class="sku-item {{selectedSkuId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseSku"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/><view wx:else class="sku-image-placeholder"></view><text>{{item.name}}</text></view></view></scroll-view><view wx:if="{{selectedSkuName}}" class="selected-sku">已选：{{selectedSkuName}}</view></view>
    <view class="detail-card"><view class="product-heading">物流与服务</view><view class="info-row"><text class="info-label">配送</text><view><view>{{product.deliveryText}}</view><view wx:if="{{product.shippingFrom}}" class="info-muted">{{product.shippingFrom}}</view></view></view><view class="service-tags"><text wx:for="{{product.serviceTags}}" wx:key="*this">✓ {{item}}</text></view></view>
    <view wx:if="{{product.attributes.length}}" class="detail-card"><view class="product-heading">核心参数</view><view class="attribute-grid"><view wx:for="{{product.attributes}}" wx:key="label" class="attribute-item"><text>{{item.label}}</text><text>{{item.value}}</text></view></view></view>
    <view wx:if="{{product.highlights.length}}" class="detail-card"><view class="product-heading">商品亮点</view><view class="product-highlights"><view wx:for="{{product.highlights}}" wx:key="*this">✓ {{item}}</view></view></view>
    <view class="detail-card"><view class="product-heading">商品介绍</view><view class="product-description">{{product.description || '商品介绍待后台补充'}}</view></view>
    <view class="product-notice">商品信息、库存及购买服务将以商城后台正式发布内容为准。</view>
  </block>
  <view wx:else class="product-empty">商品暂不可用</view>
  <view wx:if="{{product}}" class="bottom-action"><view class="action-icon" bindtap="goShop"><text>⌂</text><text>进店</text></view><view class="action-icon" bindtap="showService"><text>◌</text><text>客服</text></view><view class="action-icon" bindtap="showCart"><text>▣</text><text>加购</text></view><view class="buy-button" bindtap="showPending"><text>¥{{product.priceText}}</text><text>立即购买</text></view></view>
  <button wx:else class="product-back" bindtap="goShop">返回商城</button>
</view>
