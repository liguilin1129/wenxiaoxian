.product-page { min-height:100vh; box-sizing:border-box; padding:28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background:var(--bg); }
.product-gallery { width:100%; height:620rpx; overflow:hidden; border-radius:24rpx; background:#fff; }.product-cover { display:block; width:100%; height:620rpx; border-radius:24rpx; background:#fff; }
.product-no-image { display:flex; align-items:center; justify-content:center; color:var(--ink-3); font-size:26rpx; }
.product-card { margin-top:24rpx; padding:28rpx; background:#fff; border-radius:24rpx; }
.product-price { color:#C05D3A; font-size:40rpx; font-weight:700; }
.product-summary { margin-top:20rpx; }.product-category { display:inline-block; padding:5rpx 12rpx; margin-bottom:14rpx; color:#597364; font-size:21rpx; border-radius:8rpx; background:#EDF5EE; }
.product-preview-label { display:inline-block; padding:5rpx 12rpx; margin-bottom:14rpx; color:#8A6D42; font-size:21rpx; border-radius:8rpx; background:#FFF7E5; }
.product-title { margin-top:12rpx; color:var(--ink-1); font-size:32rpx; line-height:1.5; overflow-wrap:break-word; }
.product-points-tip { margin-top:12rpx; color:var(--brand); font-size:23rpx; }
.product-heading { color:var(--ink-1); font-size:28rpx; font-weight:700; }
.product-description { margin-top:18rpx; color:var(--ink-2); font-size:26rpx; line-height:1.7; white-space:pre-wrap; overflow-wrap:break-word; }
.product-highlights { display:grid; gap:16rpx; margin-top:20rpx; color:var(--ink-2); font-size:26rpx; }.product-highlights view { padding:16rpx 18rpx; border-radius:14rpx; background:var(--surface-2); }.product-notice { padding:20rpx 8rpx 0; color:var(--ink-3); font-size:22rpx; line-height:1.6; }
.product-empty { padding:84rpx 24rpx; background:#fff; border-radius:24rpx; color:var(--ink-3); font-size:27rpx; text-align:center; }
.product-back { margin-top:28rpx; border-radius:40rpx; background:var(--brand); color:#fff; font-size:28rpx; }

/* PDP conversion layout */
.product-page { padding:0 0 calc(130rpx + env(safe-area-inset-bottom)); }
.detail-nav { position:absolute; z-index:2; top:22rpx; left:24rpx; right:24rpx; display:flex; justify-content:space-between; }.detail-nav-btn,.detail-nav-actions view { display:flex; align-items:center; justify-content:center; width:60rpx; height:60rpx; border-radius:50%; color:#fff; font-size:38rpx; background:rgba(0,0,0,.36); }.detail-nav-actions { display:flex; gap:14rpx; }.detail-nav-actions view { font-size:28rpx; }
.product-gallery,.product-cover { height:660rpx; border-radius:0; }.product-no-image { flex-direction:column; background:linear-gradient(135deg,#F5F5F0,#E9EDE5); }.product-placeholder-icon { margin-bottom:18rpx; color:#829178; font-size:78rpx; }.product-placeholder-sub { margin-top:12rpx; color:var(--ink-3); font-size:22rpx; }
.media-switch { display:flex; justify-content:center; gap:50rpx; padding:17rpx 0; color:var(--ink-3); font-size:24rpx; background:#fff; }.media-switch-active { position:relative; color:var(--ink-1); font-weight:700; }.media-switch-active:after { content:''; position:absolute; left:50%; bottom:-13rpx; width:34rpx; height:5rpx; border-radius:5rpx; background:#C05D3A; transform:translateX(-50%); }
.price-banner { position:relative; padding:24rpx 28rpx; color:#fff; background:linear-gradient(100deg,#CF553D,#E58B62); }.price-label { font-size:22rpx; opacity:.9; }.price-value { margin-top:2rpx; font-size:30rpx; font-weight:700; }.price-value text { margin-left:4rpx; font-size:52rpx; }.original-price { display:inline-block; margin:4rpx 0 0 14rpx; font-size:22rpx; text-decoration:line-through; opacity:.72; }.sales-text { position:absolute; top:28rpx; right:28rpx; font-size:22rpx; }.promotion-text { margin-top:10rpx; font-size:22rpx; }
.detail-card { margin:18rpx 20rpx 0; padding:28rpx; border-radius:22rpx; background:#fff; }.product-summary { margin-top:18rpx; }.product-title { margin-top:0; font-weight:700; }.tag-row { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:18rpx; }.trust-tag { padding:5rpx 10rpx; color:#AF573E; font-size:20rpx; border-radius:6rpx; background:#FFF0EA; }
.detail-row-head { display:flex; align-items:center; justify-content:space-between; }.detail-row-head > text { color:var(--ink-3); font-size:23rpx; }.sku-scroll { margin:22rpx -4rpx 0; width:calc(100% + 8rpx); white-space:nowrap; }.sku-list { display:inline-flex; gap:14rpx; padding:0 4rpx; }.sku-item { display:flex; flex-direction:column; align-items:center; min-width:118rpx; max-width:142rpx; padding:10rpx; white-space:normal; color:var(--ink-2); font-size:21rpx; border:2rpx solid transparent; border-radius:14rpx; background:var(--surface-2); }.sku-item.selected { color:#B64E37; border-color:#D96A4D; background:#FFF7F2; }.sku-item image,.sku-image-placeholder { width:92rpx; height:92rpx; margin-bottom:9rpx; border-radius:9rpx; background:#EAEDEA; }.selected-sku { margin-top:18rpx; color:var(--ink-2); font-size:24rpx; }
.info-row { display:grid; grid-template-columns:70rpx 1fr; gap:20rpx; margin-top:24rpx; color:var(--ink-2); font-size:25rpx; line-height:1.5; }.info-label { color:var(--ink-3); }.info-muted { margin-top:6rpx; color:var(--ink-3); font-size:22rpx; }.service-tags { display:flex; flex-wrap:wrap; gap:18rpx; margin-top:24rpx; padding-top:20rpx; color:#568064; font-size:22rpx; border-top:1rpx solid var(--sep); }
.attribute-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rpx; margin-top:22rpx; overflow:hidden; border-radius:14rpx; background:var(--sep); }.attribute-item { display:flex; flex-direction:column; gap:8rpx; min-height:92rpx; padding:16rpx; background:#FAFAF8; font-size:22rpx; }.attribute-item text:first-child { color:var(--ink-3); }.attribute-item text:last-child { color:var(--ink-1); }
.bottom-action { position:fixed; z-index:3; left:0; right:0; bottom:0; display:flex; align-items:center; gap:12rpx; padding:16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); background:rgba(255,255,255,.98); box-shadow:0 -4rpx 18rpx rgba(0,0,0,.07); }.action-icon { display:flex; flex-direction:column; align-items:center; min-width:58rpx; color:var(--ink-2); font-size:19rpx; }.action-icon text:first-child { margin-bottom:4rpx; font-size:28rpx; }.buy-button { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:center; height:76rpx; color:#fff; border-radius:40rpx; background:linear-gradient(90deg,#D95B42,#C84136); }.buy-button text:first-child { font-size:22rpx; }.buy-button text:last-child { margin-top:1rpx; font-size:27rpx; font-weight:700; }
