.resource-page { min-height:100vh; padding:28rpx; box-sizing:border-box; background:var(--bg); }
.resource-head { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:22rpx; }.resource-head>text { color:var(--brand); font-size:25rpx; }
.resource-title { color:var(--ink-1); font-size:34rpx; font-weight:750; }.resource-desc { margin-top:8rpx; color:var(--ink-3); font-size:23rpx; }
.resource-card { display:flex; align-items:center; gap:18rpx; margin-bottom:16rpx; padding:22rpx; border-radius:20rpx; background:var(--surface); }.resource-play { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:18rpx; background:var(--brand-soft); color:var(--brand); font-size:25rpx; }.resource-copy { flex:1; min-width:0; }.resource-name { overflow:hidden; color:var(--ink-1); font-size:28rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.resource-source { margin-top:7rpx; color:var(--ink-3); font-size:22rpx; }.resource-card>text { color:var(--ink-3); font-size:32rpx; }
.resource-empty { padding:72rpx 24rpx; border-radius:20rpx; background:var(--surface); color:var(--ink-3); font-size:26rpx; text-align:center; }.resource-empty text { display:block; margin-top:18rpx; color:var(--brand); }
