.family-local-card .small { margin-top: 10rpx; line-height: 1.65; }

.member-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}
.member {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 18rpx 8rpx;
  border-radius: 18rpx;
  background: var(--surface-2);
}
.member-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  color: var(--ink-1);
  background: var(--brand-soft);
}
.member-name {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-1);
}
.member-add { background: transparent; border: 2rpx dashed var(--line); }
.member-add-avatar { background: var(--surface); color: var(--ink-3); font-size: 48rpx; font-weight: 400; }
.badge {
  display: inline-block;
  background: var(--c-heart);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-right: 8rpx;
}
.body-growth-row { display:flex; align-items:center; justify-content:space-between; padding:20rpx 0; border-top:1rpx solid var(--line); }
.body-growth-label { display:flex; align-items:center; gap:14rpx; color:var(--ink-1); font-size:27rpx; }
.body-growth-value { color:var(--ink-3); font-size:25rpx; }
