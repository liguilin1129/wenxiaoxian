.member-preview { display:flex; align-items:center; gap:20rpx; margin:0 4rpx 28rpx; }.member-preview .member-avatar { margin:0; }.field-label { margin-bottom:12rpx; color:var(--ink-2); font-size:26rpx; font-weight:600; }.field-input { display:block; width:100%; min-height:88rpx; box-sizing:border-box; padding:20rpx 24rpx; border-radius:var(--radius-xs); background:var(--surface-2); color:var(--ink-1); font-size:30rpx; line-height:48rpx; }.role-group { display:flex; gap:32rpx; }.role-option { display:flex; align-items:center; color:var(--ink-1); font-size:27rpx; }.delete-member { display:block; width:100%; margin-top:20rpx; padding:18rpx; border:0; background:transparent; color:#E5484D; font-size:26rpx; }
