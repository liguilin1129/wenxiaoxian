<view class="scr-head">
  <view class="row between" style="align-items:flex-end">
    <view>
      <view class="greet" style="color:var(--c-habit-d);font-weight:600">家庭议事</view>
      <view class="title">家庭会议</view>
    </view>
    <view wx:if="{{isParent}}" class="mg-btn" bindtap="toggleMode">{{mode === 'list' ? '发起会议' : '返回列表'}}</view>
  </view>
</view>

<view class="scr-body">
  <!-- 列表模式 -->
  <block wx:if="{{mode === 'list'}}">
    <view wx:if="{{!meetings.length}}" class="empty">
      <view class="empty-icon">🪑</view>
      <view class="empty-title">还没有家庭会议</view>
      <view class="empty-desc">点击右上角「发起会议」，把决议变成任务和心愿。</view>
    </view>

    <view wx:for="{{meetings}}" wx:key="id" class="meeting-card" bindtap="openMeeting" data-id="{{item.id}}">
      <view class="row between" style="margin-bottom:12rpx">
        <view class="tn">{{item.title}}</view>
        <text class="pill pill-{{item.status === 'done' ? 'body' : 'habit'}}">{{item.status === 'done' ? '已结束' : '待召开'}}</text>
      </view>
      <view class="muted">{{item.date}} {{item.time}} · {{item.topics.length}} 个议题</view>
      <view wx:if="{{item.status === 'done' && item.summary}}" class="meeting-summary">{{item.summary}}</view>
    </view>
  </block>

  <!-- 发起/进行会议 -->
  <block wx:if="{{mode === 'form'}}">
    <view class="meeting-form-hero">
      <view class="meeting-form-icon">🪑</view>
      <view><view class="meeting-form-title">发起一次家庭会议</view><view class="meeting-form-desc">把讨论变成清晰、可执行的家庭决议。</view></view>
    </view>

    <view class="meeting-form-card">
      <view class="step-label"><text>1</text>会议主题</view>
      <input class="field-input" placeholder="例如：本周家庭会议" value="{{form.title}}" bindinput="onTitle" />
    </view>

    <view class="meeting-form-card agenda-picker">
      <view class="step-head"><view class="step-label"><text>2</text>添加议题</view><view class="step-help">可添加多个</view></view>
      <view class="template-row">
        <view class="template-chip" wx:for="{{templates}}" wx:key="type" bindtap="addTopic" data-type="{{item.type}}"><text class="template-plus">+</text>{{item.name}}</view>
      </view>
      <view class="agenda-tip">选择模板后，可继续填写具体名称、积分和补充说明。</view>
    </view>

    <!-- 议题列表 -->
    <view wx:if="{{form.topics.length}}" class="agenda-list-head"><view class="step-label"><text>3</text>完善议题</view><view class="agenda-count">{{form.topics.length}} 项</view></view>
    <view wx:for="{{form.topics}}" wx:key="id" class="topic-card">
      <view class="row between topic-editor-row">
        <view class="topic-editor-main"><view class="topic-type">{{topicTypeName(item.type)}}</view>
          <input class="topic-title" placeholder="议题标题" value="{{item.title}}" data-idx="{{index}}" data-field="title" bindinput="onTopic" />
        </view>
        <view class="del-btn" data-idx="{{index}}" bindtap="removeTopic">删除</view>
      </view>
      <input class="topic-content" placeholder="补充说明" value="{{item.content}}" data-idx="{{index}}" data-field="content" bindinput="onTopic" />
      <view class="row" style="margin-top:16rpx;gap:16rpx">
        <input class="topic-input-sm" placeholder="名称" value="{{item.target.name}}" data-idx="{{index}}" data-field="targetName" bindinput="onTopic" />
        <input class="topic-input-sm" type="digit" placeholder="积分" value="{{item.target.points}}" data-idx="{{index}}" data-field="targetPoints" bindinput="onTopic" />
      </view>
    </view>

    <view wx:if="{{form.goalDecisions.length}}" class="meeting-form-card review-goals-card">
      <view class="step-label"><text>4</text>调整成长目标</view>
      <view class="agenda-tip">每个目标选择一项决议；继续或替换时，可同步修改当前阶段任务、积分和执行人。</view>
      <view wx:for="{{form.goalDecisions}}" wx:for-item="decision" wx:key="goalId" class="review-goal-editor">
        <view class="review-goal-name">{{decision.goalName}}<text>第 {{decision.currentStage}} 阶段</text></view>
        <view class="decision-actions">
          <text class="decision-action {{decision.action === 'continue' ? 'selected' : ''}}" data-idx="{{index}}" data-action="continue" bindtap="setGoalAction">继续</text>
          <text class="decision-action {{decision.action === 'pause' ? 'selected' : ''}}" data-idx="{{index}}" data-action="pause" bindtap="setGoalAction">暂停</text>
          <text class="decision-action {{decision.action === 'complete' ? 'selected' : ''}}" data-idx="{{index}}" data-action="complete" bindtap="setGoalAction">完成</text>
          <text class="decision-action {{decision.action === 'replace' ? 'selected' : ''}}" data-idx="{{index}}" data-action="replace" bindtap="setGoalAction">替换</text>
        </view>
        <view wx:if="{{decision.action === 'continue' || decision.action === 'replace'}}" class="decision-fields">
          <input class="topic-input-sm" placeholder="阶段任务" value="{{decision.taskName}}" data-idx="{{index}}" data-field="taskName" bindinput="onGoalDecision" />
          <input class="topic-input-sm decision-points" type="digit" placeholder="积分" value="{{decision.points}}" data-idx="{{index}}" data-field="points" bindinput="onGoalDecision" />
          <picker class="decision-picker" range="{{assignees}}" range-key="name" value="{{decision.assigneeIndex}}" data-idx="{{index}}" bindchange="chooseGoalAssignee"><view>执行人：{{decision.assignee}} ›</view></picker>
          <picker wx:if="{{decision.action === 'replace'}}" class="decision-picker" range="{{goalOptions}}" range-key="name" value="{{decision.replaceDimIndex}}" data-idx="{{index}}" bindchange="chooseReplacementDim"><view>替换为：{{decision.replaceDimName}} ›</view></picker>
        </view>
        <view wx:else class="decision-note">{{decision.action === 'pause' ? '结束会议后将暂停目标并移出当前打卡。' : '结束会议后将完成目标并移出当前打卡。'}}</view>
      </view>
    </view>

    <button class="btn meeting-create" bindtap="createMeeting">创建会议并开始决议</button>
  </block>

  <!-- 会议详情 -->
  <block wx:if="{{mode === 'detail'}}">
    <view class="meeting-card" style="border-color:var(--brand-soft2)">
      <view class="row between">
        <view class="tn">{{current.title}}</view>
        <text class="pill pill-{{current.status === 'done' ? 'body' : 'habit'}}">{{current.status === 'done' ? '已结束' : '待召开'}}</text>
      </view>
      <view class="muted" style="margin-top:8rpx">{{current.date}} {{current.time}}</view>
    </view>

    <view class="section-title">议题决议</view>
    <view wx:for="{{current.topics}}" wx:key="id" class="topic-card">
      <view class="row between" style="align-items:flex-start">
        <view>
          <view class="topic-type">{{topicTypeName(item.type)}}</view>
          <view class="topic-title-static">{{item.title || '未命名议题'}}</view>
          <view class="muted" wx:if="{{item.content}}">{{item.content}}</view>
          <view class="topic-target" wx:if="{{item.target.name}}">
            落地：{{item.target.name}} · {{item.target.points}} 分
          </view>
        </view>
        <view wx:if="{{current.status === 'pending' && isParent}}" class="check {{item.approved ? 'on' : ''}}" data-idx="{{index}}" bindtap="toggleApprove">
          <text wx:if="{{item.approved}}">✓</text>
        </view>
        <text wx:else class="pill pill-{{item.approved ? 'body' : 'taste'}}">{{item.approved ? '已通过' : '未通过'}}</text>
      </view>
    </view>

    <view wx:if="{{current.status === 'done' && current.goalDecisionResults.length}}" class="meeting-card review-result-card">
      <view class="tn">本期目标决议</view>
      <view wx:for="{{current.goalDecisionResults}}" wx:key="goalName" class="review-result-row"><view><text>{{item.goalName}}</text><text class="review-result-action">{{item.action}}</text></view><text>{{item.detail}}</text></view>
    </view>

    <view wx:if="{{current.status === 'pending' && isParent}}" class="card" style="margin-top:24rpx">
      <view class="field-label">会议纪要</view>
      <textarea class="field-textarea" placeholder="记录本次家庭会议的核心结论..." value="{{summary}}" bindinput="onSummary" />
    </view>

    <button wx:if="{{current.status === 'pending' && isParent}}" class="btn" style="margin-top:32rpx" bindtap="closeMeeting">结束会议并落地决议</button>
  </block>
</view>
