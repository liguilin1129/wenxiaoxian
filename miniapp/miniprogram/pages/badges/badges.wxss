.page{min-height:100vh;padding:28rpx;background:#F2F2F7;box-sizing:border-box}.hero{display:flex;align-items:center;gap:20rpx;padding:30rpx;border-radius:28rpx;background:linear-gradient(135deg,#5E5CE6,#7C7AF2);color:#fff}.hero-avatar{width:86rpx;height:86rpx;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:38rpx}.hero-title{font-size:34rpx;font-weight:700}.hero-sub{margin-top:8rpx;font-size:24rpx;opacity:.85}.summary{display:flex;justify-content:space-around;margin:20rpx 0;padding:24rpx 0;border-radius:24rpx;background:#fff}.summary view{display:flex;flex-direction:column;align-items:center;gap:7rpx;color:#8E8E93;font-size:22rpx}.summary view text:first-child{font-size:34rpx;color:#1C1C1E;font-weight:700}.section-title{margin:28rpx 4rpx 16rpx;font-size:30rpx;font-weight:700}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx}.card{padding:24rpx;border-radius:24rpx;background:#fff;min-height:238rpx;box-sizing:border-box}.card.locked{opacity:.62}.icon{font-size:52rpx}.name{margin-top:12rpx;font-size:28rpx;font-weight:700}.desc{margin-top:7rpx;min-height:56rpx;color:#6D6D72;font-size:21rpx;line-height:1.35}.bar{height:10rpx;margin-top:16rpx;border-radius:99rpx;background:#E5E5EA;overflow:hidden}.fill{height:100%;border-radius:99rpx;background:#5E5CE6}.progress{margin-top:9rpx;color:#8E8E93;font-size:20rpx}.got .progress{color:#4F46E5}
