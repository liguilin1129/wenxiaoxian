<view class="scr-head">
  <view class="greet">经典书架</view>
  <view class="title">经典学习</view>
</view>

<view class="scr-body">
  <view class="classic-grid">
    <view wx:for="{{classics}}" wx:key="name" class="classic" data-name="{{item.name}}" bindtap="goDetail">
      <view class="cn">{{item.name}}</view>
      <view class="cp">{{item.read >= item.total ? '已读 全本' : '已读 ' + item.read + ' / ' + item.total + ' 章'}}</view>
      <view class="bar"><view class="fill" style="width:{{item.pct}}%;background:{{item.color}}"></view></view>
    </view>
  </view>
  <view class="muted" style="margin-top:24rpx;text-align:center">共 17 部经典 · 对应五大内功养成</view>
</view>

<ai-assistant />
