<view class="scr-head"><view class="greet">家长空间</view><view class="title">任务管理</view></view>
<view class="scr-body">
  <view class="card goal-card"><view><view class="h3">成长目标</view><view class="small">按阶段完成任务，逐步养成习惯</view></view><button class="btn soft goal-btn" bindtap="goGoals">去设置</button></view>
  <view class="card">
    <view class="h3">创建任务</view><view class="small template-hint">可先选择模板，再按孩子情况调整</view>
    <view class="template-groups"><view wx:for="{{templates}}" wx:key="dim" class="template-group"><view class="template-dim">{{item.dimName}}</view><view class="chips"><text wx:for="{{item.list}}" wx:for-item="template" wx:key="id" class="pill template-pill" data-name="{{template.name}}" data-points="{{template.points}}" data-dim="{{template.dim}}" bindtap="selectTemplate">{{template.name}} · {{template.points}}分</text></view></view></view>
    <input placeholder="例如：饭后整理餐桌" value="{{name}}" data-key="name" bindinput="input"/>
    <view class="row field-space"><input class="points-input" type="number" value="{{points}}" data-key="points" bindinput="input"/><text class="muted">积分</text></view>
    <view class="chips field-space"><text wx:for="{{dims}}" wx:key="key" class="pill {{dim===item.key?'pill-habit':''}}" data-key="{{item.key}}" bindtap="select">{{item.name}}</text></view>
    <view class="h3 section-space">指派给</view><view class="chips"><text wx:for="{{members}}" wx:key="id" class="pill {{assignee===item.name?'pill-habit':''}}" data-name="{{item.name}}" bindtap="selectMember">{{item.name}}</text></view>
    <view class="h3 section-space">执行周期</view><view class="chips"><text class="pill {{frequency==='once'?'pill-habit':''}}" data-key="once" bindtap="selectFrequency">单次任务</text><text class="pill {{frequency==='daily'?'pill-habit':''}}" data-key="daily" bindtap="selectFrequency">每日重复</text></view>
    <view class="row between field-space"><text class="muted">截止日期</text><picker mode="date" value="{{deadline}}" bindchange="date"><view>{{deadline}} ›</view></picker></view>
    <button class="btn section-space" bindtap="add">{{frequency==='daily'?'加入每日打卡':'加入孩子今日打卡'}}</button>
  </view>
  <view class="h3 assigned-title">已分配任务</view>
  <view wx:for="{{list}}" wx:key="id" class="card row between"><view><view class="tn">{{item.name}}</view><view class="muted">{{item.assignee || '孩子'}} · {{item.points}} 分 · {{item.frequency==='daily'?'每日重复':'单次任务'}}{{item.deadline?' · 至 '+item.deadline:''}}</view></view><text data-id="{{item.id}}" bindtap="remove" class="delete">删除</text></view>
</view>
