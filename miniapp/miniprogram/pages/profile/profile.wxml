<view class="profile-page">
  <view class="profile-header" wx:if="{{signed}}">
    <view class="avatar lg">{{child.avatar}}</view>
    <view class="profile-info"><view class="profile-name">{{child.name}}</view><view class="profile-level">{{child.levelName}} · Lv.{{child.levelNum}}</view></view>
    <view class="profile-points" bindtap="goPoints"><text>{{child.points}}</text><text>积分 ›</text></view>
    <view wx:if="{{mode === 'parent'}}" class="profile-edit" bindtap="editProfile">编辑</view>
  </view>
  <view class="guest-login" wx:else bindtap="goLogin">
    <view class="guest-login-avatar">👤</view><view class="flex1"><view class="guest-login-title">登录 · 开启成长花园</view><view class="muted" style="font-size:24rpx;margin-top:6rpx">登录后查看任务、积分与成长记录</view></view><view class="guest-login-arrow">›</view>
  </view>
  <block wx:if="{{signed}}">
    <view class="stats-card"><view wx:for="{{stats}}" wx:key="label" class="stat-item" bindtap="{{item.action}}"><view class="stat-num">{{item.num}}<text wx:if="{{item.suffix}}" class="stat-suffix">{{item.suffix}}</text></view><view class="stat-label">{{item.label}}</view></view></view>
    <view class="profile-section section-card">
      <view class="section-head"><view class="section-title">成长工具</view><view class="section-sub">记录每一步成长</view></view>
      <view class="tools-grid"><view wx:for="{{tools}}" wx:key="name" class="tool-item" bindtap="{{item.action}}"><view class="tool-icon-wrap"><view class="tool-icon" style="background:{{item.bg}};color:{{item.color}}">{{item.icon}}</view><text wx:if="{{item.badge}}" class="tool-badge">{{item.badge}}</text></view><view class="tool-name">{{item.name}}</view></view></view>
    </view>
    <button wx:if="{{mode === 'parent'}}" class="btn soft profile-logout" bindtap="logout">退出成长花园</button>
  </block>
</view>
<ai-assistant id="aiAssistant" tab-mode="{{true}}" />
