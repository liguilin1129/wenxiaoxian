.empty{padding:140rpx 32rpx;color:var(--ink-3);font-size:25rpx;line-height:1.7;text-align:center}.empty-icon{margin-bottom:18rpx;color:var(--brand);font-size:68rpx}.empty-title{margin-bottom:8rpx;color:var(--ink-1);font-size:31rpx;font-weight:800}.archive{margin-bottom:18rpx;padding:24rpx}.archive-head{display:flex;align-items:center;justify-content:space-between}.archive-date{color:var(--ink-1);font-size:30rpx;font-weight:800}.archive-sub{margin-top:7rpx;color:var(--ink-3);font-size:22rpx}.archive-score{color:var(--brand);font-size:40rpx;font-weight:800}.archive-score text{margin-left:4rpx;font-size:21rpx}.archive-detail{margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid var(--sep)}.archive-grid{display:flex;border-radius:16rpx;background:var(--surface-2)}.archive-grid view{display:flex;flex:1;flex-direction:column;gap:8rpx;align-items:center;padding:18rpx 6rpx}.archive-grid text:first-child{color:var(--ink-3);font-size:20rpx}.archive-grid text:last-child{color:var(--ink-1);font-size:24rpx;font-weight:700}.archive-line,.archive-body{margin-top:18rpx;color:var(--ink-2);font-size:24rpx;line-height:1.6}.archive-dims{display:grid;grid-template-columns:repeat(2,1fr);gap:10rpx;margin-top:18rpx}.archive-dims view{display:flex;justify-content:space-between;padding:12rpx 14rpx;border-radius:12rpx;background:var(--surface-2);color:var(--ink-2);font-size:23rpx}.archive-dims text:last-child{color:var(--brand);font-weight:700}.delete{display:block;margin-top:20rpx;color:#D55A6A;font-size:23rpx;text-align:right}
