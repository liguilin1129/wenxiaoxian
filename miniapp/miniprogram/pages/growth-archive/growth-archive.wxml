<view class="scr-head"><view class="greet">仅保存在当前设备</view><view class="title">成长档案</view></view>
<view class="scr-body">
  <view wx:if="{{!records.length}}" class="empty"><view class="empty-icon">◌</view><view class="empty-title">还没有成长档案</view><view>在成长报告中点击“存入成长档案”，即可保存当前阶段快照。</view></view>
  <view wx:for="{{records}}" wx:key="id" class="archive card"><view class="archive-head" data-id="{{item.id}}" bindtap="toggle"><view><view class="archive-date">{{item.date}}</view><view class="archive-sub">{{item.levelName || '未完成初评'}} · {{item.completionPct}}% 今日任务完成</view></view><view class="archive-score">{{item.points}}<text>分</text></view></view><view wx:if="{{selectedId === item.id}}" class="archive-detail"><view class="archive-grid"><view><text>连续打卡</text><text>{{item.streak}} 天</text></view><view><text>本周积分</text><text>+{{item.weekGain}} 分</text></view><view><text>初评得分</text><text>{{item.assessmentScore || '—'}}{{item.assessmentScore ? ' 分' : ''}}</text></view></view><view class="archive-line">优势：{{item.strengthName || '持续记录中'}} · 关注：{{item.focusName || '持续记录中'}}</view><view class="archive-dims"><view wx:for="{{item.dims}}" wx:key="key"><text>{{item.name}}</text><text>{{item.pct}}%</text></view></view><view class="archive-body">身体记录：身高 {{item.body.height}} cm · 体重 {{item.body.weight}} kg · BMI {{item.body.bmi}}</view><text class="delete" data-id="{{item.id}}" catchtap="remove">删除此档案</text></view></view>
</view>
