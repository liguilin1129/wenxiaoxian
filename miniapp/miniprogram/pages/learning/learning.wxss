.learning-page { padding:24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom)); }
.learning-section { background:var(--surface); border-radius:24rpx; padding:26rpx; box-shadow:var(--shadow-soft); margin-bottom:24rpx; }
.learning-heading { font-size:32rpx; font-weight:750; margin-bottom:24rpx; }
.learning-books { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:26rpx 18rpx; }
.learning-book { min-width:0; }
.book-cover { height:184rpx; padding:18rpx; border-radius:6rpx 15rpx 15rpx 6rpx; color:#fff; box-shadow:inset 6rpx 0 0 rgba(0,0,0,.1),0 6rpx 12rpx rgba(50,48,70,.08); }
.book-title { font-size:27rpx; font-weight:700; line-height:1.5; }
.book-progress { font-size:20rpx; color:var(--ink-3); margin-top:14rpx; }
.reading-track { height:6rpx; border-radius:6rpx; background:var(--brand-soft); margin-top:10rpx; overflow:hidden; }.reading-track > view { height:100%; background:var(--brand); }
.learning-courses { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18rpx; }
.learning-course { min-width:0; border:1rpx solid var(--sep); padding:20rpx; border-radius:18rpx; }
.course-mark { width:76rpx; height:76rpx; border-radius:20rpx; display:flex; align-items:center; justify-content:center; font-size:34rpx; font-weight:700; }
.course-image { width:100%; height:150rpx; border-radius:14rpx; }
.course-name { font-size:27rpx; font-weight:650; margin-top:16rpx; }.course-action { font-size:22rpx; color:var(--brand); margin-top:14rpx; }
.learning-empty { font-size:26rpx; color:var(--ink-3); padding:24rpx 0; text-align:center; }
.video-entry { display:flex; align-items:center; justify-content:space-between; margin-bottom:0; }
.video-entry .learning-heading { margin-bottom:8rpx; }.video-entry-sub { color:var(--ink-3); font-size:25rpx; }.video-entry-arrow { color:var(--brand); font-size:42rpx; }
