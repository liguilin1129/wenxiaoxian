<view class="scr-head">
  <view class="row between" style="align-items:flex-end">
    <view>
      <view class="title">积分银行</view>
    </view>
    <view wx:if="{{signed && isParent}}" class="mg-btn" bindtap="toggleManage">{{manage ? '完成' : '管理奖励'}}</view>
  </view>
</view>

<view class="scr-body">
  <view wx:if="{{!signed}}" class="task"><button class="btn soft" bindtap="goLogin">登录后查看积分银行</button></view>
  <block wx:else>
  <view class="points-hero">
    <view class="lbl" style="opacity:.85">积分余额</view>
    <view class="num">{{points}}<text class="bank-points-unit">分</text></view>
    <view class="bank-points-link" bindtap="goPoints">积分明细 ›</view>
  </view>

  <view class="bank-reward-heading">奖励兑换</view>
  <view wx:if="{{!rewards.length}}" class="task muted">暂无可兑换奖励</view>
  <view wx:for="{{rewards}}" wx:key="id" class="task">
    <view class="row between">
      <view>
        <view class="tn">{{item.name}}</view>
        <view class="muted">{{item.desc}}</view>
      </view>
      <text class="pill pill-{{item.dim}}">{{item.cost}} 分</text>
    </view>

    <view wx:if="{{manage}}" class="mg-actions">
      <view class="mg-act" data-id="{{item.id}}" bindtap="editReward">✎ 编辑</view>
      <view class="mg-act del" data-id="{{item.id}}" bindtap="deleteReward">🗑 删除</view>
    </view>
    <button wx:else class="btn soft" style="margin-top:16rpx" data-id="{{item.id}}" bindtap="redeem">兑换</button>
  </view>

  <view wx:if="{{manage}}" class="add-btn" bindtap="addReward">＋ 新增心愿</view>
  </block>
</view>

<ai-assistant />
