.manage-page { min-height:100vh; padding:28rpx; box-sizing:border-box; background:var(--bg); }.manage-card,.manage-item { border-radius:20rpx; background:var(--surface); }.manage-card { padding:26rpx; }.manage-title { margin-bottom:14rpx; color:var(--ink-1); font-size:30rpx; font-weight:700; }.manage-card input { height:84rpx; border-bottom:1rpx solid var(--sep); color:var(--ink-1); font-size:26rpx; }.manage-card .btn { margin-top:24rpx; }.manage-item { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:16rpx; padding:22rpx; color:var(--ink-1); font-size:26rpx; }.manage-item view view:last-child { margin-top:8rpx; color:var(--ink-3); font-size:21rpx; }.manage-item>text { color:#D55A6A; font-size:23rpx; }
