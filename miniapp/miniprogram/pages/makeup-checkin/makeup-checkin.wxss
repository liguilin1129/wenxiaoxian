.makeup-page{padding:24rpx 28rpx calc(210rpx + env(safe-area-inset-bottom))}.makeup-card{padding:26rpx;margin-bottom:22rpx;border-radius:24rpx;background:#fff;box-shadow:var(--shadow-soft)}.makeup-title{font-size:34rpx;font-weight:750}.makeup-quota{margin-top:18rpx;font-size:27rpx}.makeup-quota text{color:var(--brand);font-weight:750}.makeup-note{font-size:24rpx;line-height:1.7;color:var(--ink-3);margin-top:14rpx}.makeup-reason{margin-top:16rpx;font-size:25rpx;color:var(--brand)}.makeup-toolbar{display:flex;justify-content:flex-end;gap:32rpx;font-size:26rpx;color:var(--brand);margin:20rpx 4rpx}.makeup-date{font-size:28rpx;font-weight:650;margin-bottom:12rpx}.makeup-task{display:flex;align-items:center;gap:14rpx;padding:20rpx 0;border-top:1rpx solid var(--sep);font-size:26rpx}.makeup-task-name{flex:1;min-width:0;overflow-wrap:break-word}.makeup-points{flex:none;color:var(--brand)}.makeup-submit{position:fixed;left:0;right:0;bottom:0;background:rgba(255,255,255,.97);padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -4rpx 16rpx rgba(0,0,0,.04);text-align:center;font-size:25rpx;z-index:20}.makeup-submit button{margin-top:14rpx}
