.login-page { position:relative; min-height:100vh; overflow:hidden; box-sizing:border-box; display:flex; flex-direction:column; background:linear-gradient(180deg,#F8F8FF 0%,#F2F2F7 58%,#F7F7FB 100%); padding:0 48rpx calc(30rpx + env(safe-area-inset-bottom)); color:var(--ink-1); }
.login-glow { position:absolute; z-index:0; border-radius:50%; filter:blur(2rpx); opacity:.58; }.glow-one { top:-130rpx; right:-110rpx; width:380rpx; height:380rpx; background:#E2E1FF; }.glow-two { top:440rpx; left:-180rpx; width:340rpx; height:340rpx; background:#EDEBFF; }
.login-main { z-index:1; width:100%; max-width:620rpx; margin:0 auto; padding-top:176rpx; text-align:center; box-sizing:border-box; flex:1; }
.brand-halo { position:relative; display:flex; align-items:center; justify-content:center; width:182rpx; height:182rpx; margin:0 auto; border:1rpx solid rgba(94,92,230,.13); border-radius:50%; background:rgba(255,255,255,.48); box-shadow:0 20rpx 46rpx rgba(94,92,230,.11); }.app-mark { z-index:1; display:flex; align-items:center; justify-content:center; width:126rpx; height:126rpx; border-radius:42rpx 42rpx 42rpx 20rpx; background:linear-gradient(145deg,#817FF8,var(--brand-700)); box-shadow:0 14rpx 28rpx rgba(79,70,229,.28); color:#fff; font-size:66rpx; font-weight:700; }.brand-spark { position:absolute; border-radius:50%; background:var(--brand); }.spark-one { top:18rpx; right:22rpx; width:14rpx; height:14rpx; }.spark-two { bottom:22rpx; left:14rpx; width:9rpx; height:9rpx; opacity:.45; }
.login-panel { margin-top:142rpx; padding:40rpx 30rpx 30rpx; text-align:left; border:1rpx solid rgba(255,255,255,.86); border-radius:30rpx; background:rgba(255,255,255,.84); box-shadow:0 18rpx 44rpx rgba(54,50,110,.08); }.login-heading { font-size:38rpx; font-weight:700; color:var(--ink-1); }.login-subheading { margin-top:14rpx; margin-bottom:34rpx; color:var(--ink-3); font-size:25rpx; }
.wechat-login { display:flex; align-items:center; justify-content:center; width:100%; min-height:98rpx; padding:16rpx 24rpx; border-radius:20rpx; background:linear-gradient(100deg,var(--brand),var(--brand-700)); box-shadow:0 12rpx 24rpx rgba(94,92,230,.24); color:#fff; font-size:33rpx; font-weight:650; }
.wechat-login::after, .skip-login::after, .avatar-choice::after, .development-preview::after { border:none; }
.wechat-login[disabled] { background:var(--brand-soft2); color:#fff; }
.login-panel { text-align:center; }.agreement-line { display:flex; flex-wrap:wrap; justify-content:center; align-items:flex-start; gap:0 6rpx; margin-top:24rpx; color:var(--ink-3); font-size:20rpx; line-height:1.65; text-align:center; }.agreement-circle { flex:none; width:25rpx; height:25rpx; margin:4rpx 2rpx 0 0; border:2rpx solid #C8C8D1; border-radius:50%; box-sizing:border-box; }.agreement-link { color:var(--brand-600); }
