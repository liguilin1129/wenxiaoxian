.login-page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 22rpx 0 calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部品牌区 */
.hero {
  text-align: center;
  padding: 44rpx 60rpx 32rpx;
}
.logo {
  width: 116rpx;
  height: 116rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin: 0 auto;
  box-shadow: 0 16rpx 40rpx rgba(94, 92, 230, 0.28);
}
.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1C1C1E;
  margin-top: 24rpx;
  letter-spacing: -0.6rpx;
}
.hero-sub {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

/* iOS 分组列表 */
.igroup {
  margin: 0 32rpx 20rpx;
}
.igroup-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #8E8E93;
  padding: 0 16rpx 10rpx;
  letter-spacing: 0.4rpx;
}
.group-card {
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04), 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

/* 头像行 */
.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx 18rpx;
  margin: 0;
  background: #fff;
}
.avatar-row::after { border: none; }
.ava-big {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 20rpx rgba(94, 92, 230, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  color: var(--brand-700);
}
.ava-placeholder {
  font-size: 52rpx;
  font-weight: 700;
}
.change {
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}

/* 昵称输入行 */
.irow {
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx;
}
.nick-input {
  height: 68rpx;
  width: 100%;
  font-size: 28rpx;
  color: #1C1C1E;
}
.ph { color: #C7C7CC; }

/* 隐私说明 */
.privacy {
  padding: 8rpx 48rpx 0;
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.5;
  text-align: center;
}

/* 底部固定按钮 */
.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #F2F2F7 70%, transparent);
}
.enter-btn {
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(94, 92, 230, 0.28);
}
.enter-btn::after { border: none; }
.enter-btn.dis {
  background: #D1D1D6;
  box-shadow: none;
}
.sub {
  text-align: center;
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 16rpx;
}
