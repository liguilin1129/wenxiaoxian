/* ===== 液态玻璃岛底部导航（Floating Glass Dock · iOS 风格） ===== */

.tabbar-shell {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  z-index: 999;
  transition: transform 0.25s ease;
}
.tabbar {
  position: relative;
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 8rpx;

  /* 轻磨砂底色；模糊不可用时仍保留可读的半透明底。 */
  background: rgba(248, 249, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 56rpx;
  box-shadow: 0 12rpx 32rpx rgba(32, 32, 48, 0.09),
    0 2rpx 6rpx rgba(32, 32, 48, 0.04),
    inset 0 2rpx 1rpx rgba(255, 255, 255, 0.8),
    inset 0 -1rpx 2rpx rgba(128, 132, 154, 0.12);
  backdrop-filter: blur(20px) saturate(145%);
  -webkit-backdrop-filter: blur(20px) saturate(145%);

  overflow: hidden;
}

/* 聊天面板等全屏弹层打开时，把导航栏下移移出屏幕 */
.tabbar-hidden {
  transform: translateY(140%);
}

/* 玻璃底色晕染（品牌色，极低透明度，营造玻璃质感） */
.glass-wash {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 56rpx;
  background: linear-gradient(165deg, rgba(255,255,255,.3) 0%, rgba(255,255,255,.08) 48%, rgba(231,233,248,.1) 100%);
  pointer-events: none;
  z-index: 0;
}

/* ---- Tab 项 ---- */
.selection-track {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 10rpx;
  bottom: 10rpx;
  pointer-events: none;
}
.selection-pill {
  position: absolute;
  left: 0;
  width: 25%;
  height: 100%;
  border-radius: 44rpx;
  background: linear-gradient(155deg, rgba(131,133,153,.14), rgba(108,110,134,.18));
  border: 1rpx solid rgba(255,255,255,.55);
  box-sizing: border-box;
  box-shadow: inset 0 1rpx 2rpx rgba(255,255,255,.65), 0 2rpx 6rpx rgba(68,65,96,.04);
  animation-duration: .22s;
  animation-timing-function: linear;
  animation-fill-mode: both;
}
/* 相邻两次切换交替动画名；新页面用负延迟接着播放，不重置到首页。 */
@keyframes dock-slide-a {
  from { transform: translateX(var(--dock-from)); }
  to { transform: translateX(var(--dock-to)); }
}
@keyframes dock-slide-b {
  from { transform: translateX(var(--dock-from)); }
  to { transform: translateX(var(--dock-to)); }
}
.tb {
  position: relative;
  z-index: 1;
  flex: 1 1 0%;
  min-width: 0;
  height: 92rpx;
  margin: 0;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8E8E98;
  transition: color .22s ease;
}
.tb.on {
  color: #5E5CE6;
}
.tb.on .icon { transform: scale(1.08); }
.txt {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 500;
  margin-top: 6rpx;
  text-align: center;
  line-height: 1.2;
  transition: color .22s ease;
}
.tb.on .txt { font-weight: 650; }

/* ---- 图标容器 ---- */
.icon-wrap {
  flex: none;
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 图标：现代简洁风（选中实心填充 / 未选中细线描边，与 iOS/微信原生风格一致） */
.icon {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  transition: transform .22s ease;
}

.ai-tab { position:relative; display:flex; flex:none; flex-direction:column; align-items:center; justify-content:center; width:112rpx; height:112rpx; border:5rpx solid rgba(255,255,255,.95); border-radius:50%; color:#fff; background:linear-gradient(145deg,#7C9EF4,#4C7FE3); box-shadow:0 10rpx 24rpx rgba(76,127,227,.32); box-sizing:border-box; }.ai-tab:active { transform:scale(.95); }.ai-tab-spark { position:absolute; top:18rpx; right:24rpx; font-size:18rpx; }.ai-tab-label { font-size:30rpx; font-weight:800; letter-spacing:1rpx; }

