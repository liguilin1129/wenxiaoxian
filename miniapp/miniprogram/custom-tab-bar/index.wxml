<!-- 自定义底部导航（液态玻璃岛 · Floating Glass Dock） -->
<view class="tabbar-shell {{hidden ? 'tabbar-hidden' : ''}}">
  <view class="tabbar">
    <view class="glass-wash"></view>
    <view class="selection-track"><view class="selection-pill" style="--dock-from:{{indicatorFrom}}%;--dock-to:{{indicatorTo}}%;transform:translateX({{indicatorTo}}%);animation-name:{{indicatorAnimation}};animation-delay:{{indicatorDelay}}ms"></view></view>
    <view wx:for="{{list}}" wx:key="idx" class="tb {{selected === item.idx ? 'on' : ''}}" data-path="{{item.pagePath}}" data-idx="{{item.idx}}" aria-label="{{item.text}}" bindtap="switchTab">
      <view class="icon-wrap">
        <view wx:if="{{item.idx === 0}}" class="icon icon-home"></view>
        <view wx:if="{{item.idx === 1}}" class="icon icon-learning"></view>
        <view wx:if="{{item.idx === 2}}" class="icon icon-discover"></view>
        <view wx:if="{{item.idx === 3}}" class="icon icon-mine"></view>
      </view>
      <text class="txt">{{item.text}}</text>
    </view>
  </view>
  <view class="ai-tab" bindtap="openAiAssistant"><view class="ai-tab-spark">✦</view><view class="ai-tab-label">AI</view></view>
</view>
