<!-- 自定义底部导航：中间凸起+按钮风格 -->
<view class="tabbar">
  <!-- 左侧：首页 / 任务 -->
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    wx:if="{{index < 2}}"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="icon-wrap">
      <!-- 首页图标 -->
      <view wx:if="{{index === 0}}" class="icon {{selected === 0 ? 'icon-home-active' : 'icon-home'}}"></view>
      <!-- 任务图标 -->
      <view wx:if="{{index === 1}}" class="icon {{selected === 1 ? 'icon-task-active' : 'icon-task'}}"></view>
    </view>
    <text class="label">{{item.text}}</text>
  </view>

  <!-- 中间：凸起 + 按钮 -->
  <view class="center-btn" bindtap="onCenterTap">
    <view class="center-inner">
      <text class="plus">+</text>
    </view>
    <text class="center-label">打卡</text>
  </view>

  <!-- 右侧：成长 / 我的 -->
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    wx:if="{{index >= 2}}"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="icon-wrap">
      <!-- 成长图标 -->
      <view wx:if="{{index === 2}}" class="icon {{selected === 2 ? 'icon-growth-active' : 'icon-growth'}}"></view>
      <!-- 我的图标 -->
      <view wx:if="{{index === 3}}" class="icon {{selected === 3 ? 'icon-mine-active' : 'icon-mine'}}"></view>
    </view>
    <text class="label">{{item.text}}</text>
  </view>
</view>
