<!-- 自定义底部导航（Light UI Kit · 普通扁平4宫格） -->
<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="idx"
    class="tb {{selected === item.idx ? 'on' : ''}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <view class="icon-wrap">
      <view wx:if="{{item.idx === 0}}" class="icon {{selected === 0 ? 'icon-home-active' : 'icon-home'}}"></view>
      <view wx:if="{{item.idx === 1}}" class="icon {{selected === 1 ? 'icon-task-active' : 'icon-task'}}"></view>
      <view wx:if="{{item.idx === 2}}" class="icon {{selected === 2 ? 'icon-book-active' : 'icon-book'}}"></view>
      <view wx:if="{{item.idx === 3}}" class="icon {{selected === 3 ? 'icon-mine-active' : 'icon-mine'}}"></view>
    </view>
    <text class="txt">{{item.text}}</text>
  </view>
</view>
