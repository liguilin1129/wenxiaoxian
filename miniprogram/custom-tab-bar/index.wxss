/* ===== 液态玻璃岛底部导航（Floating Glass Dock · Light UI Kit） ===== */

.tabbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;

  /* 玻璃岛：半透明白底 + 白色描边 + 柔和投影托起 */
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(99, 102, 241, 0.18);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  overflow: hidden;
  z-index: 999;
  transition: transform 0.25s ease;
}

/* 聊天面板等全屏弹层打开时，把导航栏下移移出屏幕 */
.tabbar-hidden {
  transform: translateY(140%);
}

/* 玻璃底色晕染（品牌色，极低透明度，营造玻璃质感） */
.glass-wash {
  position: absolute;
  inset: 0;
  border-radius: 30rpx;
  background: linear-gradient(90deg, rgba(99, 102, 241, 0.10), rgba(99, 102, 241, 0.04));
  z-index: 0;
}

/* ---- Tab 项 ---- */
.tb {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B0B0BF;
  transition: color 0.2s;
}
.tb.on {
  color: #6366F1;
}
.txt {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.2;
}

/* ---- 图标容器 ---- */
.icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

/* 选中态小光圈：只在图标背后，不压到下方文字 */
.halo {
  position: absolute;
  z-index: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: rgba(99, 102, 241, 0.16);
}

/* ---- 首页（房子 · 正常首页图标） ---- */
.icon-home {
  width: 30rpx;
  height: 26rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
}
.icon-home::before {
  content: '';
  position: absolute;
  top: -15rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 19rpx solid transparent;
  border-right: 19rpx solid transparent;
  border-bottom: 17rpx solid currentColor;
}

/* ---- 任务（勾选框） ---- */
.icon-task {
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid currentColor;
  border-radius: 10rpx;
}
.icon-task::after {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 7rpx;
  width: 9rpx;
  height: 16rpx;
  border: solid currentColor;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

/* ---- 经典（书本） ---- */
.icon-book {
  width: 40rpx;
  height: 32rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}
.icon-book::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 3rpx;
  bottom: 3rpx;
  width: 2rpx;
  background: currentColor;
  transform: translateX(-50%);
}

/* ---- 我的（人物） ---- */
.icon-mine {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.icon-mine::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -13rpx;
  transform: translateX(-50%);
  width: 24rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
}
