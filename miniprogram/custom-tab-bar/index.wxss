/* ===== 液态玻璃岛底部导航（Floating Glass Dock · Light UI Kit） ===== */

.tabbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;

  /* 玻璃岛：半透明白底 + 白色描边 + 柔和投影托起 */
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(99, 102, 241, 0.18);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  overflow: hidden;
  z-index: 999;
  transition: transform 0.25s ease;
}

/* 聊天面板等全屏弹层打开时，把导航栏下移移出屏幕 */
.tabbar-hidden {
  transform: translateY(140%);
}

/* 玻璃底色晕染（品牌色，极低透明度，营造玻璃质感） */
.glass-wash {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 30rpx;
  background: linear-gradient(90deg, rgba(99, 102, 241, 0.12), rgba(99, 102, 241, 0.05));
  z-index: 0;
}

/* ---- Tab 项 ---- */
.tb {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B0B0BF;
  transition: color 0.2s;
}
.tb.on {
  color: #6366F1;
}
.txt {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.2;
}

/* ---- 图标容器 ---- */
.icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 图标：用 SVG mask 渲染，选中态由 currentColor 自动变色（与预览图完全一致，零图标包依赖） */
.icon {
  position: relative;
  z-index: 1;
  width: 46rpx;
  height: 46rpx;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
}

/* 选中态小光圈：只在图标背后，不压到下方文字 */
.halo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: rgba(99, 102, 241, 0.16);
}

