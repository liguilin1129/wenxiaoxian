/* ===== 液态玻璃岛底部导航（Floating Glass Dock · iOS 风格） ===== */

.tabbar-shell {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  z-index: 999;
  transition: transform 0.25s ease;
}
.tabbar {
  position: relative;
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-around;

  /* 玻璃岛：半透明白底 + 白色描边 + 柔和投影托起 */
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 56rpx;
  box-shadow: 0 10rpx 28rpx rgba(32, 32, 48, 0.12);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  overflow: hidden;
}

/* 聊天面板等全屏弹层打开时，把导航栏下移移出屏幕 */
.tabbar-hidden {
  transform: translateY(140%);
}

/* 玻璃底色晕染（品牌色，极低透明度，营造玻璃质感） */
.glass-wash {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 56rpx;
  background: rgba(255,255,255,.15);
  z-index: 0;
}

/* ---- Tab 项 ---- */
.tb {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 92rpx;
  margin: 0 4rpx;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8E8E98;
  transition: color .2s, background .2s, transform .2s;
}
.tb::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: transparent;
  transition: background .2s;
}
.tb.on {
  color: #5E5CE6;
}
.tb.on::before { background: rgba(108,108,118,.14); }
.tb.on .icon { transform: scale(1.08); }
.txt {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.2;
}

/* ---- 图标容器 ---- */
.icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 图标：现代简洁风（选中实心填充 / 未选中细线描边，与 iOS/微信原生风格一致） */
.icon {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.ai-tab { position:relative; display:flex; flex:none; flex-direction:column; align-items:center; justify-content:center; width:112rpx; height:112rpx; border:5rpx solid rgba(255,255,255,.95); border-radius:50%; color:#fff; background:linear-gradient(145deg,#7C9EF4,#4C7FE3); box-shadow:0 10rpx 24rpx rgba(76,127,227,.32); box-sizing:border-box; }.ai-tab:active { transform:scale(.95); }.ai-tab-spark { position:absolute; top:18rpx; right:24rpx; font-size:18rpx; }.ai-tab-label { font-size:30rpx; font-weight:800; letter-spacing:1rpx; }

