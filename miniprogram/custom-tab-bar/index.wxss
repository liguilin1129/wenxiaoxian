/* ===== 普通扁平4宫格底部导航（Light UI Kit） ===== */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 999;
  transition: transform 0.25s ease;
}
/* 聊天面板等全屏弹层打开时，把导航栏下移移出屏幕，避免遮挡输入栏 */
.tabbar-hidden {
  transform: translateY(100%);
}

/* ---- Tab 项 ---- */
.tb {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B0B0BF;
  transition: color 0.2s;
}
.tb.on {
  color: #6366F1;
}
.txt {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.2;
}

.icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 纯CSS图标：首页（房子） ---- */
.icon-home {
  width: 44rpx;
  height: 40rpx;
  border: 3rpx solid #B0B0BF;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  position: relative;
  box-sizing: border-box;
}
.icon-home::before {
  content: '';
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 14rpx solid #B0B0BF;
}
.icon-home::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #B0B0BF;
  border-radius: 2rpx;
  background: #fff;
}
.icon-home-active {
  width: 44rpx;
  height: 40rpx;
  border: 3rpx solid #6366F1;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  position: relative;
  box-sizing: border-box;
  background: rgba(99, 102, 241, 0.08);
}
.icon-home-active::before {
  content: '';
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 14rpx solid #6366F1;
}
.icon-home-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #6366F1;
  border-radius: 2rpx;
  background: rgba(99, 102, 241, 0.15);
}

/* ---- 纯CSS图标：任务（勾选框） ---- */
.icon-task {
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #B0B0BF;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.icon-task-active {
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #6366F1;
  border-radius: 8rpx;
  background: rgba(99, 102, 241, 0.1);
  box-sizing: border-box;
  position: relative;
}
.icon-task-active::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #6366F1;
  font-weight: bold;
  line-height: 1;
}

/* ---- 纯CSS图标：经典（书本） ---- */
.icon-book {
  width: 42rpx;
  height: 34rpx;
  border: 3rpx solid #B0B0BF;
  border-radius: 4rpx;
  box-sizing: border-box;
  position: relative;
}
.icon-book::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  background: #B0B0BF;
  transform: translateX(-50%);
}
.icon-book-active {
  width: 42rpx;
  height: 34rpx;
  border: 3rpx solid #6366F1;
  border-radius: 4rpx;
  background: rgba(99, 102, 241, 0.1);
  box-sizing: border-box;
  position: relative;
}
.icon-book-active::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  background: #6366F1;
  transform: translateX(-50%);
}

/* ---- 纯CSS图标：我的（人物） ---- */
.icon-mine {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #B0B0BF;
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
}
.icon-mine::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 12rpx;
  border: 3rpx solid #B0B0BF;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
}
.icon-mine-active {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #6366F1;
  border-radius: 50%;
  background: rgba(99, 102, 241, 0.1);
  box-sizing: border-box;
  position: relative;
}
.icon-mine-active::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 12rpx;
  border: 3rpx solid #6366F1;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  background: rgba(99, 102, 241, 0.15);
  box-sizing: border-box;
}
