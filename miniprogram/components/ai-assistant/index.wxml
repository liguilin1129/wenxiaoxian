<!-- 全局悬浮 AI 助手（聊天型） -->
<view class="ai-wrap">
  <!-- 悬浮按钮 -->
  <view class="ai-fab" bindtap="onToggle" hover-class="fab-hover">
    <view class="fab-ring"></view>
    <view class="fab-icon">
      <text class="fab-text">AI</text>
    </view>
  </view>

  <!-- 聊天面板（贴底弹层） -->
  <view wx:if="{{showPanel}}" class="ai-mask" bindtap="onClose" catchtouchmove="preventMove">
    <view class="ai-panel" style="bottom: {{kbBottom}}" catchtap="preventMove">
      <!-- 面板头部 -->
      <view class="panel-header">
        <view class="panel-avatar">
          <text class="avatar-emoji">🤖</text>
        </view>
        <view class="panel-info">
          <text class="panel-title">小贤 AI 助手</text>
          <text class="panel-sub">陪你一起养成好习惯</text>
        </view>
        <view class="panel-close" bindtap="onClose">
          <text class="panel-close-x">✕</text>
        </view>
      </view>

      <!-- 消息区 -->
      <scroll-view class="chat-body" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation>
        <view
          wx:for="{{messages}}"
          wx:key="id"
          id="msg-{{item.id}}"
          class="msg-row {{item.role}}"
        >
          <view class="msg-bubble">{{item.content}}</view>
        </view>
        <view wx:if="{{typing}}" class="msg-row ai">
          <view class="msg-bubble typing">
            <text class="dot"></text>
            <text class="dot"></text>
            <text class="dot"></text>
          </view>
        </view>
      </scroll-view>

      <!-- 输入栏 -->
      <view class="chat-input-bar">
        <input
          class="chat-input"
          value="{{draft}}"
          bindinput="onInput"
          bindfocus="onFocus"
          bindblur="onBlur"
          placeholder="说点什么…"
          confirm-type="send"
          bindconfirm="onSend"
        />
        <view class="send-btn" bindtap="onSend">发送</view>
      </view>
    </view>
  </view>
</view>
