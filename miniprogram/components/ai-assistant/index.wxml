<!-- 全局悬浮 AI 助手（微信聊天风格） -->
<view class="ai-wrap">
  <!-- 悬浮按钮（可拖动，位置不持久化） -->
  <view
    class="ai-fab {{fabMoving ? 'moving' : ''}}"
    style="transform: translate({{fabOffset.x}}px, {{fabOffset.y}}px);"
    hover-class="{{fabMoving ? '' : 'fab-hover'}}"
    catchtouchstart="onFabTouchStart"
    catchtouchmove="onFabTouchMove"
    catchtouchend="onFabTouchEnd"
    catchtouchcancel="onFabTouchEnd"
  >
    <view class="fab-ring"></view>
    <view class="fab-icon">
      <text class="fab-text">AI</text>
    </view>
  </view>

  <!-- 聊天面板（贴底弹层） -->
  <view wx:if="{{showPanel}}" class="ai-mask" bindtap="onClose" catchtouchmove="preventMove">
    <view class="ai-panel" style="bottom: {{kbBottom}}" catchtap="preventMove" catchtouchmove="preventMove">
      <!-- 面板头部（微信导航栏风格） -->
      <view class="panel-header">
        <view class="panel-back" bindtap="onClose">
          <text class="panel-back-x">‹</text>
        </view>
        <text class="panel-title">小贤 AI 助手</text>
        <view class="panel-placeholder"></view>
      </view>

      <!-- 消息区 -->
      <scroll-view class="chat-body" style="height: {{bodyHeight}}px" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation catchtouchmove="preventMove">
        <view
          wx:for="{{messages}}"
          wx:key="id"
          id="msg-{{item.id}}"
          class="msg-row {{item.role}}"
        >
          <view class="msg-avatar">
            <text class="avatar-emoji">{{item.role === 'user' ? '😊' : '🤖'}}</text>
          </view>
          <view class="msg-bubble">{{item.content}}</view>
        </view>
        <view wx:if="{{typing}}" class="msg-row ai">
          <view class="msg-avatar">
            <text class="avatar-emoji">🤖</text>
          </view>
          <view class="msg-bubble typing">
            <text class="dot"></text>
            <text class="dot"></text>
            <text class="dot"></text>
          </view>
        </view>
      </scroll-view>

      <!-- 输入栏（微信风格） -->
      <view class="chat-input-bar" catchtouchmove="preventMove">
        <view class="chat-input-box">
          <input
            class="chat-input"
            value="{{draft}}"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
            placeholder="发送消息…"
            placeholder-class="chat-ph"
            confirm-type="send"
            bindconfirm="onSend"
          />
        </view>
        <view class="send-btn {{draft ? 'send-on' : ''}}" bindtap="onSend">发送</view>
      </view>
    </view>
  </view>
</view>
