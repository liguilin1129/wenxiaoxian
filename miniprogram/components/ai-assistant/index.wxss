/* ===== 全局悬浮 AI 助手 ===== */

/* ---- 悬浮按钮（FAB） ---- */
.ai-fab {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  box-shadow:
    0 8rpx 28rpx rgba(99, 102, 241, 0.4),
    0 2rpx 8rpx rgba(99, 102, 241, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 998;
  transition: transform 0.2s ease;
}
.ai-fab.fab-hover {
  transform: scale(0.92);
}

/* 呼吸光环 */
.fab-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 3rpx solid rgba(139, 92, 246, 0.35);
  animation: ai-pulse 2.5s ease-in-out infinite;
}

@keyframes ai-pulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.18); opacity: 0; }
}

/* 按钮内图标 */
.fab-icon {
  position: relative;
  z-index: 1;
}
.fab-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,.15);
}

/* ---- 遮罩层 ---- */
.ai-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 999;
  animation: fade-in 0.2s ease;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ---- 操作面板 ---- */
.ai-panel {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 200rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 28rpx 24rpx;
  box-shadow:
    0 16rpx 56rpx rgba(0, 0, 0, 0.15),
    0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 1000;
  animation: slide-up 0.25s cubic-bezier(.22, .9, .33, 1);
}

@keyframes slide-up {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* 面板头部 */
.panel-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F5;
}
.panel-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #EEF2FF, #EDE9FE);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-emoji {
  font-size: 34rpx;
}
.panel-info {
  flex: 1;
  margin-left: 18rpx;
}
.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A2E;
  display: block;
  line-height: 1.3;
}
.panel-sub {
  font-size: 23rpx;
  color: #9A9AAE;
  display: block;
  margin-top: 4rpx;
}
.panel-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F5F5F7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.panel-close text {
  font-size: 26rpx;
  color: #9A9AAE;
  line-height: 1;
}

/* 操作列表 */
.action-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.action-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  transition: background 0.15s;
}
.action-item:active {
  background: #F7F7FB;
}
.action-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.action-emoji {
  font-size: 30rpx;
}
.action-body {
  flex: 1;
  margin-left: 18rpx;
}
.action-label {
  font-size: 27rpx;
  font-weight: 600;
  color: #1A1A2E;
  display: block;
  line-height: 1.3;
}
.action-desc {
  font-size: 22rpx;
  color: #9A9AAE;
  display: block;
  margin-top: 2rpx;
}
.action-arrow {
  font-size: 32rpx;
  color: #C8C8D4;
  font-weight: 300;
  flex-shrink: 0;
}

/* 面板底部 */
.panel-footer {
  text-align: center;
  margin-top: 16rpx;
  padding-top: 12rpx;
}
.panel-footer text {
  font-size: 21rpx;
  color: #C0C0CC;
}
