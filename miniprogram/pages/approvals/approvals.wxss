.approval-note {
  margin-bottom: 24rpx; padding: 20rpx 24rpx;
  border-radius: var(--radius-sm); background: var(--brand-soft);
  color: var(--brand-700); font-size: 25rpx;
}
.approval-card {
  margin-bottom: 18rpx; padding: 28rpx;
  border-radius: var(--radius-sm); background: var(--surface);
  border: 1rpx solid var(--line);
}
.approval-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.approval-actions button { flex: 1; margin: 0; border-radius: 14rpx; font-size: 26rpx; line-height: 72rpx; }
.approval-reject { color: var(--ink-2); background: var(--surface-2); }
.approval-approve { color: #fff; background: var(--brand); }
.approval-empty { padding: 120rpx 28rpx; text-align: center; color: var(--ink-3); }
.approval-empty-icon { width: 90rpx; height: 90rpx; margin: 0 auto 24rpx; border-radius: 50%; background: var(--brand-soft); color: var(--brand-700); font-size: 48rpx; line-height: 90rpx; }
.approval-empty-title { color: var(--ink-1); font-size: 30rpx; font-weight: 700; }
.approval-empty-desc { margin-top: 12rpx; font-size: 25rpx; }
.approval-media{display:flex;gap:12rpx;margin-top:14rpx}.approval-media-item{display:flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;overflow:hidden;border-radius:12rpx;background:var(--surface-2);color:var(--brand);font-size:30rpx}.approval-media-item image{width:100%;height:100%}
