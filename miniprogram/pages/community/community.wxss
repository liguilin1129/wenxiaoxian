/* 社区页样式（复用 app.wxss 的 scr-head / scr-body / pill / avatar） */

/* ---- 成长圈动态流 ---- */
.feed .post {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.feed .post:last-child { border-bottom: none; }

.pbody { flex: 1; margin-left: 18rpx; min-width: 0; }
.phead { display: flex; justify-content: space-between; align-items: center; }
.pname { font-size: 28rpx; font-weight: 700; color: var(--ink-1); }
.ptime { font-size: 22rpx; color: var(--ink-3); }
.ptext { font-size: 27rpx; color: var(--ink-2); margin-top: 10rpx; line-height: 1.55; }
.pactions { display: flex; gap: 40rpx; margin-top: 16rpx; }
.act { font-size: 24rpx; color: var(--ink-3); display: flex; align-items: center; gap: 6rpx; }
.act.liked { color: var(--c-heart-d); }

/* ---- 动态图片/视频 ---- */
.pmedia {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.pm-item {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--surface-2);
}
.pm-item.pm-one {
  width: 60%;
  aspect-ratio: 16 / 10;
}
.pm-thumb { width: 100%; height: 100%; }
.pm-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 4rpx;
}

/* 发布按钮（左下角，避免与右下角 AI 助手悬浮按钮重叠） */
.fab {
  position: fixed;
  left: 32rpx;
  right: auto;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 52rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, .35);
  z-index: 30;
}
