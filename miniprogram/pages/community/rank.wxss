/* 邻里打卡榜：品牌紫 + 灰阶，不使用多色渐变 */
.rank-intro { display:flex; align-items:center; justify-content:space-between; margin-bottom:20rpx; padding:26rpx 28rpx; border:1rpx solid rgba(94,92,230,.16); border-radius:var(--radius-sm); background:#F5F4FF; }.rank-intro-title { color:var(--ink-1); font-size:31rpx; font-weight:800; }.rank-intro-sub { margin-top:7rpx; color:var(--ink-3); font-size:22rpx; }.rank-intro-icon { width:68rpx; height:68rpx; display:flex; align-items:center; justify-content:center; border-radius:20rpx; background:#fff; font-size:34rpx; }
.ranks .rank {
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: none;
}
.ranks .rank.me { border-color: rgba(94,92,230,.45); background: #FAFAFF; }

.rno {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  flex: none;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink-3);
  background: var(--surface-2);
}
.rno-1 { color:#fff; background:var(--brand); }
.rno-2,.rno-3 { color:var(--brand-700); background:var(--brand-soft); }

.rname { flex: 1; font-size: 28rpx; font-weight: 700; color: var(--ink-1); }
.rdays { font-size: 24rpx; color: var(--ink-3); }
.rdays .rnum { font-size: 30rpx; font-weight: 800; color: var(--ink-1); margin: 0 4rpx; }
