/* 育儿干货精选 */
.articles .art {
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.art-hover { background: var(--surface-2); }
.acover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  flex: none;
  margin-right: 20rpx;
  background: var(--brand-soft);
  color: var(--brand-700);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}
.atext { flex: 1; min-width: 0; }
.atitle { font-size: 28rpx; font-weight: 700; color: var(--ink-1); }
.ameta { display: flex; align-items: center; gap: 14rpx; margin-top: 10rpx; }
.aread { font-size: 22rpx; color: var(--ink-3); }
.darrow { font-size: 40rpx; color: var(--ink-3); margin-left: 10rpx; flex: none; }

/* 发布按钮（左下角，避免与右下角 AI 助手悬浮按钮重叠） */
.fab {
  position: fixed;
  left: 32rpx;
  right: auto;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 52rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, .35);
  z-index: 30;
}
