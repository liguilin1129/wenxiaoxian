<top-tabs tabs="{{tabs}}" current="rank" bind:change="onTabChange" />

<view class="scr-body">
  <view class="rank-intro"><view><view class="rank-intro-title">本周连续打卡榜</view><view class="rank-intro-sub">每一次坚持，都会成为成长的印记</view></view><view class="rank-intro-icon">🏆</view></view>
  <view class="ranks">
    <view wx:for="{{ranks}}" wx:key="id" class="rank {{item.me ? 'me' : ''}}">
      <view class="rno rno-{{item.id}}">{{item.id}}</view>
      <view class="avatar sm">{{item.avatar}}</view>
      <view class="rname">{{item.name}}{{item.me ? '（我）' : ''}}</view>
      <view class="rdays">连续 <text class="rnum">{{item.days}}</text> 天</view>
    </view>
  </view>
</view>

<ai-assistant />
