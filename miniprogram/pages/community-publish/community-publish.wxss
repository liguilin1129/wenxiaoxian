/* 社区发布页 */
.scr-body { padding-bottom: 120rpx; }

.pub-hint {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.field {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}

.title-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink-1);
}
.title-input::placeholder { color: var(--ink-3); font-weight: 400; }

.content-input {
  width: 100%;
  min-height: 280rpx;
  font-size: 30rpx;
  color: var(--ink-2);
  line-height: 1.6;
}
.content-input::placeholder { color: var(--ink-3); }

.counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 12rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-1);
  margin-bottom: 16rpx;
}
.label .sub {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-3);
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.p-arrow { color: var(--ink-3); font-size: 32rpx; }

/* ---- 媒体选择区 ---- */
.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.media-item,
.media-add {
  position: relative;
  width: calc((100% - 36rpx) / 3);
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--surface-2);
  box-sizing: border-box;
}

.media-thumb {
  width: 100%;
  height: 100%;
}

.video-badge {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 4rpx;
}

.media-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

.media-add {
  border: 2rpx dashed var(--ink-3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ink-3);
}
.add-icon { font-size: 48rpx; line-height: 1; }
.add-text { font-size: 22rpx; margin-top: 8rpx; }

.btn {
  margin-top: 12rpx;
}
