<view class="scr-head"><view class="greet">{{mode === 'article' ? '育儿干货' : '成长社区'}}</view><view class="title">{{mode === 'article' ? '发布经验' : '发布动态'}}</view></view>
<view class="scr-body">
  <view class="pub-hint">
    {{mode === 'article' ? '分享你的育儿经验，帮助更多家长' : '记录孩子日常，和全体成长伙伴一起成长'}}
  </view>

  <!-- 经验标题 -->
  <view wx:if="{{mode === 'article'}}" class="field">
    <input
      class="title-input"
      placeholder="请输入标题"
      value="{{title}}"
      bindinput="onTitleInput"
      maxlength="30"
    />
  </view>

  <!-- 正文 -->
  <view class="field">
    <textarea
      class="content-input"
      placeholder="{{mode === 'article' ? '写下你的经验正文…' : '分享今天孩子的成长点滴…'}}"
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="{{maxContent}}"
      show-confirm-bar="{{false}}"
    />
    <view class="counter">{{content.length}}/{{maxContent}}</view>
  </view>

  <!-- 图片/视频 -->
  <view class="field">
    <view class="label">添加图片或视频 <text class="sub">（最多 9 个）</text></view>
    <view class="media-grid">
      <view
        wx:for="{{media}}"
        wx:key="index"
        class="media-item"
        data-index="{{index}}"
        bindtap="previewMedia"
      >
        <image class="media-thumb" src="{{item.thumb}}" mode="aspectFill" />
        <view wx:if="{{item.type === 'video'}}" class="video-badge">▶</view>
        <view
          class="media-del"
          data-index="{{index}}"
          catchtap="removeMedia"
        >×</view>
      </view>
      <view wx:if="{{media.length < 9}}" class="media-add" bindtap="chooseMedia">
        <text class="add-icon">+</text>
        <text class="add-text">图片/视频</text>
      </view>
    </view>
  </view>

  <!-- 标签 -->
  <view class="field">
    <view class="label">选择标签</view>
    <picker mode="selector" range="{{tags}}" value="{{tagIndex}}" bindchange="onTagChange">
      <view class="picker">
        <text class="pill pill-habit">{{tags[tagIndex]}}</text>
        <text class="p-arrow">›</text>
      </view>
    </picker>
  </view>

  <button class="btn" bindtap="submit">发布</button>
</view>
