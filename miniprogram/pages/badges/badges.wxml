<view class="scr-head"><view class="greet">成长荣誉</view><view class="title">荣誉墙</view></view>
<view class="page">
  <view class="hero">
    <view class="hero-avatar">{{child.avatar || '贤'}}</view>
    <view><view class="hero-title">{{child.name || '我的成长荣誉'}}</view><view class="hero-sub">已点亮 {{got}} / {{total}} 枚勋章</view></view>
  </view>
  <view class="summary"><view><text>{{got}}</text><text>已获得</text></view><view><text>{{total - got}}</text><text>待解锁</text></view><view><text>{{total ? Math.round(got / total * 100) : 0}}%</text><text>完成度</text></view></view>
  <view class="section-title">我的勋章</view>
  <view class="grid"><view wx:for="{{badges}}" wx:key="id" class="card {{item.got ? 'got' : 'locked'}}" data-badge="{{item}}" bindtap="showBadge"><view class="icon">{{item.got ? item.icon : '🔒'}}</view><view class="name">{{item.name}}</view><view class="desc">{{item.desc}}</view><view class="bar"><view class="fill" style="width:{{item.progress}}%"></view></view><view class="progress">{{item.got ? '已点亮' : item.displayValue + '/' + item.target + item.unit}}</view></view></view>
</view>
