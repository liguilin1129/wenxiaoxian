/* 奖品编辑表单 */
.scr-body { padding: 24rpx 32rpx 160rpx; }

.form-card {
  background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--radius-sm); padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.field { padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.field.noborder { border-bottom: none; }
.field .label { font-size: 26rpx; color: var(--ink-3); margin-bottom: 16rpx; }

.input {
  font-size: 31rpx; color: var(--ink-1); background: transparent; padding: 4rpx 0;
}
.textarea {
  width: 100%; height: 130rpx; font-size: 30rpx; color: var(--ink-1);
  background: var(--surface-2); border-radius: var(--radius-xs); padding: 18rpx; line-height: 1.5;
}

.picker {
  display: flex; align-items: center; gap: 16rpx;
  background: var(--surface-2); border-radius: var(--radius-xs); padding: 18rpx 22rpx;
}
.picker .dot { width: 22rpx; height: 22rpx; border-radius: 50%; flex: none; }
.picker .pname { font-size: 30rpx; font-weight: 600; color: var(--ink-1); flex: 1; }
.picker .ar { color: var(--ink-3); font-size: 34rpx; }

.btn[disabled] { opacity: .45; }

.del-link {
  text-align: center; margin-top: 30rpx; font-size: 27rpx; color: var(--c-heart-d); font-weight: 600;
}
