.reminder-page { min-height:100vh; box-sizing:border-box; padding:30rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background:#F6F6FA; }.reminder-hero { display:flex; align-items:center; justify-content:space-between; padding:32rpx; border-radius:28rpx; color:#fff; background:linear-gradient(135deg,#6E6CF0,#5E5CE6); box-shadow:0 10rpx 28rpx rgba(94,92,230,.2); }.reminder-kicker { font-size:23rpx; opacity:.8; }.reminder-title { margin-top:7rpx; font-size:36rpx; font-weight:800; }.reminder-desc { max-width:510rpx; margin-top:13rpx; font-size:23rpx; line-height:1.55; opacity:.84; }.reminder-hero-icon { font-size:68rpx; }.reminder-toolbar { display:flex; justify-content:space-between; margin:30rpx 8rpx 14rpx; color:var(--ink-3); font-size:23rpx; }.reminder-toolbar text:last-child { color:var(--brand); font-weight:650; }.reminder-card { overflow:hidden; margin-bottom:16rpx; border:1rpx solid var(--line); border-radius:22rpx; background:#fff; box-shadow:0 3rpx 12rpx rgba(17,17,26,.035); }.reminder-card-top { display:flex; align-items:center; gap:18rpx; padding:26rpx; }.reminder-icon { display:flex; align-items:center; justify-content:center; flex:none; width:72rpx; height:72rpx; border-radius:22rpx; background:#EEEDFE; font-size:34rpx; }.reminder-content { flex:1; min-width:0; }.reminder-name { color:var(--ink-1); font-size:28rpx; font-weight:750; }.reminder-copy { margin-top:7rpx; color:var(--ink-3); font-size:23rpx; line-height:1.45; }.reminder-go { flex:none; color:var(--brand); font-size:23rpx; }.reminder-card-foot { padding:14rpx 26rpx; border-top:1rpx solid var(--sep); color:var(--ink-3); font-size:22rpx; text-align:right; }.reminder-card-foot text { padding:8rpx; }.reminder-empty { margin-top:30rpx; padding:76rpx 24rpx; border-radius:24rpx; color:var(--ink-3); background:#fff; text-align:center; font-size:25rpx; line-height:1.7; }.reminder-empty > view:first-child { font-size:68rpx; }.reminder-empty-title { margin-top:12rpx; color:var(--ink-1); font-size:30rpx; font-weight:750; }
