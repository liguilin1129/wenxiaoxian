.profile-page { min-height: 100vh; padding-bottom: calc(144rpx + env(safe-area-inset-bottom)); }
.guest-login { display:flex; align-items:center; gap:24rpx; padding:56rpx 32rpx; background:linear-gradient(135deg,#EEEDFE,#F5F3FF); }
.guest-login-avatar { width:96rpx; height:96rpx; border-radius:50%; background:var(--surface); display:flex; align-items:center; justify-content:center; font-size:48rpx; flex:none; box-shadow:0 2rpx 8rpx rgba(17,17,26,.05); }
.guest-login-title { font-size:32rpx; font-weight:700; color:var(--ink-1); }.guest-login-arrow { font-size:44rpx; color:var(--ink-3); flex:none; }
.profile-header { display:flex; align-items:center; gap:20rpx; padding:42rpx 32rpx 58rpx; background:linear-gradient(180deg,#FFF7ED 0%,#FFEDD5 100%); }
.profile-info { flex:1; min-width:0; }.profile-name { font-size:40rpx; font-weight:800; color:#1A1A2E; }.profile-level { margin-top:8rpx; font-size:25rpx; color:#8B6F4E; }
.profile-points { display:flex; flex-direction:column; gap:3rpx; text-align:right; color:#8B5A2B; font-size:21rpx; white-space:nowrap; }.profile-points text:first-child { font-size:31rpx; font-weight:800; line-height:1; }
.profile-edit { flex:none; padding:10rpx 20rpx; border:1rpx solid rgba(139,90,43,.12); border-radius:999rpx; background:rgba(255,255,255,.65); color:#8B5A2B; font-size:24rpx; }
.stats-card { display:flex; margin:-24rpx 32rpx 0; position:relative; z-index:1; padding:24rpx 0; border:1rpx solid var(--line); border-radius:var(--radius-sm); background:var(--surface); box-shadow:0 6rpx 18rpx rgba(17,17,26,.06); }
.stat-item { flex:1; position:relative; text-align:center; padding:8rpx 0; }.stat-item + .stat-item::before { content:""; position:absolute; left:0; top:12rpx; bottom:12rpx; width:1rpx; background:var(--sep); }.stat-num { font-size:38rpx; font-weight:800; color:var(--ink-1); line-height:1.2; }.stat-suffix { margin-left:3rpx; font-size:21rpx; color:var(--ink-3); }.stat-label { margin-top:8rpx; font-size:23rpx; color:var(--ink-3); }
.profile-section { margin:28rpx 32rpx 0; }.tools-section { padding:26rpx 20rpx 18rpx; border:1rpx solid var(--line); border-radius:var(--radius-sm); background:var(--surface); box-shadow:0 2rpx 8rpx rgba(17,17,26,.04); }.section-head { display:flex; align-items:baseline; justify-content:space-between; margin:0 8rpx 18rpx; }.section-title { font-size:30rpx; font-weight:750; color:var(--ink-1); }.section-sub { font-size:22rpx; color:var(--ink-3); }
.tools-grid { display:flex; }.tool-item { width:25%; display:flex; flex-direction:column; align-items:center; padding:12rpx 0; }.tool-icon-wrap { position:relative; }.tool-icon { width:82rpx; height:82rpx; display:flex; align-items:center; justify-content:center; border-radius:24rpx; font-size:36rpx; }.tool-badge { position:absolute; top:-8rpx; right:-12rpx; min-width:30rpx; height:30rpx; padding:0 7rpx; border:3rpx solid var(--surface); border-radius:999rpx; background:#E5484D; color:#fff; text-align:center; font-size:19rpx; line-height:24rpx; }.tool-name { margin-top:12rpx; color:var(--ink-2); font-size:23rpx; }
.profile-group { overflow:hidden; border:1rpx solid var(--line); border-radius:var(--radius-sm); background:var(--surface); box-shadow:0 2rpx 8rpx rgba(17,17,26,.04); }.profile-row { display:flex; align-items:center; min-height:94rpx; padding:0 24rpx; position:relative; }.profile-row + .profile-row::before { content:""; position:absolute; top:0; left:72rpx; right:0; height:1rpx; background:var(--sep); }.profile-row-left { display:flex; align-items:center; gap:16rpx; flex:1; color:var(--ink-1); font-size:27rpx; }.profile-row-icon { width:32rpx; text-align:center; font-size:28rpx; }.profile-row-note { color:var(--ink-3); font-size:23rpx; white-space:nowrap; }.profile-row-right { margin-left:12rpx; color:var(--ink-3); font-size:34rpx; }.profile-logout { margin:32rpx; width:calc(100% - 64rpx); font-size:26rpx; padding:20rpx; }
