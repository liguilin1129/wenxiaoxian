<view class="profile-page">
  <!-- 顶部用户信息 -->
  <view class="profile-header">
    <view class="avatar lg">{{child.avatar}}</view>
    <view class="profile-info">
      <view class="profile-name">{{child.name}}</view>
      <view class="profile-level">{{child.levelName}} · Lv.{{child.levelNum}}</view>
    </view>
    <view class="profile-edit" bindtap="editProfile">编辑</view>
  </view>

  <!-- VIP 超级会员卡（无真实数据时隐藏） -->
  <view class="vip-card" wx:if="{{showVip}}">
    <view class="vip-left">
      <view class="vip-title">VIP 超级会员</view>
      <view class="vip-desc">畅享专属成长权益</view>
    </view>
    <view class="vip-btn">立即续费</view>
  </view>

  <!-- 会员等级条（无真实数据时隐藏） -->
  <view class="level-bar" bindtap="goMembers" wx:if="{{showMember}}">
    <view class="level-left">
      <text class="level-icon">💎</text>
      <text class="level-name">普通会员</text>
      <text class="level-tag">未解锁</text>
    </view>
    <view class="level-right">0元入会，享专属等级权益 ›</view>
  </view>

  <!-- 数据指标 -->
  <view class="stats-card">
    <view
      wx:for="{{stats}}"
      wx:key="label"
      class="stat-item"
      bindtap="{{item.action}}"
    >
      <view class="stat-num">{{item.num}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 必备工具 -->
  <view class="tools-section">
    <view class="section-title">必备工具</view>
    <view class="tools-grid">
      <view
        wx:for="{{tools}}"
        wx:key="name"
        class="tool-item"
        bindtap="{{item.action}}"
      >
        <view class="tool-icon" style="background:{{item.bg}};color:{{item.color}}">{{item.icon}}</view>
        <view class="tool-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 更多服务 -->
  <view class="section-title" style="margin-top:8rpx">更多服务</view>
  <view class="menu" bindtap="goClassics">
    <view class="mt"><text class="mi">📖</text>经典书架</view>
    <text class="mv">17 部 ›</text>
  </view>
  <view class="menu" bindtap="goMembers">
    <view class="mt"><text class="mi">👨‍👩‍👦</text>我的家庭</view>
    <text class="mv">家庭会议 · 公约 ›</text>
  </view>

  <button class="btn soft" style="margin-top:8rpx" bindtap="logout">退出成长花园</button>
</view>

<ai-assistant />
