.empty,.tip{padding:40rpx 20rpx;text-align:center;color:var(--ink-3);font-size:25rpx}.name{font-size:36rpx;font-weight:800}.meta{margin-top:8rpx;color:var(--ink-3);font-size:25rpx}.code-label{margin-top:34rpx;color:var(--ink-3);font-size:23rpx}.code{margin:6rpx 0 26rpx;color:var(--brand-700);font-size:48rpx;font-weight:800;letter-spacing:8rpx}.input{width:100%;height:88rpx;margin:12rpx 0 20rpx;padding:0 22rpx;border-radius:16rpx;background:var(--surface-2);font-size:28rpx}.manage-btn{margin-top:16rpx}.edit-card{margin-top:20rpx}.edit-actions{display:flex;gap:16rpx}.edit-actions .btn{flex:1;margin:0}.renew-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:26rpx;padding-top:20rpx;border-top:1rpx solid var(--sep);color:var(--ink-3);font-size:24rpx}.renew-row text{flex-shrink:0;color:var(--brand);font-weight:700}
