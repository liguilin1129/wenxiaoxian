.tabs{display:flex;margin-bottom:20rpx;padding:6rpx;border-radius:18rpx;background:var(--surface-2)}.tab{flex:1;padding:14rpx 0;border-radius:14rpx;color:var(--ink-3);font-size:26rpx;text-align:center}.tab.active{background:#fff;color:var(--brand);font-weight:750;box-shadow:0 2rpx 8rpx rgba(17,17,26,.06)}.composer{padding:20rpx}.composer textarea{width:100%;height:150rpx;color:var(--ink-1);font-size:27rpx;line-height:1.55}.composer-foot{display:flex;align-items:center;justify-content:space-between;padding-top:12rpx;border-top:1rpx solid var(--sep);color:var(--ink-3);font-size:21rpx}.composer-foot .btn{width:132rpx;margin:0;font-size:25rpx}.post{margin-bottom:18rpx;padding:24rpx}.post-head,.member,.comment{display:flex;align-items:center;gap:16rpx}.avatar{display:flex;align-items:center;justify-content:center;width:56rpx;height:56rpx;flex:none;border-radius:50%;background:var(--brand-soft);color:var(--brand);font-size:25rpx;font-weight:750}.post-name,.member-info>view:first-child,.comment-name{color:var(--ink-1);font-size:27rpx;font-weight:700}.post-time,.member-info>view:last-child{margin-top:5rpx;color:var(--ink-3);font-size:21rpx}.post-text{margin:20rpx 0;color:var(--ink-2);font-size:28rpx;line-height:1.65;white-space:pre-wrap}.post-actions{display:flex;gap:28rpx;padding-top:18rpx;border-top:1rpx solid var(--sep)}.action{color:var(--ink-3);font-size:24rpx}.action.liked{color:#E15B77}.member{margin-bottom:14rpx;padding:20rpx 24rpx}.member-info{flex:1}.self{color:var(--ink-3);font-size:22rpx;font-weight:400}.remove{color:#D55A6A;font-size:24rpx}.leave-btn{margin:28rpx 0;background:#FFF4F5;color:#D55A6A;font-size:27rpx}.owner-note,.empty{padding:42rpx 20rpx;color:var(--ink-3);font-size:25rpx;text-align:center}.comment-mask{position:fixed;z-index:100;inset:0;display:flex;align-items:flex-end;background:rgba(0,0,0,.42)}.comment-panel{width:100%;max-height:76vh;border-radius:28rpx 28rpx 0 0;background:#fff;overflow:hidden}.comment-title{display:flex;justify-content:space-between;padding:26rpx 28rpx;border-bottom:1rpx solid var(--sep);color:var(--ink-1);font-size:30rpx;font-weight:800}.comment-title text{color:var(--brand);font-size:24rpx;font-weight:500}.comment-list{height:52vh;padding:20rpx 28rpx;box-sizing:border-box}.comment{align-items:flex-start;margin-bottom:20rpx}.comment-text{margin-top:6rpx;color:var(--ink-2);font-size:26rpx;line-height:1.5}.comment-bar{display:flex;gap:14rpx;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--sep)}.comment-bar input{flex:1;min-width:0;height:68rpx;padding:0 20rpx;border-radius:999rpx;background:var(--surface-2);font-size:25rpx}.comment-bar button{margin:0;padding:0 22rpx;border-radius:999rpx;background:var(--brand);color:#fff;font-size:24rpx;line-height:68rpx}
