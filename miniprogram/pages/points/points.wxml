<view class="scr-head">
  <view class="greet">积分明细</view>
  <view class="title">{{points}} 分</view>
</view>

<view class="scr-body">
  <view class="points-summary">
    <view class="points-summary-item">
      <text class="points-summary-label">今日获得</text>
      <text class="points-summary-value">+{{todayGain}}</text>
    </view>
    <view class="points-summary-divider"></view>
    <view class="points-summary-item">
      <text class="points-summary-label">累计获得</text>
      <text class="points-summary-value">+{{totalEarned}}</text>
    </view>
    <view class="points-summary-divider"></view>
    <view class="points-summary-item">
      <text class="points-summary-label">累计消耗</text>
      <text class="points-summary-value points-summary-used">-{{totalSpent}}</text>
    </view>
  </view>

  <view class="chips" style="margin-bottom:24rpx">
    <text class="pill {{filter==='all'?'pill-habit':''}}" data-f="all" bindtap="setFilter">全部</text>
    <text class="pill {{filter==='get'?'pill-habit':''}}" data-f="get" bindtap="setFilter">获得</text>
    <text class="pill {{filter==='use'?'pill-taste':''}}" data-f="use" bindtap="setFilter">消耗</text>
  </view>

  <view wx:if="{{groups.length}}">
    <view wx:for="{{groups}}" wx:for-item="group" wx:key="date" class="points-date-group">
      <view class="points-date">{{group.date}}</view>
      <view wx:for="{{group.list}}" wx:for-item="record" wx:key="index" class="task">
        <view class="row between">
          <view>
            <view class="tn" style="font-size:28rpx">{{record.title}}</view>
            <view class="muted">{{dimName[record.dim]}}</view>
          </view>
          <text class="{{record.delta >= 0 ? 'pts-pos' : 'pts-neg'}}">{{record.delta >= 0 ? '+' : ''}}{{record.delta}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="points-empty">暂无{{filter === 'use' ? '消耗' : (filter === 'get' ? '获得' : '')}}记录</view>
</view>

<ai-assistant />
