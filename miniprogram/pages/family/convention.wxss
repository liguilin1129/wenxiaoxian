.convention-tip { margin-bottom:24rpx; padding:22rpx 24rpx; border-radius:var(--radius-sm); background:var(--brand-soft); color:var(--brand-700); font-size:25rpx; line-height:1.65; }.field-label { margin-bottom:12rpx; color:var(--ink-2); font-size:26rpx; font-weight:600; }.field-input,.convention-textarea { display:block; width:100%; box-sizing:border-box; padding:20rpx 24rpx; border-radius:var(--radius-xs); background:var(--surface-2); color:var(--ink-1); font-size:28rpx; }.field-input { min-height:88rpx; line-height:48rpx; }.convention-textarea { height:360rpx; line-height:1.65; }.convention-count,.convention-updated { margin-top:10rpx; color:var(--ink-3); font-size:22rpx; text-align:right; }.convention-updated { text-align:center; }
