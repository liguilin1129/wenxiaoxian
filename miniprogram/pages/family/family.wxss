.member-row {
  display: flex;
  gap: 24rpx;
}
.member {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}
.member-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-1);
}
.member-role {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.member-edit-hint { margin-top: 6rpx; padding: 3rpx 12rpx; border-radius: 999rpx; background: var(--surface-2); color: var(--ink-3); font-size: 20rpx; }
.badge {
  display: inline-block;
  background: var(--c-heart);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-right: 8rpx;
}
