<view class="scr-head">
  <view class="row between" style="align-items:flex-end">
    <view>
      <view class="greet" style="color:var(--c-habit-d);font-weight:600">家庭议事</view>
      <view class="title">家庭会议</view>
    </view>
    <view class="mg-btn" bindtap="toggleMode">{{mode === 'list' ? '发起会议' : '返回列表'}}</view>
  </view>
</view>

<view class="scr-body">
  <!-- 列表模式 -->
  <block wx:if="{{mode === 'list'}}">
    <view wx:if="{{!meetings.length}}" class="empty">
      <view class="empty-icon">🪑</view>
      <view class="empty-title">还没有家庭会议</view>
      <view class="empty-desc">点击右上角「发起会议」，把决议变成任务和心愿。</view>
    </view>

    <view wx:for="{{meetings}}" wx:key="id" class="meeting-card" bindtap="openMeeting" data-id="{{item.id}}">
      <view class="row between" style="margin-bottom:12rpx">
        <view class="tn">{{item.title}}</view>
        <text class="pill pill-{{item.status === 'done' ? 'body' : 'habit'}}">{{item.status === 'done' ? '已结束' : '待召开'}}</text>
      </view>
      <view class="muted">{{item.date}} {{item.time}} · {{item.topics.length}} 个议题</view>
      <view wx:if="{{item.status === 'done' && item.summary}}" class="meeting-summary">{{item.summary}}</view>
    </view>
  </block>

  <!-- 发起/进行会议 -->
  <block wx:if="{{mode === 'form'}}">
    <view class="card">
      <view class="field-label">会议主题</view>
      <input class="field-input" placeholder="例如：本周家庭会议" value="{{form.title}}" bindinput="onTitle" />

      <view class="field-label" style="margin-top:24rpx">议题模板</view>
      <view class="template-row">
        <view class="template-chip" wx:for="{{templates}}" wx:key="type" bindtap="addTopic" data-type="{{item.type}}">+ {{item.name}}</view>
      </view>
    </view>

    <!-- 议题列表 -->
    <view wx:if="{{form.topics.length}}" class="section-title">待决议议题</view>
    <view wx:for="{{form.topics}}" wx:key="id" class="topic-card">
      <view class="row between">
        <view>
          <view class="topic-type">{{topicTypeName(item.type)}}</view>
          <input class="topic-title" placeholder="议题标题" value="{{item.title}}" data-idx="{{index}}" data-field="title" bindinput="onTopic" />
        </view>
        <view class="del-btn" data-idx="{{index}}" bindtap="removeTopic">删除</view>
      </view>
      <input class="topic-content" placeholder="补充说明" value="{{item.content}}" data-idx="{{index}}" data-field="content" bindinput="onTopic" />
      <view class="row" style="margin-top:16rpx;gap:16rpx">
        <input class="topic-input-sm" placeholder="名称" value="{{item.target.name}}" data-idx="{{index}}" data-field="targetName" bindinput="onTopic" />
        <input class="topic-input-sm" type="digit" placeholder="积分" value="{{item.target.points}}" data-idx="{{index}}" data-field="targetPoints" bindinput="onTopic" />
      </view>
    </view>

    <button class="btn" style="margin-top:32rpx" bindtap="createMeeting">创建会议</button>
  </block>

  <!-- 会议详情 -->
  <block wx:if="{{mode === 'detail'}}">
    <view class="meeting-card" style="border-color:var(--brand-soft2)">
      <view class="row between">
        <view class="tn">{{current.title}}</view>
        <text class="pill pill-{{current.status === 'done' ? 'body' : 'habit'}}">{{current.status === 'done' ? '已结束' : '待召开'}}</text>
      </view>
      <view class="muted" style="margin-top:8rpx">{{current.date}} {{current.time}}</view>
    </view>

    <view class="section-title">议题决议</view>
    <view wx:for="{{current.topics}}" wx:key="id" class="topic-card">
      <view class="row between" style="align-items:flex-start">
        <view>
          <view class="topic-type">{{topicTypeName(item.type)}}</view>
          <view class="topic-title-static">{{item.title || '未命名议题'}}</view>
          <view class="muted" wx:if="{{item.content}}">{{item.content}}</view>
          <view class="topic-target" wx:if="{{item.target.name}}">
            落地：{{item.target.name}} · {{item.target.points}} 分
          </view>
        </view>
        <view wx:if="{{current.status === 'pending'}}" class="check {{item.approved ? 'on' : ''}}" data-idx="{{index}}" bindtap="toggleApprove">
          <text wx:if="{{item.approved}}">✓</text>
        </view>
        <text wx:else class="pill pill-{{item.approved ? 'body' : 'taste'}}">{{item.approved ? '已通过' : '未通过'}}</text>
      </view>
    </view>

    <view wx:if="{{current.status === 'pending'}}" class="card" style="margin-top:24rpx">
      <view class="field-label">会议纪要</view>
      <textarea class="field-textarea" placeholder="记录本次家庭会议的核心结论..." value="{{summary}}" bindinput="onSummary" />
    </view>

    <button wx:if="{{current.status === 'pending'}}" class="btn" style="margin-top:32rpx" bindtap="closeMeeting">结束会议并落地决议</button>
  </block>
</view>
