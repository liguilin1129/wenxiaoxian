<view class="scr-head">
  <view class="greet" style="color:var(--c-habit-d);font-weight:600">文小贤的家庭</view>
  <view class="title">家庭空间</view>
</view>

<view class="scr-body">
  <!-- 家长代管与家庭邀请码 -->
  <view class="card family-access-card" wx:if="{{familyProfile}}">
    <view class="row between access-title-row">
      <view>
        <view class="tn">家庭身份</view>
        <view class="access-subtitle">{{familyProfile.name}}</view>
      </view>
      <view class="managed-tag">家长代管中</view>
    </view>
    <view class="access-note">家长可统一管理孩子资料、任务、审核与积分；孩子独立使用时可凭邀请码加入同一家庭。</view>
    <view class="invite-box">
      <view>
        <view class="invite-label">家庭邀请码</view>
        <view class="invite-code">{{familyProfile.inviteCode}}</view>
      </view>
      <view class="invite-actions">
        <view class="invite-copy" bindtap="copyInviteCode">复制</view>
        <view class="invite-renew" bindtap="renewInviteCode">换一组</view>
      </view>
    </view>
    <view class="access-tip">提示：当前邀请码已生成；跨账号加入会在云端家庭数据同步完成后自动启用。</view>
  </view>

  <!-- 家庭成员 -->
  <view class="card">
    <view class="row between" style="margin-bottom:20rpx">
      <view class="tn">家庭成员</view>
      <text class="muted">{{members.length}} 人 · 点击成员编辑</text>
    </view>
    <view class="member-row">
      <view class="member" wx:for="{{members}}" wx:key="id" data-id="{{item.id}}" bindtap="editMember">
        <view class="member-avatar" style="background:{{item.bg}};color:{{item.color}}">{{item.avatar}}</view>
        <view class="member-name">{{item.name}}</view>
        <view class="member-role">{{item.role}}</view>
        <view class="member-edit-hint">编辑</view>
      </view>
      <view class="member member-add" bindtap="addMember">
        <view class="member-avatar member-add-avatar">＋</view>
        <view class="member-name">添加成员</view>
        <view class="member-role">家长或孩子</view>
      </view>
    </view>
  </view>

  <view class="menu" bindtap="goTaskManage"><view class="mt"><text class="mi" style="background:var(--c-heart-bg);color:var(--c-heart-d)">📝</text>家长任务管理</view><view class="mv">创建与分配 ›</view></view>

  <!-- 家庭会议入口 -->
  <view class="menu" bindtap="goMeeting">
    <view class="mt">
      <text class="mi" style="background:var(--c-habit-bg);color:var(--c-habit-d)">🪑</text>
      家庭会议
    </view>
    <view class="mv">
      <text wx:if="{{pendingCount}}" class="badge">{{pendingCount}}</text>
      <text>{{pendingCount ? '有待开会议' : '议事与决议'}} ›</text>
    </view>
  </view>

  <!-- 家庭公约 -->
  <view class="menu" bindtap="goConvention">
    <view class="mt">
      <text class="mi" style="background:var(--c-body-bg);color:var(--c-body-d)">📜</text>
      家庭公约
    </view>
    <view class="mv">查看 ›</view>
  </view>

  <!-- 会议产出概览 -->
  <view class="section-title" style="margin-top:8rpx">会议落地</view>
  <view class="quad">
    <view class="q">
      <view class="qn"><text class="dot" style="background:var(--c-habit)"></text>新增任务</view>
      <view class="qpct">{{stats.tasks}}</view>
      <view class="qp">已落地到任务中心</view>
    </view>
    <view class="q">
      <view class="qn"><text class="dot" style="background:var(--c-taste)"></text>新增心愿</view>
      <view class="qpct">{{stats.rewards}}</view>
      <view class="qp">已落地到商城</view>
    </view>
  </view>

  <view class="muted" style="text-align:center;margin-top:24rpx">家庭会议是周期性议事工具，不是每日必做。</view>
</view>

<ai-assistant />
