.mg-btn {
  font-size: 26rpx;
  color: var(--brand-600);
  font-weight: 600;
  padding: 12rpx 20rpx;
  background: var(--brand-soft);
  border-radius: var(--radius-xs);
}
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}
.empty-icon { font-size: 96rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 34rpx; font-weight: 700; color: var(--ink-1); }
.empty-desc { font-size: 26rpx; color: var(--ink-3); margin-top: 12rpx; }

.meeting-card {
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 28rpx;
  border: 1px solid var(--line);
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.meeting-summary {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-2);
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}
.field-input {
  background: var(--surface-2);
  border-radius: var(--radius-xs);
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: var(--ink-1);
  width: 100%;
  box-sizing: border-box;
}
.field-textarea {
  background: var(--surface-2);
  border-radius: var(--radius-xs);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink-1);
  width: 100%;
  height: 180rpx;
}

.template-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.template-chip {
  font-size: 26rpx;
  color: var(--brand-700);
  background: var(--brand-soft);
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.topic-card {
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  border: 1px solid var(--line);
  margin-bottom: 20rpx;
}
.topic-type {
  font-size: 22rpx;
  color: var(--brand-600);
  font-weight: 700;
  margin-bottom: 8rpx;
}
.topic-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-1);
  margin-bottom: 8rpx;
  width: 100%;
  box-sizing: border-box;
}
.topic-title-static {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-1);
  margin-bottom: 8rpx;
}
.topic-content {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
  background: var(--surface-2);
  border-radius: var(--radius-xs);
  padding: 16rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.topic-input-sm {
  flex: 1;
  width: 0;
  min-width: 0;
  background: var(--surface-2);
  border-radius: var(--radius-xs);
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.topic-editor-row { align-items: flex-start; gap: 16rpx; }
.topic-editor-main { flex: 1; min-width: 0; }
.topic-target {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--c-habit-d);
  font-weight: 600;
}
.del-btn {
  font-size: 24rpx;
  color: var(--c-heart-d);
  font-weight: 600;
  padding: 8rpx 16rpx;
}
