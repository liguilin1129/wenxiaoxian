.mg-btn {
  font-size: 26rpx;
  color: var(--brand-600);
  font-weight: 600;
  padding: 12rpx 20rpx;
  background: var(--brand-soft);
  border-radius: var(--radius-xs);
}
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}
.empty-icon { font-size: 96rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 34rpx; font-weight: 700; color: var(--ink-1); }
.empty-desc { font-size: 26rpx; color: var(--ink-3); margin-top: 12rpx; }

.meeting-card {
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 28rpx;
  border: 1px solid var(--line);
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.meeting-summary {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-2);
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.meeting-form-hero { display:flex; align-items:center; gap:20rpx; margin-bottom:22rpx; padding:28rpx; border-radius:24rpx; background:linear-gradient(135deg,#F3F2FF,#FAFAFF); }
.meeting-form-icon { display:flex; align-items:center; justify-content:center; flex:none; width:78rpx; height:78rpx; border-radius:24rpx; background:#fff; font-size:40rpx; box-shadow:0 4rpx 12rpx rgba(94,92,230,.10); }
.meeting-form-title { color:var(--ink-1); font-size:31rpx; font-weight:800; }.meeting-form-desc { margin-top:7rpx; color:var(--ink-3); font-size:23rpx; line-height:1.55; }
.meeting-form-card { margin-bottom:20rpx; padding:26rpx; border:1rpx solid var(--line); border-radius:22rpx; background:var(--surface); box-shadow:0 3rpx 12rpx rgba(17,17,26,.035); }
.step-head,.agenda-list-head { display:flex; align-items:center; justify-content:space-between; }.step-label { display:flex; align-items:center; gap:12rpx; margin-bottom:16rpx; color:var(--ink-1); font-size:28rpx; font-weight:750; }.step-label text { display:flex; align-items:center; justify-content:center; width:34rpx; height:34rpx; border-radius:50%; color:#fff; background:var(--brand); font-size:21rpx; }.step-help,.agenda-count { color:var(--ink-3); font-size:22rpx; }.agenda-tip { margin-top:18rpx; color:var(--ink-3); font-size:22rpx; line-height:1.55; }.agenda-list-head { margin:30rpx 6rpx 16rpx; }.agenda-list-head .step-label { margin:0; }.agenda-count { padding:5rpx 14rpx; border-radius:999rpx; background:var(--brand-soft); color:var(--brand-700); font-weight:650; }.meeting-create { margin-top:30rpx; }

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}
.field-input {
  display: block;
  width: 100%;
  min-height: 88rpx;
  line-height: 48rpx;
  background: var(--surface-2);
  border-radius: var(--radius-xs);
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: var(--ink-1);
  width: 100%;
  box-sizing: border-box;
}
.field-textarea {
  display: block;
  background: var(--surface-2);
  border-radius: var(--radius-xs);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink-1);
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  line-height: 1.55;
}

.template-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.template-chip {
  display:flex;
  align-items:center;
  gap:7rpx;
  font-size: 26rpx;
  color: var(--brand-700);
  background: var(--brand-soft);
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.template-plus { font-size:30rpx; font-weight:500; line-height:1; }

.topic-card {
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 26rpx;
  border: 1px solid var(--line);
  margin-bottom: 20rpx;
}
.topic-type {
  font-size: 22rpx;
  color: var(--brand-600);
  font-weight: 700;
  display:inline-flex;
  padding:5rpx 12rpx;
  border-radius:999rpx;
  background:var(--brand-soft);
  margin-bottom: 10rpx;
}
.topic-title {
  display: block;
  min-height: 72rpx;
  line-height: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-1);
  margin-bottom: 8rpx;
  width: 100%;
  box-sizing: border-box;
}
.topic-title-static {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-1);
  margin-bottom: 8rpx;
}
.topic-content {
  display: block;
  min-height: 76rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
  background: var(--surface-2);
  border-radius: var(--radius-xs);
  padding: 16rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.topic-input-sm {
  display: block;
  min-height: 76rpx;
  line-height: 40rpx;
  flex: 1;
  width: 0;
  min-width: 0;
  background: var(--surface-2);
  border-radius: var(--radius-xs);
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.topic-editor-row { align-items: flex-start; gap: 16rpx; }
.topic-editor-main { flex: 1; min-width: 0; }
.topic-target {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--c-habit-d);
  font-weight: 600;
}
.del-btn {
  flex:none;
  font-size: 23rpx;
  color: var(--c-heart-d);
  font-weight: 650;
  padding: 9rpx 14rpx;
  border-radius:12rpx;
  background:#FFF1F3;
}
