.record-page { min-height:100vh; box-sizing:border-box; padding:30rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background:#F6F6FA; }
.record-hero { padding:34rpx 32rpx; border-radius:28rpx; color:#fff; background:linear-gradient(135deg,#6E6CF0,#5E5CE6); box-shadow:0 12rpx 30rpx rgba(94,92,230,.2); }
.record-hero-label { font-size:24rpx; opacity:.82; }.record-streak { margin-top:6rpx; font-size:64rpx; font-weight:800; line-height:1.15; }.record-streak > text:first-child { margin-right:10rpx; font-size:43rpx; }.record-unit { margin-left:6rpx; font-size:26rpx; font-weight:600; }.record-hero-note { margin-top:16rpx; font-size:23rpx; opacity:.82; }
.record-card,.history-card { margin-top:22rpx; padding:28rpx; border:1rpx solid var(--line); border-radius:24rpx; background:#fff; box-shadow:0 4rpx 14rpx rgba(17,17,26,.04); }.record-card-head { display:flex; align-items:center; justify-content:space-between; }.record-title,.history-title { color:var(--ink-1); font-size:30rpx; font-weight:800; }.record-count { color:var(--ink-3); font-size:22rpx; }
.calendar { display:flex; justify-content:space-between; margin-top:28rpx; }.calendar-day { display:flex; flex-direction:column; align-items:center; min-width:72rpx; color:var(--ink-3); }.calendar-week { font-size:22rpx; }.calendar-dot { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; margin:12rpx 0 8rpx; border-radius:50%; background:#F1F1F5; color:#B8B8C2; font-size:29rpx; font-weight:700; }.calendar-dot.done { background:#EAF8F1; color:#16835A; }.calendar-day.today .calendar-dot { box-shadow:0 0 0 4rpx #EEEDFE; }.calendar-date { font-size:19rpx; white-space:nowrap; }.calendar-tip { margin-top:26rpx; color:var(--ink-3); font-size:21rpx; text-align:center; }.tip-dot { display:inline-block; width:12rpx; height:12rpx; margin:0 8rpx 0 18rpx; border-radius:50%; background:#F1F1F5; }.tip-dot.done { margin-left:0; background:#16835A; }
.history-title { margin:32rpx 4rpx 0; }.history-card { margin-top:16rpx; padding:0 28rpx; }.history-row { display:flex; align-items:center; justify-content:space-between; padding:24rpx 0; border-bottom:1rpx solid var(--sep); }.history-row:last-child { border-bottom:0; }.history-name { color:var(--ink-1); font-size:27rpx; font-weight:650; }.history-date { margin-top:7rpx; color:var(--ink-3); font-size:22rpx; }.history-points { color:#16835A; font-size:28rpx; font-weight:750; }.empty { margin-top:18rpx; padding:46rpx 26rpx; border-radius:22rpx; background:#fff; color:var(--ink-3); text-align:center; font-size:25rpx; }
