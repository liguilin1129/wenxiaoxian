<view class="record-page">
  <view class="record-hero">
    <view class="record-hero-label">当前连续打卡</view>
    <view class="record-streak"><text>🔥</text>{{streak}}<text class="record-unit"> 天</text></view>
    <view class="record-hero-note">坚持不是每天都完美，而是每次都愿意重新开始。</view>
  </view>

  <view class="record-card">
    <view class="record-card-head"><view class="record-title">打卡日历</view><view class="record-count">本月已打卡 {{monthCheckinDays}} 天</view></view>
    <view class="calendar-nav"><view bindtap="previousMonth" class="calendar-nav-btn">‹</view><view class="calendar-month">{{monthLabel}}</view><view bindtap="nextMonth" class="calendar-nav-btn">›</view></view>
    <view class="calendar-week-row"><text wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text></view>
    <view class="calendar-grid">
      <view wx:for="{{calendar}}" wx:key="key" class="calendar-cell {{item.empty ? 'empty' : ''}} {{item.today ? 'today' : ''}} {{item.future ? 'future' : ''}}">
        <view wx:if="{{!item.empty}}" class="calendar-date-circle {{item.done ? 'done' : ''}}"><text>{{item.day}}</text><text wx:if="{{item.done}}" class="calendar-check-badge">✓</text></view>
      </view>
    </view>
    <view class="calendar-summary"><view><text class="tip-dot done"></text>绿色日期表示已完成打卡</view><view>当前连续 <text>{{streak}}</text> 天</view></view>
  </view>

  <view class="history-title">打卡明细</view>
  <view class="history-card" wx:if="{{records.length}}">
    <view class="history-row" wx:for="{{records}}" wx:key="index">
      <view><view class="history-name">{{item.title}}</view><view class="history-date">{{item.date}} · {{item.dim}}</view></view>
      <view class="history-points">+{{item.delta}}</view>
    </view>
  </view>
  <view class="empty" wx:else>完成一次任务打卡后，这里会留下成长记录。</view>
</view>
