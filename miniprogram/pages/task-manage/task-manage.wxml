<view class="scr-head"><view class="greet">家长空间</view><view class="title">任务管理</view></view><view class="scr-body"><view class="card" style="display:flex;align-items:center;justify-content:space-between;background:#F5F4FF"><view><view class="h3">成长目标</view><view class="small">按阶段完成任务，逐步养成习惯</view></view><button class="btn soft" style="width:150rpx;margin:0;font-size:23rpx" bindtap="goGoals">去设置</button></view><view class="card"><view class="h3">创建任务</view><input placeholder="例如：饭后整理餐桌" value="{{name}}" data-key="name" bindinput="input"/><view class="row" style="margin-top:18rpx"><input style="flex:1" type="number" value="{{points}}" data-key="points" bindinput="input"/><text class="muted">积分</text></view><view class="chips" style="margin-top:18rpx"><text wx:for="{{dims}}" wx:key="key" class="pill {{dim===item.key?'pill-habit':''}}" data-key="{{item.key}}" bindtap="select">{{item.name}}</text></view><view class="h3" style="margin-top:24rpx">指派给</view><view class="chips"><text wx:for="{{members}}" wx:key="id" class="pill {{assignee===item.name?'pill-habit':''}}" data-name="{{item.name}}" bindtap="selectMember">{{item.name}}</text></view><view class="h3" style="margin-top:24rpx">完成方式</view><view class="chips"><text class="pill {{!requiresApproval?'pill-habit':''}}" data-value="auto" bindtap="setApproval">自动生效</text><text class="pill {{requiresApproval?'pill-habit':''}}" data-value="required" bindtap="setApproval">需要家长确认</text></view><view class="small" style="margin-top:10rpx">日常习惯建议自动生效；成果类或高积分任务建议家长确认。</view><view class="h3" style="margin-top:24rpx">执行周期</view><view class="chips"><text class="pill {{frequency==='once'?'pill-habit':''}}" data-key="once" bindtap="selectFrequency">仅今天</text><text class="pill {{frequency==='daily'?'pill-habit':''}}" data-key="daily" bindtap="selectFrequency">每日重复</text></view><view wx:if="{{frequency==='daily'}}" class="row between" style="margin-top:20rpx"><text class="muted">截止日期</text><picker mode="date" value="{{deadline}}" bindchange="date"><view>{{deadline}} ›</view></picker></view><button class="btn" style="margin-top:24rpx" bindtap="add">{{frequency==='daily'?'加入每日打卡':'加入孩子今日打卡'}}</button></view><view class="h3" style="margin-top:30rpx">已分配任务</view><view wx:for="{{list}}" wx:key="id" class="card row between"><view><view class="tn">{{item.name}}</view><view class="muted">{{item.assignee || '孩子'}} · {{item.points}} 分 · {{item.requiresApproval?'需家长确认':'自动生效'}} · {{item.frequency==='daily'?'每日重复':'仅今天'}}{{item.deadline?' · 至 '+item.deadline:''}}</view></view><text data-id="{{item.id}}" bindtap="remove" style="color:#E5484D">删除</text></view></view>
