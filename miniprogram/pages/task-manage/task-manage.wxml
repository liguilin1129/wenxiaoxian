<view class="scr-head"><view class="greet">家长空间</view><view class="title">任务管理</view></view><view class="scr-body"><view class="card"><view class="h3">创建今日任务</view><input placeholder="例如：饭后整理餐桌" value="{{name}}" data-key="name" bindinput="input"/><view class="row" style="margin-top:18rpx"><input style="flex:1" type="number" value="{{points}}" data-key="points" bindinput="input"/><text class="muted">积分</text></view><view class="chips" style="margin-top:18rpx"><text wx:for="{{dims}}" wx:key="key" class="pill {{dim===item.key?'pill-habit':''}}" data-key="{{item.key}}" bindtap="select">{{item.name}}</text></view><button class="btn" style="margin-top:24rpx" bindtap="add">加入孩子今日打卡</button></view><view class="h3" style="margin-top:30rpx">已分配任务</view><view wx:for="{{list}}" wx:key="id" class="card row between"><view><view class="tn">{{item.name}}</view><view class="muted">{{item.points}} 分 · 今日有效</view></view><text data-id="{{item.id}}" bindtap="remove" style="color:#E5484D">删除</text></view></view>
