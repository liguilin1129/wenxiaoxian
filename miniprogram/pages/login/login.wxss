.login-page {
  min-height: 100vh;
  background: #F5F5F7;
  padding: 64rpx 48rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  text-align: center;
  margin-bottom: 48rpx;
}
.logo {
  font-size: 96rpx;
  line-height: 1;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1F2937;
  margin-top: 20rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 12rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 30rpx rgba(17, 24, 39, 0.05);
}
.profile-row { display: flex; align-items: center; gap: 24rpx; margin-bottom: 34rpx; }
.avatar-picker {
  width: 112rpx; height: 112rpx; padding: 0; margin: 0;
  border-radius: 50%; overflow: hidden; background: var(--brand-soft);
  display: flex; align-items: center; justify-content: center;
}
.avatar-picker::after { border: none; }
.avatar-image { width: 112rpx; height: 112rpx; }
.avatar-placeholder { color: var(--brand-700); font-size: 26rpx; }
.profile-tip { color: var(--ink-3); font-size: 26rpx; }

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.avatars {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 22rpx;
}
.avatar-opt {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #374151;
  border: 3rpx solid transparent;
  transition: all .15s ease;
}
.avatar-opt.on {
  background: #EEEDFE;
  border-color: #6366F1;
  color: #4F46E5;
}

.nick-input {
  margin-top: 18rpx;
  height: 88rpx;
  background: #F3F4F6;
  border-radius: 18rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1F2937;
}
.ph {
  color: #9CA3AF;
}
.privacy-tip { margin-top: 22rpx; color: var(--ink-3); font-size: 22rpx; line-height: 1.6; }

.enter-btn {
  margin-top: 44rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: #6366F1;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(99, 102, 241, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.enter-btn::after { border: none; }
