.login-page {
  min-height: 100vh;
  padding: 76rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #F2F2F7;
  box-sizing: border-box;
}

.hero { text-align: center; margin-bottom: 54rpx; }
.brand-mark {
  width: 112rpx; height: 112rpx; margin: 0 auto 22rpx;
  border-radius: 34rpx; background: linear-gradient(145deg, #7472F5, #5E5CE6);
  position: relative; box-shadow: 0 12rpx 28rpx rgba(94, 92, 230, .22);
}
.brand-mark::before {
  content: ''; position: absolute; left: 53rpx; top: 27rpx; width: 6rpx; height: 58rpx;
  border-radius: 999rpx; background: #fff; transform: rotate(18deg);
}
.brand-leaf {
  position: absolute; left: 27rpx; top: 29rpx; width: 34rpx; height: 23rpx;
  border-radius: 34rpx 4rpx 34rpx 4rpx; background: #fff; transform: rotate(-31deg);
}
.hero-kicker { color: var(--brand); font-size: 24rpx; font-weight: 700; letter-spacing: 5rpx; margin-left: 5rpx; }
.hero-title { margin-top: 12rpx; color: #1C1C1E; font-size: 44rpx; font-weight: 800; letter-spacing: -1rpx; }
.hero-sub { margin-top: 12rpx; color: #8E8E93; font-size: 27rpx; }

.card {
  overflow: hidden; background: #fff; border-radius: 28rpx;
  box-shadow: 0 3rpx 14rpx rgba(0, 0, 0, .04);
}
.group-caption { padding: 22rpx 28rpx 8rpx; color: #8E8E93; font-size: 23rpx; }
.profile-row, .nickname-row { min-height: 116rpx; padding: 0 28rpx; display: flex; align-items: center; }
.avatar-picker {
  width: 76rpx; height: 76rpx; min-width: 76rpx; padding: 0; margin: 0 20rpx 0 0;
  overflow: hidden; border-radius: 50%; background: #ECECFF;
  display: flex; align-items: center; justify-content: center;
}
.avatar-picker::after { border: none; }
.avatar-image { width: 76rpx; height: 76rpx; }
.avatar-placeholder { color: var(--brand); font-size: 42rpx; font-weight: 300; line-height: 1; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name, .label { color: #1C1C1E; font-size: 30rpx; font-weight: 500; }
.profile-tip { margin-top: 5rpx; color: #8E8E93; font-size: 24rpx; }
.chevron { color: #C7C7CC; font-size: 42rpx; line-height: 1; font-weight: 300; }
.row-divider { height: 1rpx; margin-left: 124rpx; background: #E5E5EA; }
.nickname-row { gap: 34rpx; }
.nickname-row .label { white-space: nowrap; }
.nick-input { flex: 1; min-width: 0; height: 84rpx; text-align: right; color: #1C1C1E; font-size: 29rpx; }
.ph { color: #C7C7CC; }

.enter-btn {
  height: 96rpx; margin-top: 42rpx; border: none; border-radius: 24rpx;
  color: #fff; background: #5E5CE6; font-size: 32rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(94, 92, 230, .25);
}
.enter-btn::after { border: none; }
.enter-btn:active { opacity: .88; transform: scale(.985); }
.privacy-tip { margin: 24rpx 22rpx 0; text-align: center; color: #8E8E93; font-size: 22rpx; line-height: 1.7; }
