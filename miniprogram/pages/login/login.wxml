<view class="login-page">
  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="logo">🌱</view>
    <view class="hero-title">加入成长花园</view>
    <view class="hero-sub">填写资料，开启文小贤成长之旅</view>
  </view>

  <!-- 头像 -->
  <view class="igroup">
    <view class="igroup-title">头像</view>
    <view class="group-card">
      <button class="avatar-row" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="ava-big" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="ava-big ava-placeholder">{{nickname ? nickname.slice(0,1) : '贤'}}</view>
        <view class="change">选择微信头像</view>
      </button>
    </view>
  </view>

  <!-- 昵称 -->
  <view class="igroup">
    <view class="igroup-title">昵称</view>
    <view class="group-card">
      <view class="irow">
        <input
          class="nick-input"
          type="nickname"
          placeholder="填写或授权微信昵称"
          placeholder-class="ph"
          value="{{nickname}}"
          maxlength="32"
          bindinput="onNickname"
        />
      </view>
    </view>
  </view>

  <view class="privacy">
    登录后将使用头像和昵称创建账号，仅用于本小程序服务。
  </view>

  <!-- 底部登录按钮 -->
  <view class="bottom">
    <button class="enter-btn {{submitting ? 'dis' : ''}}" bindtap="onWechatLogin" loading="{{submitting}}" disabled="{{submitting}}">
      微信授权登录
    </button>
    <view class="sub">轻量登录，安全便捷</view>
  </view>
</view>
