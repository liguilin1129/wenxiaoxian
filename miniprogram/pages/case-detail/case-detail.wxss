.case-card {
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 28rpx;
  border: 1px solid var(--line);
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.case-header { display: flex; align-items: center; margin-bottom: 18rpx; }
.case-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-700);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700;
  flex: none; margin-right: 18rpx;
}
.case-nick { font-size: 30rpx; font-weight: 700; color: var(--ink-1); display: flex; align-items: center; gap: 10rpx; }
.case-selected-tag {
  font-size: 20rpx; color: #fff; background: var(--c-taste);
  padding: 2rpx 10rpx; border-radius: 6rpx; font-weight: 600;
}
.case-date { font-size: 24rpx; color: var(--ink-3); margin-top: 4rpx; }
.case-title { font-size: 36rpx; font-weight: 800; color: var(--ink-1); margin-bottom: 18rpx; line-height: 1.4; }
.case-content { font-size: 30rpx; color: var(--ink-2); line-height: 1.8; white-space: pre-wrap; }
.case-images { display: flex; gap: 12rpx; margin-top: 18rpx; flex-wrap: wrap; }
.case-img-wrap { position: relative; border-radius: var(--radius-xs); overflow: hidden; background: var(--surface-2); }
.case-img-count-1 { width: 100%; height: 320rpx; }
.case-img-count-2 { width: calc((100% - 12rpx) / 2); height: 240rpx; }
.case-img-count-3 { width: calc((100% - 24rpx) / 3); height: 200rpx; }
.case-img { width: 100%; height: 100%; }
.case-actions { display: flex; padding-top: 20rpx; border-top: 1rpx solid var(--line-2); }
.case-act {
  flex: 1; display: flex; align-items: center; justify-content: center;
  gap: 8rpx; font-size: 26rpx; color: var(--ink-3);
}
.case-act-icon { font-size: 30rpx; }
