/* 引导页 · 家庭会议 → 商议合约 → 签订 三步流程 */

/* 步骤指示条 */
.steps {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: .45;
}
.step.on { opacity: 1; }
.snum {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: var(--surface-2); color: var(--ink-3);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700;
  border: 2rpx solid var(--line);
}
.step.on .snum { background: var(--brand); color: #fff; border-color: var(--brand); }
.stxt { font-size: 22rpx; color: var(--ink-2); }
.step.on .stxt { color: var(--brand-700); font-weight: 600; }
.step-line {
  flex: 1; height: 2rpx; background: var(--line);
  margin: 0 12rpx; margin-bottom: 26rpx;
}

/* 步骤1 会议 */
.meet-hero {
  background: linear-gradient(135deg, #EEEDFE, #F5F3FF);
  border-radius: var(--radius);
  padding: 44rpx 32rpx;
  margin-bottom: 28rpx;
}
.meet-emoji { font-size: 96rpx; text-align: center; }

.card.flat.tip {
  background: var(--surface-2);
}
.tip-li { font-size: 26rpx; color: var(--ink-2); margin-top: 14rpx; }

/* 步骤2 条款 */
.clause { margin-bottom: 20rpx; }
.agree {
  font-size: 24rpx; font-weight: 700;
  padding: 10rpx 22rpx; border-radius: 999rpx;
  background: var(--surface-2); color: var(--ink-3);
  border: 2rpx solid var(--line);
  flex: none;
}
.agree.on { background: var(--brand-soft); color: var(--brand-700); border-color: var(--brand); }

.progress-tip {
  text-align: center; font-size: 24rpx;
  color: var(--ink-3); margin: 8rpx 0 4rpx;
}
.progress-tip.ok { color: var(--c-body-d); font-weight: 700; }

/* 步骤3 签订 */
.sign-hero {
  background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--radius); padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.scroll-emoji { font-size: 84rpx; text-align: center; }
.card.flat.summary { background: var(--surface-2); padding: 8rpx 28rpx; }
.sum-li {
  padding: 22rpx 0; border-bottom: 1rpx dashed var(--line);
}
.sum-li:last-child { border-bottom: none; }
.sign-note {
  font-size: 25rpx; color: var(--ink-2);
  background: var(--brand-soft); border-radius: var(--radius-xs);
  padding: 22rpx 24rpx; margin: 20rpx 0 8rpx; line-height: 1.6;
}

/* 文字按钮（返回） */
.btn.text {
  background: transparent; color: var(--ink-3);
  font-weight: 600; box-shadow: none;
}
