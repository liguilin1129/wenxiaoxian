<view class="scr-head">
  <view class="greet" style="color:{{meta.dark}};font-weight:600">{{meta.dimName}}</view>
  <view class="title">{{task.name}}</view>
</view>

<view class="scr-body">
  <view class="card">
    <view class="h3">设计目的</view>
    <view class="small">{{detail.purpose}}</view>
  </view>

  <view class="row" style="gap:20rpx;margin-bottom:24rpx">
    <view class="card" style="flex:1;margin:0">
      <view class="muted">内功类别</view>
      <view class="tn" style="font-size:28rpx;margin-top:8rpx">{{detail.neigong}}</view>
    </view>
    <view class="card" style="flex:1;margin:0">
      <view class="muted">对应经典</view>
      <view class="tn" style="font-size:28rpx;margin-top:8rpx">{{detail.classic}}</view>
    </view>
  </view>

  <view class="card">
    <view class="h3">奖励行为</view>
    <view wx:for="{{detail.rewards}}" wx:key="name" class="reward">
      <text>{{item.name}}</text><text class="pts-pos">+{{item.points}}</text>
    </view>
  </view>

  <view class="card">
    <view class="h3">培养推荐方式</view>
    <view class="small">{{detail.methods}}</view>
  </view>

  <button class="btn" style="margin-top:8rpx" bindtap="checkin">今日打卡 +{{maxPoints}}</button>
</view>

<ai-assistant />
