<view class="scr-head">
  <view class="greet" style="color:{{meta.dark}};font-weight:600">{{meta.dimName}}</view>
  <view class="title">{{task.name}}</view>
</view>

<view class="scr-body">
  <view class="card">
    <view class="h3">设计目的</view>
    <view class="small">{{detail.purpose}}</view>
  </view>

  <view class="row" style="gap:20rpx;margin-bottom:24rpx">
    <view class="card" style="flex:1;margin:0">
      <view class="muted">内功类别</view>
      <view class="tn" style="font-size:28rpx;margin-top:8rpx">{{detail.neigong}}</view>
    </view>
    <view class="card" style="flex:1;margin:0">
      <view class="muted">对应经典</view>
      <view class="tn" style="font-size:28rpx;margin-top:8rpx">{{detail.classic}}</view>
    </view>
  </view>

  <view class="card">
    <view class="h3">奖励行为</view>
    <view wx:for="{{detail.rewards}}" wx:key="name" class="reward">
      <text>{{item.name}}</text><text class="pts-pos">+{{item.points}}</text>
    </view>
  </view>

  <view class="card">
    <view class="h3">培养推荐方式</view>
    <view class="small">{{detail.methods}}</view>
  </view>

  <view class="card" wx:if="{{status === 'todo'}}">
    <view class="h3">完成小记 <text class="muted">可选</text></view>
    <textarea class="checkin-note" placeholder="例如：我完成了 20 分钟运动，今天感觉很有精神。" maxlength="80" value="{{note}}" bindinput="onNoteInput" />
    <view class="evidence-head"><text>打卡证明 <text class="muted">可选，最多 3 个</text></text><text bindtap="chooseEvidence">添加照片/视频</text></view>
    <view wx:if="{{evidence.length}}" class="evidence-list"><view wx:for="{{evidence}}" wx:key="path" class="evidence-item" data-index="{{index}}" bindtap="previewEvidence"><image wx:if="{{item.type === 'image'}}" src="{{item.path}}" mode="aspectFill"/><view wx:else class="video-evidence">▶</view><text catchtap="removeEvidence">×</text></view></view>
  </view>

  <button class="btn {{status === 'approved' ? 'btn-done' : ''}} {{status === 'pending' ? 'btn-pending' : ''}}" style="margin-top:8rpx" bindtap="checkin">
    <block wx:if="{{status === 'approved'}}">家长已确认 · +{{points}} 分</block>
    <block wx:elif="{{status === 'pending'}}">已提交，等待家长确认</block>
    <block wx:else>提交打卡，等待家长确认</block>
  </button>
</view>

<ai-assistant />
