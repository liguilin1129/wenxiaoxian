<view class="scr-head">
  <view class="greet">{{today}}</view>
  <view class="title">今日打卡</view>
</view>

<view class="scr-body">
  <view class="points-hero">
    <view class="lbl">今日已得</view>
    <view class="num">+{{gain}}</view>
    <view class="row between" style="margin-top:8rpx">
      <text class="lv">已完成 {{done}} / {{total}}</text>
      <text style="font-size:22rpx;opacity:.9">{{encouragement}}</text>
    </view>
    <view class="bar" style="margin-top:18rpx">
      <view class="fill" style="width:{{progressPct}}%"></view>
    </view>
  </view>

  <view wx:if="{{done === total && total > 0}}" class="all-done">
    ✨ 全部完成！好习惯正在悄悄长成 🌱
  </view>

  <view class="checkin-section" wx:if="{{pendingTasks.length}}">
    <view class="checkin-section-title">待完成 <text>{{pendingTasks.length}}</text></view>
  </view>
  <view wx:for="{{pendingTasks}}" wx:for-item="task" wx:key="id" class="task" data-index="{{task.index}}" bindtap="toggle">
    <view class="row between">
      <text class="tn">{{task.name}}</text>
      <view class="check"></view>
    </view>
    <view class="chips">
      <text class="pill pill-{{task.dim}}">{{dimName[task.dim]}}</text>
      <text class="pill">+{{task.points}}</text>
    </view>
  </view>

  <view class="checkin-section checkin-done-title" wx:if="{{completedTasks.length}}">
    <view class="checkin-section-title">已完成 <text>{{completedTasks.length}}</text></view>
  </view>
  <view wx:for="{{completedTasks}}" wx:for-item="task" wx:key="id" class="task checkin-completed" data-index="{{task.index}}" bindtap="toggle">
    <view class="row between">
      <text class="tn">{{task.name}}</text>
      <view class="check on">✓</view>
    </view>
    <view class="chips">
      <text class="pill pill-{{task.dim}}">{{dimName[task.dim]}}</text>
      <text class="pill">+{{task.points}}</text>
    </view>
  </view>
</view>

<ai-assistant />
