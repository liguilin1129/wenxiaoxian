.assessment-page { min-height:100vh; box-sizing:border-box; padding:32rpx 28rpx calc(52rpx + env(safe-area-inset-bottom)); background:#F6F6FA; }.assessment-hero { padding:18rpx 8rpx 28rpx; }.assessment-kicker { color:var(--brand); font-size:24rpx; font-weight:700; }.assessment-title { margin-top:8rpx; color:var(--ink-1); font-size:40rpx; font-weight:800; }.assessment-desc { margin-top:14rpx; color:var(--ink-3); font-size:24rpx; line-height:1.7; }.assessment-tip { margin-bottom:20rpx; padding:20rpx 22rpx; border-radius:18rpx; background:#EEEDFE; color:#5046B8; font-size:24rpx; }.question-card,.result-card { margin-bottom:20rpx; padding:28rpx; border:1rpx solid var(--line); border-radius:24rpx; background:#fff; box-shadow:0 4rpx 14rpx rgba(17,17,26,.04); }.question-title { color:var(--ink-1); font-size:29rpx; font-weight:700; line-height:1.55; }.question-title text { margin-right:10rpx; color:var(--brand); }.option { display:inline-flex; align-items:center; margin:22rpx 22rpx 0 0; color:var(--ink-2); font-size:25rpx; }.option radio { transform:scale(.8); margin-right:2rpx; }.assessment-submit { margin:32rpx 0 16rpx; border-radius:999rpx; background:var(--brand); color:#fff; font-size:29rpx; font-weight:700; }.result-card { text-align:center; padding:44rpx 30rpx; }.result-caption { color:var(--ink-3); font-size:25rpx; }.result-level { margin-top:10rpx; color:var(--brand); font-size:46rpx; font-weight:800; }.result-score { margin:20rpx auto; width:150rpx; height:150rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#EEEDFE; color:var(--brand); font-size:50rpx; font-weight:800; }.result-score text { margin-left:4rpx; font-size:23rpx; }.result-note { color:var(--ink-2); font-size:26rpx; line-height:1.65; }.result-dims { margin-top:30rpx; border-top:1rpx solid var(--sep); }.result-dim { display:flex; justify-content:space-between; padding:18rpx 0; border-bottom:1rpx solid var(--sep); color:var(--ink-2); font-size:26rpx; }.result-dim text:last-child { color:var(--brand); font-weight:700; }.result-insight { margin-top:26rpx; padding:18rpx; border-radius:16rpx; background:#F7F6FF; color:#5046B8; font-size:24rpx; }.result-disclaimer { margin-top:20rpx; color:var(--ink-3); font-size:21rpx; line-height:1.6; text-align:left; }.result-actions { display:flex; gap:18rpx; margin-top:28rpx; }.result-actions button { flex:1; border-radius:999rpx; font-size:26rpx; }.secondary { color:var(--brand); background:#EEEDFE; }.primary { color:#fff; background:var(--brand); }
.recommendation-head { display:flex; align-items:center; justify-content:space-between; margin:32rpx 8rpx 12rpx; }.recommendation-title { color:var(--ink-1); font-size:31rpx; font-weight:800; }.recommendation-head text { color:var(--brand); font-size:24rpx; }.recommendation-tip { margin:0 8rpx 18rpx; color:var(--ink-3); font-size:23rpx; line-height:1.6; }.recommendation-card { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin-bottom:16rpx; padding:24rpx; border:1rpx solid var(--line); border-radius:20rpx; background:#fff; }.recommendation-dim { color:var(--brand); font-size:22rpx; font-weight:700; }.recommendation-name { margin-top:6rpx; color:var(--ink-1); font-size:27rpx; font-weight:700; }.recommendation-meta { margin-top:8rpx; color:var(--ink-3); font-size:22rpx; }.recommendation-add { flex:none; min-width:104rpx; margin:0; padding:0 18rpx; border-radius:999rpx; background:#EEEDFE; color:var(--brand); font-size:24rpx; line-height:64rpx; }.recommendation-add.added { background:#EAF8F1; color:#16835A; }
.goal-entry{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:20rpx 0 0;padding:22rpx 24rpx;border-radius:20rpx;background:#F5F4FF;color:#5046B8;font-size:23rpx}.goal-entry-title{margin-bottom:7rpx;color:var(--ink-1);font-size:27rpx;font-weight:750}.goal-entry>text{font-size:36rpx}
.assessment-plan{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:20rpx;padding:24rpx;border-radius:20rpx;background:#EEEDFE;color:#5046B8;font-size:22rpx;line-height:1.55}.assessment-plan>view{flex:1;min-width:0}.assessment-plan-title{margin-bottom:7rpx;color:var(--ink-1);font-size:27rpx;font-weight:750}.assessment-plan-btn{flex:none;min-width:128rpx;margin:0;padding:0 16rpx;border-radius:999rpx;background:var(--brand);color:#fff;font-size:23rpx;line-height:64rpx}.assessment-plan-btn.created{background:#16835A}
.result-trend{display:flex;align-items:center;justify-content:space-between;margin-top:26rpx;padding:18rpx;border-radius:16rpx;background:#F7F6FF;color:var(--ink-2);font-size:23rpx;text-align:left}.trend-date{margin-left:10rpx;color:var(--ink-3);font-size:21rpx}.trend-value{font-size:30rpx;font-weight:800}.up{color:#16835A!important}.down{color:#D55A6A!important}.dim-delta{margin-left:12rpx;font-size:22rpx!important;font-weight:700}
