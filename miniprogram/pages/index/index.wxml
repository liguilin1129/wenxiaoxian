<view class="scr-head">
  <view class="home-nav">
    <view><view class="title">成长花园</view><view class="greet">{{dateText}}</view></view>
    <view class="search-trigger" bindtap="openSearch"><text>🔍</text><text>搜索</text></view>
  </view>

  <!-- 点击搜索后才展开输入区域，避免占用首页导航空间 -->
  <view wx:if="{{searchOpen}}" class="search-drawer">
    <view class="search-bar">
    <text class="search-ic">🔍</text>
    <input
      class="search-input"
      placeholder="搜索任务 / 经典 / 商城 / 文章"
      placeholder-class="search-ph"
      value="{{searchKey}}"
      bindinput="onSearchInput"
      confirm-type="search"
      focus="{{searchOpen}}"
    />
    <text wx:if="{{searchKey}}" class="search-clear" bindtap="clearSearch">✕</text>
    <text class="search-close" bindtap="closeSearch">取消</text>
    </view>

  <!-- 实时搜索结果 -->
  <view wx:if="{{searchKey}}" class="search-panel">
    <block wx:if="{{searchResults.length}}">
      <view
        wx:for="{{searchResults}}"
        wx:key="key"
        class="search-item"
        data-url="{{item.url}}"
        bindtap="goSearchItem"
      >
        <text class="search-item-ic">{{item.icon}}</text>
        <view class="flex1">
          <view class="search-item-name">{{item.name}}</view>
          <view class="search-item-sub">{{item.sub}}</view>
        </view>
        <text class="search-item-tag">{{item.type}}</text>
      </view>
    </block>
    <view wx:else class="search-empty">未找到相关内容</view>
  </view>
  </view>
</view>

<view class="scr-body">
  <!-- 未登录：游客态（无用户信息） -->
  <block wx:if="{{!signed}}">
    <view class="guest-hero">
      <view class="guest-emoji">🌱</view>
      <view class="guest-title">和孩子一起，种下成长的种子</view>
      <view class="guest-desc">登录后开启积分成长、任务打卡、家庭会议与更多功能</view>
      <button class="btn" style="margin-top:32rpx" bindtap="goLogin">登录 · 开启成长花园</button>
    </view>

    <view class="igroup">
      <view class="ghead">
        <view class="ghead-left"><view class="ghead-bar"></view><view class="ghead-title">功能介绍</view></view>
      </view>
      <view class="igroup-card">
        <view class="irow" wx:for="{{guestFeats}}" wx:key="name">
          <view class="ic">{{item.icon}}</view>
          <view class="tx">
            <view class="tn" style="font-size:28rpx">{{item.name}}</view>
            <view class="muted" style="margin-top:4rpx">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 已登录：正常内容（iOS 分组列表） -->
  <block wx:else>
    <!-- 成长仪表盘：将等级、升级进度与当日目标放在首屏 -->
    <view class="growth-dashboard tap" bindtap="goPoints">
      <view class="growth-top">
        <view class="growth-person">
          <view class="avatar">{{child.avatar}}</view>
          <view>
            <view class="growth-level">Lv.{{child.levelNum}} · {{child.levelName}}</view>
            <view class="growth-sub">{{child.name}}的成长记录</view>
          </view>
        </view>
        <view class="growth-points"><text>{{child.points}}</text><text class="growth-points-unit">分</text></view>
      </view>
      <view class="growth-progress-label">
        <text>距离 Lv.{{nextLevel}} 还差 {{need}} 分</text>
        <text>{{levelPct}}%</text>
      </view>
      <view class="growth-progress"><view class="growth-progress-fill" style="width:{{levelPct}}%"></view></view>
      <view class="growth-metrics">
        <view><text class="growth-metric-num">{{doneCount}}/{{total}}</text><text class="growth-metric-label">今日打卡</text></view>
        <view><text class="growth-metric-num">{{child.streak}} 天</text><text class="growth-metric-label">连续坚持</text></view>
        <view><text class="growth-metric-num">+{{child.weekGain}}</text><text class="growth-metric-label">本周积分</text></view>
      </view>
    </view>

    <!-- 荣誉墙 -->
    <view class="igroup">
      <view class="ghead">
        <view class="ghead-left"><view class="ghead-bar"></view><view class="ghead-title">荣誉墙</view></view>
        <view class="ghead-more" bindtap="goBadges">全部勋章 <text class="chev">›</text></view>
      </view>
      <view class="igroup-card">
        <view class="badge-user">
          <view class="avatar">{{child.avatar}}</view>
          <view class="top-bar-info">
            <view class="top-bar-name">{{child.name}}</view>
            <view class="top-bar-sub">积分 {{child.points}} · 已点亮 {{badgeGot}}/{{badgeTotal}}</view>
          </view>
        </view>
        <view class="badge-grid">
          <view wx:for="{{badges}}" wx:key="id" class="badge {{item.got ? '' : 'off'}}">
            <view class="badge-ic">{{item.got ? item.icon : '🔒'}}</view>
            <view class="badge-name">{{item.name}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="igroup">
      <view class="ghead">
        <view class="ghead-left"><view class="ghead-bar"></view><view class="ghead-title">快捷入口</view></view>
      </view>
      <view class="igroup-card quick-grid">
        <view
          class="quick-item"
          wx:for="{{quickEntries}}"
          wx:key="name"
          data-url="{{item.url}}"
          data-tab="{{item.tab}}"
          bindtap="goQuick"
        >
          <view class="quick-ic quick-ic-{{index}}"><view class="quick-symbol"></view></view>
          <view class="quick-name">{{item.name}}</view>
        </view>
      </view>
    </view>

    <!-- 智能提醒 -->
    <view class="igroup" wx:if="{{reminders.length}}">
      <view class="ghead">
        <view class="ghead-left"><view class="ghead-bar"></view><view class="ghead-title">智能提醒</view></view>
        <view class="ghead-more" bindtap="goReminders">全部提醒 <text class="chev">›</text></view>
      </view>
      <view class="igroup-card">
        <view class="reminder-item" wx:for="{{reminders}}" wx:key="text">
          <text class="reminder-ic">{{item.icon}}</text>
          <text class="reminder-txt">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 今日概览 -->
    <view class="igroup">
      <view class="ghead">
        <view class="ghead-left"><view class="ghead-bar"></view><view class="ghead-title">今日概览</view></view>
        <view class="ghead-more" bindtap="goCheckin">查看全部 <text class="chev">›</text></view>
      </view>
      <view class="igroup-card ov-card">
        <view class="ov-body">
          <view class="ring" style="background: conic-gradient(var(--brand) {{ovPct}}%, var(--line) 0)">
            <view class="ring-inner">
              <view class="ring-pct">{{ovPct}}%</view>
              <view class="ring-sub">今日完成</view>
            </view>
          </view>
          <view class="ov-stats">
            <view class="ov-stat">
              <view class="ov-stat-num">{{doneCount}}<text class="ov-stat-unit">/{{total}}</text></view>
              <view class="ov-stat-label">任务打卡</view>
            </view>
            <view class="ov-stat">
              <view class="ov-stat-num">🔥 {{child.streak}}</view>
              <view class="ov-stat-label">连续打卡(天)</view>
            </view>
            <view class="ov-stat">
              <view class="ov-stat-num">+{{child.weekGain}}</view>
              <view class="ov-stat-label">本周积分</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 四维成长 -->
    <view class="igroup">
      <view class="ghead">
        <view class="ghead-left"><view class="ghead-bar"></view><view class="ghead-title">四维成长</view></view>
        <view class="ghead-more" bindtap="goReport">成长报告 <text class="chev">›</text></view>
      </view>
      <view class="igroup-card">
        <view class="irow" wx:for="{{dims}}" wx:key="key" bindtap="goReport">
          <text class="dot" style="background:{{item.color}}"></text>
          <view class="tx" style="margin-left:14rpx">{{item.name}}</view>
          <view class="rt">{{item.pct}}%</view>
          <text class="chev">›</text>
        </view>
      </view>
    </view>

    <!-- 今日待打卡 -->
    <view class="igroup">
      <view class="ghead">
        <view class="ghead-left"><view class="ghead-bar"></view><view class="ghead-title">今日待打卡</view></view>
        <view class="ghead-more" bindtap="goTasks">任务中心 <text class="chev">›</text></view>
      </view>
      <view class="igroup-card">
        <view class="irow" wx:for="{{today}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleToday">
          <view class="check {{item.done ? 'on' : ''}}">{{item.done ? '✓' : ''}}</view>
          <view class="tx" style="margin-left:18rpx">{{item.name}}</view>
          <text class="pill pill-{{item.dim}}" style="margin-left:auto">{{dimName[item.dim]}} +{{item.points}}</text>
        </view>
      </view>
    </view>

    <!-- 经典今日推荐 -->
    <view class="igroup">
      <view class="ghead">
        <view class="ghead-left"><view class="ghead-bar"></view><view class="ghead-title">经典今日推荐</view></view>
        <view class="ghead-more" bindtap="goClassics">全部经典 <text class="chev">›</text></view>
      </view>
      <view class="igroup-card tap classic-today-card" bindtap="goClassics">
        <view class="row between classic-today-row">
          <view class="classic-today-copy">
            <view class="classic-today-title">《{{classicToday.name}}》</view>
            <view class="classic-today-sub">已读 {{classicToday.read}} / {{classicToday.total}} 章 · 继续诵读</view>
          </view>
          <text class="btn sm classic-read-btn">诵读</text>
        </view>
      </view>
    </view>
  </block>
</view>

<ai-assistant id="aiAssistant" />
