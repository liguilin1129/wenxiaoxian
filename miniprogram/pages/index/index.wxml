<view class="home-page">
  <view class="home-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="home-nav-row" style="height:{{navHeight}}px">
      <view class="search-button" bindtap="openSearch" aria-label="搜索"><view class="search-glyph"></view></view>
    </view>
  </view>
  <view style="height:{{statusBarHeight + navHeight}}px"></view>
  <swiper class="home-banner" autoplay="{{true}}" circular="{{true}}" interval="5000" duration="450" indicator-dots="{{true}}" indicator-color="rgba(94,92,230,.2)" indicator-active-color="#5E5CE6">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image wx:if="{{item.image}}" class="banner-image" src="{{item.image}}" mode="aspectFill"/>
      <view wx:else class="banner-placeholder banner-{{item.tone}}"><view class="banner-content"><view class="banner-label">{{item.label}}</view><view class="banner-title">{{item.title}}</view><view class="banner-sub">{{item.sub}}</view></view><view class="banner-art"><view class="art-orbit"></view><view class="art-leaf"></view><view class="art-seed"></view></view></view>
    </swiper-item>
  </swiper>
  <view class="home-content">
    <view wx:if="{{signed}}" class="profile-strip">
      <view class="profile-main" bindtap="goProfileDetail"><image wx:if="{{child.avatarUrl}}" class="home-avatar" src="{{child.avatarUrl}}" mode="aspectFill"/><view wx:else class="home-avatar">{{child.avatar}}</view><view class="profile-copy"><view class="home-name">{{child.name}}</view><view class="home-level">Lv.{{child.levelNum}} · {{child.levelName}}</view></view></view>
      <view class="profile-honors" bindtap="goBadges"><view class="honors-label">荣誉勋章 <text>›</text></view><view class="honors-row"><view wx:for="{{badges}}" wx:key="id" class="honor-symbol {{item.got ? '' : 'locked'}}" aria-label="{{item.name}}">{{item.got ? item.icon : '🔒'}}</view></view></view>
    </view>
    <view wx:else class="profile-strip guest-strip" bindtap="goLogin"><view class="home-avatar">芽</view><view class="profile-copy"><view class="home-name">开启你的成长之旅</view><view class="home-level">登录，记录每一次进步</view></view><text class="guest-arrow">›</text></view>
    <view class="quick-card"><view wx:for="{{quickEntries}}" wx:key="key" class="quick-entry" data-key="{{item.key}}" bindtap="goQuick"><view class="entry-icon entry-{{item.key}}"><view class="entry-symbol"></view></view><view class="entry-name">{{item.name}}</view></view></view>
    <view class="todo-card"><view class="todo-head"><view><view class="todo-title">今日待办</view><view wx:if="{{signed}}" class="todo-summary">已完成 {{doneCount}} / {{total}} 项{{remaining ? '，继续加油' : ''}}</view></view><text class="todo-more" bindtap="goTasks">全部任务 ›</text></view>
      <block wx:if="{{signed}}">
        <view wx:for="{{today}}" wx:key="id" class="todo-row"><view class="todo-copy"><view class="todo-name">{{item.name}}</view><view class="todo-meta"><text>{{item.dimensionName}}</text><text class="todo-points">+{{item.points}} 分</text></view></view><button class="todo-action {{item.done || item.pending ? 'inactive' : ''}}" disabled="{{item.done || item.pending}}" data-id="{{item.id}}" bindtap="toggleToday">{{item.done ? '已完成' : item.pending ? '待确认' : item.requiresApproval ? '提交' : '打卡'}}</button></view>
        <view wx:if="{{!today.length}}" class="todo-empty">今天暂无任务，去任务中心看看吧。</view>
        <view wx:if="{{total && !remaining}}" class="todo-complete">今天的任务全部完成了，每一点坚持都算数。</view>
        <view wx:if="{{total > 4}}" class="todo-footer" bindtap="goTasks">查看全部 {{total}} 项任务 ›</view>
      </block>
      <view wx:else class="todo-empty"><view>登录后查看今天的任务</view><button class="todo-action" bindtap="goLogin">去登录</button></view>
    </view>
  </view>
</view>
<ai-assistant id="aiAssistant" tab-mode="{{true}}" />
