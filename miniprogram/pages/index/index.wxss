/* 首页样式主要复用 app.wxss 设计系统 */

/* 未登录游客态 */
.guest-hero {
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  border-radius: var(--radius);
  padding: 56rpx 40rpx;
  color: #fff;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(17, 17, 26, .08);
}
.guest-emoji { font-size: 96rpx; }
.guest-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-top: 20rpx;
  letter-spacing: -1rpx;
}
.guest-desc {
  font-size: 26rpx;
  opacity: .85;
  margin-top: 12rpx;
  line-height: 1.6;
}
.guest-feat {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.guest-feat-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex: none;
}
