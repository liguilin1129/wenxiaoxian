/* 首页样式主要复用 app.wxss 设计系统 */

/* 顶栏右侧：搜索 + 设置 + 头像 */
.head-right { display: flex; align-items: center; gap: 18rpx; }
.head-ic {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--surface); border: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}

/* 快捷入口宫格 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 12rpx;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 28rpx 16rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.quick-item { display: flex; flex-direction: column; align-items: center; }
.quick-ic {
  width: 88rpx; height: 88rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.quick-name {
  margin-top: 12rpx; font-size: 22rpx; color: var(--ink-2);
  text-align: center;
}

/* 智能提醒 */
.reminder {
  background: linear-gradient(135deg, #FFF7E6, #FFFBEB);
  border: 1px solid #FDE68A;
  border-radius: var(--radius-sm);
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
}
.reminder-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.reminder-title { font-size: 28rpx; font-weight: 700; color: #B7791F; }
.reminder-count { font-size: 22rpx; color: #B7791F; opacity: .8; }
.reminder-item { display: flex; align-items: center; gap: 14rpx; padding: 8rpx 0; }
.reminder-ic { font-size: 30rpx; }
.reminder-txt { font-size: 26rpx; color: var(--ink-2); }

/* 今日概览 */
.ov-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 28rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.ov-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.ov-body { display: flex; align-items: center; gap: 28rpx; }
.ring {
  width: 150rpx; height: 150rpx; border-radius: 50%;
  flex: none; display: flex; align-items: center; justify-content: center;
}
.ring-inner {
  width: 116rpx; height: 116rpx; border-radius: 50%;
  background: var(--surface);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ring-pct { font-size: 38rpx; font-weight: 800; color: var(--brand-700); line-height: 1; }
.ring-sub { font-size: 20rpx; color: var(--ink-3); margin-top: 4rpx; }
.ov-stats { flex: 1; display: flex; flex-direction: column; gap: 16rpx; }
.ov-stat { display: flex; align-items: baseline; justify-content: space-between; }
.ov-stat-num { font-size: 30rpx; font-weight: 700; color: var(--ink-1); }
.ov-stat-unit { font-size: 24rpx; color: var(--ink-3); font-weight: 600; }
.ov-stat-label { font-size: 24rpx; color: var(--ink-3); }

/* 未登录游客态 */
.guest-hero {
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  border-radius: var(--radius);
  padding: 56rpx 40rpx;
  color: #fff;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(17, 17, 26, .08);
}
.guest-emoji { font-size: 96rpx; }
.guest-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-top: 20rpx;
  letter-spacing: -1rpx;
}
.guest-desc {
  font-size: 26rpx;
  opacity: .85;
  margin-top: 12rpx;
  line-height: 1.6;
}
.guest-feat {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 17, 26, .04);
}
.guest-feat-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex: none;
}
