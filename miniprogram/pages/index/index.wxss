/* 首页独立布局，保留全局品牌色与既有底部导航。 */
.home-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.home-nav { position:fixed; top:0; left:0; right:0; z-index:20; padding-left:28rpx; background:rgba(248,248,253,.96); box-sizing:border-box; }
.home-nav-row { display:flex; align-items:center; justify-content:flex-end; }
.search-button { flex:none; display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; border-radius:50%; background:#fff; }
.search-glyph { width:25rpx; height:25rpx; border:3rpx solid var(--ink-2); border-radius:50%; position:relative; }
.search-glyph::after { content:''; position:absolute; width:12rpx; height:3rpx; background:var(--ink-2); transform:rotate(45deg); right:-9rpx; bottom:-4rpx; }
.home-banner { height:380rpx; width:100%; }
.banner-image, .banner-placeholder { width:100%; height:100%; }
.banner-placeholder { position:relative; overflow:hidden; padding:56rpx 36rpx 66rpx; }
.banner-violet { background:linear-gradient(125deg,#f1eeff,#e5dfff); }
.banner-mint { background:linear-gradient(125deg,#edf9f6,#d6efe9); }
.banner-peach { background:linear-gradient(125deg,#fff4ed,#fae5d6); }
.banner-content { position:relative; z-index:2; width:65%; }
.banner-label { font-size:21rpx; color:#66628e; letter-spacing:3rpx; }
.banner-title { margin-top:18rpx; font-size:42rpx; font-weight:800; color:#34305a; line-height:1.3; }
.banner-sub { font-size:20rpx; color:#817b9d; margin-top:20rpx; }
.banner-art { position:absolute; width:250rpx; height:250rpx; right:-20rpx; bottom:38rpx; }
.art-orbit { width:220rpx; height:220rpx; border-radius:50%; border:2rpx solid rgba(255,255,255,.8); background:rgba(255,255,255,.3); }
.art-leaf { position:absolute; width:85rpx; height:135rpx; background:linear-gradient(135deg,#b2a9ee,#6e64c9); border-radius:90rpx 0 90rpx 0; left:75rpx; top:35rpx; transform:rotate(20deg); }
.art-seed { position:absolute; width:58rpx; height:58rpx; border-radius:50%; background:#fff; left:53rpx; bottom:12rpx; box-shadow:0 12rpx 25rpx rgba(85,72,142,.12); }
.home-content { padding:0 28rpx; position:relative; margin-top:-6rpx; z-index:2; }
.profile-strip { background:#34304f; color:#fff; border-radius:24rpx 24rpx 0 0; padding:24rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.profile-main { display:flex; align-items:center; gap:14rpx; min-width:0; flex:1; }
.home-avatar { width:70rpx; height:70rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#8c83d8; color:#fff; font-size:30rpx; font-weight:700; }
.profile-copy { min-width:0; flex:1; }
.home-name { font-size:29rpx; font-weight:700; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.home-level { font-size:20rpx; color:#d0cae8; margin-top:4rpx; }
.profile-honors { flex:none; }
.honors-label { font-size:18rpx; color:#d0cae8; display:flex; justify-content:space-between; }
.honors-row { display:flex; gap:6rpx; margin-top:8rpx; }
.honor-symbol { width:36rpx; height:36rpx; display:flex; align-items:center; justify-content:center; font-size:23rpx; border-radius:10rpx; background:rgba(255,255,255,.12); }
.honor-symbol.locked { filter:grayscale(1); opacity:.45; }
.guest-strip { gap:16rpx; }.guest-arrow { font-size:36rpx; }
.quick-card { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); padding:30rpx 8rpx; background:#fff; border-radius:0 0 24rpx 24rpx; box-shadow:var(--shadow-soft); }
.quick-entry { min-width:0; display:flex; flex-direction:column; align-items:center; text-align:center; }
.entry-icon { width:86rpx; height:86rpx; border-radius:25rpx; background:var(--brand-soft); display:flex; align-items:center; justify-content:center; color:var(--brand); }
.entry-family { background:#fff0e2; color:#b48353; }.entry-bank { background:#e8f4ed; color:#489775; }.entry-learn { background:#eaf0ff; color:#6482cc; }
.entry-symbol { width:34rpx; height:38rpx; position:relative; border:3rpx solid currentColor; border-radius:7rpx; }
.entry-symbol::before,.entry-symbol::after { content:''; position:absolute; }
.entry-tasks .entry-symbol::before { width:16rpx; height:3rpx; background:currentColor; left:6rpx; top:10rpx; box-shadow:0 10rpx 0 currentColor; }
.entry-family .entry-symbol { width:36rpx; height:26rpx; margin-top:12rpx; }
.entry-family .entry-symbol::before { width:25rpx; height:25rpx; border-left:3rpx solid currentColor; border-top:3rpx solid currentColor; transform:rotate(45deg); top:-17rpx; left:3rpx; }
.entry-bank .entry-symbol { border:0; border-bottom:3rpx solid currentColor; border-radius:0; width:40rpx; }
.entry-bank .entry-symbol::before { left:3rpx; top:8rpx; height:22rpx; width:4rpx; background:currentColor; box-shadow:14rpx 0 0 currentColor,28rpx 0 0 currentColor; }
.entry-bank .entry-symbol::after { width:28rpx; height:15rpx; border-left:3rpx solid currentColor; border-top:3rpx solid currentColor; left:5rpx; top:-6rpx; transform:rotate(45deg) skew(-10deg,-10deg); }
.entry-learn .entry-symbol { width:40rpx; border-radius:4rpx 9rpx 9rpx 4rpx; }
.entry-learn .entry-symbol::before { height:31rpx; left:16rpx; top:0; border-left:3rpx solid currentColor; }
.entry-name { margin-top:16rpx; font-size:24rpx; font-weight:700; color:var(--ink-1); white-space:nowrap; }
.todo-card { margin-top:24rpx; padding:26rpx 24rpx 8rpx; background:#fff; border-radius:24rpx; box-shadow:var(--shadow-soft); }
.todo-head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding-bottom:18rpx; }
.todo-title { font-size:33rpx; font-weight:750; }
.todo-summary { margin-top:5rpx; font-size:22rpx; color:var(--ink-3); }
.todo-more { flex:none; color:var(--ink-3); font-size:22rpx; }
.todo-row { display:flex; align-items:center; gap:20rpx; padding:24rpx 0; border-top:1rpx solid var(--sep); }
.todo-copy { flex:1; min-width:0; }.todo-name { font-size:28rpx; font-weight:600; overflow-wrap:break-word; }
.todo-meta { display:flex; gap:16rpx; margin-top:8rpx; font-size:21rpx; color:var(--ink-3); }.todo-points { color:var(--brand); }
button.todo-action { flex:none; margin:0; min-width:110rpx; padding:12rpx 22rpx; line-height:1.5; border-radius:999rpx; background:var(--brand); color:#fff; font-size:24rpx; font-weight:650; }
button.todo-action.inactive { background:#f0eef8; color:#9792ac; }
.todo-empty { padding:36rpx 0; text-align:center; color:var(--ink-3); font-size:26rpx; }.todo-empty button { margin:22rpx auto 0; }
.todo-footer,.todo-complete { text-align:center; padding:20rpx 0; font-size:23rpx; color:var(--brand); border-top:1rpx solid var(--sep); }
