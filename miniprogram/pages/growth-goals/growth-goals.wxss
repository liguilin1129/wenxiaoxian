.intro .small{margin-top:10rpx;line-height:1.65}.member-select{display:flex;align-items:center;gap:18rpx;margin-top:24rpx;color:var(--ink-2);font-size:24rpx}.member-select .chips{flex:1}.section-title{margin:30rpx 6rpx 14rpx;color:var(--ink-1);font-size:30rpx;font-weight:800}.goal{margin-bottom:16rpx}.goal-head,.template{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.goal-name,.template-name{color:var(--ink-1);font-size:28rpx;font-weight:750}.goal-status{padding:7rpx 12rpx;border-radius:999rpx;background:#EEEDFE;color:var(--brand);font-size:21rpx}.goal-status.done{background:#EAF8F1;color:#16835A}.stage{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid var(--sep)}.stage-name{margin-bottom:7rpx;color:var(--ink-2);font-size:26rpx}.progress{height:12rpx;overflow:hidden;margin-top:15rpx;border-radius:99rpx;background:var(--surface-2)}.progress view{height:100%;border-radius:inherit;background:var(--brand)}.goal-complete{margin-top:18rpx;color:#16835A;font-size:24rpx}.template{margin-bottom:14rpx;padding:24rpx}.template>view{flex:1;min-width:0}.template-desc{margin-top:8rpx;color:var(--ink-3);font-size:23rpx;line-height:1.5}.template-stage{margin-top:10rpx;color:var(--brand);font-size:22rpx}.template .btn{flex:none;width:98rpx;margin:0;font-size:23rpx;line-height:62rpx}.bottom-tip{margin:28rpx 12rpx 18rpx;color:var(--ink-3);font-size:22rpx;line-height:1.6;text-align:center}
.recommended{display:inline-block;margin-left:10rpx;padding:3rpx 8rpx;border-radius:999rpx;background:#EEEDFE;color:var(--brand);font-size:19rpx;font-weight:600;vertical-align:2rpx}
