<view class="scr-head">
  <view class="greet">本周综评</view>
  <view class="title">成长报告</view>
</view>

<view class="scr-body">
  <view class="report-hero">
    <view class="report-hero-top"><view><view class="report-hero-label">当前成长积分</view><view class="report-hero-points">{{points}} <text>分</text></view></view><view class="report-streak">🔥 {{streak}}<text>天连续打卡</text></view></view>
    <view class="report-progress-label"><text>今日任务完成</text><text>{{done}} / {{total}} · {{completionPct}}%</text></view><view class="report-progress"><view style="width:{{completionPct}}%"></view></view>
  </view>

  <view class="report-metrics"><view><text>+{{weekGain}}</text><text>本周积分</text></view><view><text>{{recordCount}}</text><text>积分记录</text></view><view><text>+{{earned}}</text><text>累计获得</text></view></view>

  <view class="card" wx:if="{{assessment}}"><view class="h3">成长评分</view><view class="assessment-summary"><view><view class="assessment-level">{{assessment.levelName}}</view><view class="small">第 {{assessmentTrend.count}} 次评估 · {{assessment.completedAt}}</view></view><view class="assessment-score">{{assessment.overall}}</view></view><view class="small">优势：{{assessment.strength.name}} · 当前可优先练习：{{assessment.focus.name}}</view><view wx:if="{{assessmentTrend.previous}}" class="report-trend"><view><view class="trend-title">较上次评估</view><view class="small">综合评分变化</view></view><text class="trend-number {{assessmentTrend.overallDelta > 0 ? 'up' : assessmentTrend.overallDelta < 0 ? 'down' : ''}}">{{assessmentTrend.overallDelta > 0 ? '+' : ''}}{{assessmentTrend.overallDelta}} 分</text></view><view wx:if="{{assessmentTrend.previous}}" class="trend-dim-list"><view wx:for="{{assessmentTrend.dimensions}}" wx:key="key"><text>{{item.name}}</text><text class="{{item.delta > 0 ? 'up' : item.delta < 0 ? 'down' : ''}}">{{item.delta > 0 ? '+' : ''}}{{item.delta}} 分</text></view></view><view class="assessment-history"><view class="history-title">最近评估记录</view><view wx:for="{{assessmentHistory}}" wx:key="id" class="history-row"><text>{{item.completedAt}}</text><text>{{item.levelName}} · {{item.overall}} 分</text></view></view></view>
  <view class="card" wx:else><view class="h3">成长初评</view><view class="small">完成家长问卷后，可生成四维成长起点和等级建议。</view></view>

  <view class="card body-card"><view class="card-head"><view class="h3">身体成长记录</view><text bindtap="goProfileEdit">去填写 ›</text></view><view class="body-metrics"><view><text>{{body.height}}</text><text>身高（cm）</text></view><view><text>{{body.weight}}</text><text>体重（kg）</text></view><view><text>{{body.bmi}}</text><text>BMI · 仅供记录</text></view></view><view wx:if="{{!hasBodyData}}" class="small body-tip">填写身高和体重后，报告会自动汇总身体成长记录。</view></view>

  <view class="card">
    <view class="h3">四维表现</view>
    <view wx:for="{{dims}}" wx:key="key" class="rep-bar">
      <view class="rl"><text>{{item.name}}</text><text style="color:{{item.dark}};font-weight:700">{{item.pct}}% · {{item.score || 0}} 成长值</text></view>
      <view class="bar"><view class="fill" style="width:{{item.pct}}%;background:{{item.color}}"></view></view>
    </view>
  </view>

  <view class="card"><view class="h3">积分规则</view><view wx:for="{{rules}}" wx:key="key" class="rule-row"><view><view class="rule-name">{{item.name}} <text>{{item.weight}}</text></view><view class="small">{{item.tip}}</view></view><text class="rule-arrow">›</text></view></view>

  <view class="card report-observation">
    <view class="h3">本周观察</view>
    <view class="observation-row"><view class="observation-icon good">★</view><view><view class="observation-title">表现亮点 · {{strength.name}}</view><view class="small">当前综合表现 {{strength.pct}}%，继续保持稳定节奏。</view></view></view>
    <view class="observation-row"><view class="observation-icon focus">◎</view><view><view class="observation-title">成长重点 · {{focus.name}}</view><view class="small">当前综合表现 {{focus.pct}}%，{{suggestion}}</view></view></view>
  </view>

  <view class="card action-card"><view class="h3">下一步行动</view><view class="action-row" bindtap="goCheckin"><view><view class="action-title">完成今日任务</view><view class="small">当前 {{done}} / {{total}} 项已完成，保持连续打卡节奏。</view></view><text>›</text></view><view class="action-row" bindtap="goAssessment"><view><view class="action-title">复盘成长初评</view><view class="small">围绕“{{focus.name}}”安排一项容易坚持的小目标。</view></view><text>›</text></view></view>

  <view class="card archive-card"><view><view class="h3">成长档案</view><view class="small">把当前报告保存为本地阶段快照，方便之后对比。</view></view><view class="archive-actions"><button class="btn soft" bindtap="goArchive">查看档案</button><button class="btn" bindtap="saveArchive">存入档案</button></view></view>

  <view class="card">
    <view class="h3">五类内功</view>
    <view wx:for="{{neigong}}" wx:key="name" class="rep-bar">
      <view class="rl"><text>{{item.name}}</text><text style="font-weight:700">{{item.pct}}</text></view>
      <view class="bar"><view class="fill" style="width:{{item.pct}}%"></view></view>
    </view>
  </view>

  <view class="card report-points-card">
    <view><view class="muted">本周累计获得</view><view class="report-week-points">+{{weekGain}} 分</view></view>
    <view class="report-points-detail"><text>历史获得 +{{earned}}</text><text>已兑换 -{{spent}}</text></view>
  </view>
</view>

<ai-assistant />
