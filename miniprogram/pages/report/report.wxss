.report-hero { padding:30rpx; border-radius:var(--radius); background:linear-gradient(135deg,#6E6CF0,#5E5CE6); color:#fff; box-shadow:0 10rpx 30rpx rgba(94,92,230,.2); }.report-hero-top,.report-progress-label,.report-metrics,.report-points-card { display:flex; align-items:center; justify-content:space-between; }.report-hero-label { font-size:23rpx; opacity:.78; }.report-hero-points { margin-top:5rpx; font-size:50rpx; font-weight:800; }.report-hero-points text { font-size:22rpx; font-weight:600; }.report-streak { text-align:right; font-size:31rpx; font-weight:700; }.report-streak text { display:block; margin-top:5rpx; font-size:20rpx; font-weight:400; opacity:.78; }.report-progress-label { margin-top:28rpx; font-size:23rpx; }.report-progress { height:12rpx; margin-top:10rpx; overflow:hidden; border-radius:999rpx; background:rgba(255,255,255,.25); }.report-progress view { height:100%; min-width:8rpx; border-radius:inherit; background:#fff; }.report-metrics { margin:20rpx 0 28rpx; padding:24rpx 12rpx; border-radius:var(--radius-sm); background:var(--surface); }.report-metrics view { display:flex; flex:1; flex-direction:column; align-items:center; gap:8rpx; }.report-metrics text:first-child { color:var(--ink-1); font-size:29rpx; font-weight:750; }.report-metrics text:last-child { color:var(--ink-3); font-size:21rpx; }.rep-bar { margin-bottom:22rpx; }.rl { display:flex; justify-content:space-between; margin-bottom:10rpx; color:var(--ink-2); font-size:26rpx; }.report-observation .h3 { margin-bottom:24rpx; }.observation-row { display:flex; gap:16rpx; padding:12rpx 0; }.observation-icon { width:48rpx; height:48rpx; flex:none; border-radius:16rpx; text-align:center; line-height:48rpx; font-size:27rpx; }.observation-icon.good { background:var(--brand-soft); color:var(--brand-700); }.observation-icon.focus { background:var(--surface-2); color:var(--ink-2); }.observation-title { margin-bottom:5rpx; color:var(--ink-1); font-size:27rpx; font-weight:700; }.report-points-card { gap:20rpx; }.report-week-points { margin-top:6rpx; color:var(--brand-700); font-size:42rpx; font-weight:800; }.report-points-detail { display:flex; flex-direction:column; align-items:flex-end; gap:10rpx; color:var(--ink-3); font-size:23rpx; }
.assessment-summary { display:flex; align-items:center; justify-content:space-between; margin-bottom:16rpx; }.assessment-level { font-size:30rpx; font-weight:800; color:var(--ink-1); }.assessment-score { width:76rpx; height:76rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#EEEDFE; color:var(--brand); font-size:30rpx; font-weight:800; }
.report-trend{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx;padding:18rpx;border-radius:16rpx;background:#F7F6FF}.trend-title{margin-bottom:5rpx;color:var(--ink-1);font-size:25rpx;font-weight:700}.trend-number{font-size:31rpx;font-weight:800}.up{color:#16835A!important}.down{color:#D55A6A!important}.trend-dim-list{display:grid;grid-template-columns:repeat(2,1fr);gap:10rpx;margin-top:14rpx}.trend-dim-list view{display:flex;justify-content:space-between;padding:12rpx 14rpx;border-radius:12rpx;background:var(--surface-2);color:var(--ink-2);font-size:22rpx}.trend-dim-list text:last-child{font-weight:700}.assessment-history{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid var(--sep)}.history-title{margin-bottom:9rpx;color:var(--ink-1);font-size:25rpx;font-weight:700}.history-row{display:flex;justify-content:space-between;padding:10rpx 0;color:var(--ink-3);font-size:22rpx}.history-row text:last-child{color:var(--ink-2);font-weight:700}
.card-head{display:flex;align-items:center;justify-content:space-between}.card-head text{color:var(--brand);font-size:24rpx}.body-metrics{display:flex;margin-top:22rpx;padding:18rpx 0;border-radius:18rpx;background:var(--surface-2)}.body-metrics view{display:flex;flex:1;flex-direction:column;align-items:center;gap:8rpx;min-width:0}.body-metrics view+view{border-left:1rpx solid var(--sep)}.body-metrics text:first-child{max-width:100%;overflow:hidden;color:var(--ink-1);font-size:27rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.body-metrics text:last-child{color:var(--ink-3);font-size:20rpx}.body-tip{margin-top:16rpx}.action-card .h3{margin-bottom:14rpx}.action-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx 0;border-top:1rpx solid var(--sep)}.action-row:first-of-type{border-top:0}.action-title{margin-bottom:6rpx;color:var(--ink-1);font-size:27rpx;font-weight:700}.action-row>text{color:var(--ink-3);font-size:34rpx}
.archive-card{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.archive-card .small{margin-top:8rpx}.archive-actions{display:flex;gap:12rpx;flex:none}.archive-actions .btn{width:auto;margin:0;padding:0 18rpx;font-size:23rpx;line-height:64rpx}
