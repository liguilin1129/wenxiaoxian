/* ===== 文小贤 · iOS 风格设计系统 ===== */
page {
  /* 色彩令牌 */
  --brand: #5E5CE6;          /* 唯一品牌强调色 */
  --brand-2: #6E6CF0;        /* 同色系渐变搭档（不引入新色相） */
  --brand-600: #4F46E5;
  --brand-700: #4338CA;
  --brand-soft: #ECECFF;
  --brand-soft2: #E0E0FF;

  --bg: #F2F2F7;             /* iOS 系统灰 Grouped 背景 */
  --surface: #FFFFFF;
  --surface-2: #FAFAFC;

  --ink-1: #1C1C1E;         /* 主文字 */
  --ink-2: #48484A;         /* 次文字 */
  --ink-3: #8E8E93;         /* 辅助/占位 */

  --sep: #E5E5EA;           /* iOS 分组内分隔线 */
  --line: #E5E5EA;
  --line-2: #F0F0F4;
  --fill: #E9E9EC;          /* iOS 控件填充灰（搜索框/开关底） */

  /* 圆角 */
  --radius: 44rpx;          /* 大圆角（hero/模态） */
  --radius-sm: 28rpx;       /* 卡片圆角 */
  --radius-xs: 20rpx;
  --group-r: 28rpx;         /* 分组卡片圆角 */
  --sheet-r: 44rpx;         /* 底部弹层大圆角 */

  --glass: saturate(180%) blur(20px);
  --shadow-soft: 0 1rpx 3rpx rgba(0,0,0,.05), 0 8rpx 24rpx rgba(0,0,0,.05);

  /* 四大维度（统一降饱和，同一明度层级，仅此一处保留语义多色） */
  --c-heart: #F0798F;  --c-heart-bg: #FBEAF0;  --c-heart-d: #C25068;
  --c-body: #54BE8C;   --c-body-bg: #E6F6EE;   --c-body-d: #3E9B73;
  --c-habit: #5E5CE6;  --c-habit-bg: #ECECFF;  --c-habit-d: #4F46E5;
  --c-taste: #DDA457;  --c-taste-bg: #FBF1E2;  --c-taste-d: #B5812F;

  background: var(--bg);
  color: var(--ink-1);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, button, scroll-view, input { box-sizing: border-box; }
button::after { border: none; }

/* 布局工具 */
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.flex1 { flex: 1; }
.muted { color: var(--ink-3); font-size: 24rpx; }
.small { font-size: 26rpx; color: var(--ink-2); }
.h3 { font-size: 32rpx; font-weight: 700; margin: 8rpx 4rpx 20rpx; }
.tn { font-size: 30rpx; font-weight: 700; color: var(--ink-1); }

/* ===== 卡片（iOS：去边框、柔阴影、大圆角） ===== */
.card {
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 28rpx;
  box-shadow: var(--shadow-soft);
  margin-bottom: 24rpx;
}
.card.flat { box-shadow: none; }

/* 全宽按钮（iOS：圆角 + 按压态） */
.btn {
  display: block;
  width: 100%;
  text-align: center;
  background: var(--brand);
  color: #fff;
  font-weight: 600;
  font-size: 30rpx;
  padding: 26rpx;
  border-radius: var(--radius-xs);
  border: none;
  transition: transform .12s ease, opacity .12s ease;
}
.btn:active { transform: scale(.97); opacity: .92; }
.btn.soft { background: var(--brand-soft); color: var(--brand-700); }
.btn.sm { padding: 16rpx 28rpx; font-size: 26rpx; width: auto; display: inline-block; }
.btn.sm:active { transform: scale(.96); }

/* 标签 pill */
.pill {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--ink-2);
  font-weight: 600;
}
.pill-heart { background: var(--c-heart-bg); color: var(--c-heart-d); }
.pill-body { background: var(--c-body-bg); color: var(--c-body-d); }
.pill-habit { background: var(--c-habit-bg); color: var(--c-habit-d); }
.pill-taste { background: var(--c-taste-bg); color: var(--c-taste-d); }

/* 进度条 */
.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--line-2);
  overflow: hidden;
  margin-top: 10rpx;
}
.bar > .fill { display: block; height: 100%; border-radius: 999rpx; background: var(--brand); }

/* 勾选框（iOS：圆形勾选） */
.check {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D1D6;
  background: var(--surface);
  display: flex; align-items: center; justify-content: center;
  flex: none;
  color: #fff; font-size: 26rpx; font-weight: 700;
  transition: background .15s, border-color .15s;
}
.check.on { background: var(--brand); border-color: var(--brand); }

/* 任务行 / 列表项 */
.task {
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 26rpx;
  box-shadow: var(--shadow-soft);
  margin-bottom: 20rpx;
}
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }

.reward {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid var(--sep);
  font-size: 27rpx; color: var(--ink-2);
}
.reward:last-child { border-bottom: none; }
.pts-pos { color: var(--brand-600); font-weight: 700; font-size: 27rpx; }
.pts-neg { color: var(--c-heart-d); font-weight: 700; font-size: 27rpx; }

/* 菜单项（我的页） */
.menu {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 28rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft);
}
.menu .mt { font-size: 29rpx; font-weight: 600; color: var(--ink-1); display: flex; align-items: center; gap: 22rpx; }
.menu .mi {
  width: 68rpx; height: 68rpx; border-radius: 20rpx;
  background: var(--brand-soft); color: var(--brand-700);
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex: none;
}
.menu .mv { font-size: 25rpx; color: var(--ink-3); }

/* 积分大卡（同色系柔和渐变） */
.points-hero {
  background: linear-gradient(135deg, #6E6CF0, #5E5CE6);
  color: #fff; border-radius: var(--radius);
  padding: 36rpx; margin-bottom: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(94, 92, 230, .22);
}
.points-hero .lbl { font-size: 24rpx; opacity: .9; }
.points-hero .num { font-size: 68rpx; font-weight: 800; letter-spacing: -2rpx; line-height: 1; margin: 6rpx 0; }
.points-hero .lv {
  display: inline-block; background: rgba(255, 255, 255, .2);
  padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600;
}

/* 四维小卡网格 */
.quad { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 8rpx; }
.quad .q {
  background: var(--surface); border-radius: var(--radius-sm);
  padding: 24rpx; box-shadow: var(--shadow-soft);
}
.quad .q .dot { width: 18rpx; height: 18rpx; border-radius: 50%; display: inline-block; margin-right: 12rpx; }
.quad .q .qn { font-size: 27rpx; font-weight: 700; display: flex; align-items: center; }
.quad .q .qp { font-size: 22rpx; color: var(--ink-3); margin-top: 12rpx; }
.quad .q .qpct { font-size: 38rpx; font-weight: 800; margin-top: 4rpx; }

/* 经典网格 */
.classic-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.classic {
  background: var(--surface); border-radius: var(--radius-sm); padding: 24rpx;
  box-shadow: var(--shadow-soft);
}
.classic .cn { font-size: 30rpx; font-weight: 700; }
.classic .cp { font-size: 22rpx; color: var(--ink-3); margin-top: 10rpx; }

/* 报告条 */
.rep-bar { margin-bottom: 22rpx; }
.rep-bar .rl { display: flex; justify-content: space-between; font-size: 26rpx; margin-bottom: 10rpx; }
.rep-bar .rl b { font-weight: 700; }

/* ===== 通用页头：毛玻璃大标题导航栏（iOS Large Title） ===== */
.scr-head {
  position: sticky; top: 0; z-index: 50;
  padding: 8rpx 32rpx 16rpx;
  background: rgba(242, 242, 247, .72);
  backdrop-filter: var(--glass);
  -webkit-backdrop-filter: var(--glass);
  border-bottom: 1rpx solid rgba(0, 0, 0, .06);
}
.scr-head .greet { font-size: 26rpx; color: var(--ink-3); }
.scr-head .title { font-size: 48rpx; font-weight: 800; margin-top: 4rpx; letter-spacing: -1rpx; line-height: 1.15; }
.scr-body { padding: 8rpx 32rpx calc(180rpx + env(safe-area-inset-bottom)); }

/* 头像 */
.avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: linear-gradient(135deg, #6E6CF0, #5E5CE6);
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 32rpx; flex: none;
}
.avatar.lg { width: 108rpx; height: 108rpx; font-size: 40rpx; }
.avatar.sm { width: 64rpx; height: 64rpx; font-size: 26rpx; }

/* ===== iOS 分组列表（Grouped List） ===== */
.igroup { margin: 28rpx 0 0; }
.igroup:first-child { margin-top: 16rpx; }
.igroup-title {
  font-size: 24rpx; font-weight: 600; color: var(--ink-3);
  padding: 0 8rpx 14rpx; letter-spacing: .3rpx;
}
.igroup-card {
  background: var(--surface);
  border-radius: var(--group-r);
  overflow: hidden;
  box-shadow: var(--shadow-soft);
}
.irow {
  display: flex; align-items: center;
  padding: 26rpx 28rpx; position: relative;
}
.irow + .irow::before {
  content: ""; position: absolute; top: 0; left: 28rpx; right: 0;
  height: 1rpx; background: var(--sep);
}
.irow .ic {
  width: 60rpx; height: 60rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; margin-right: 22rpx; flex: none;
  background: var(--brand-soft); color: var(--brand);
}
.irow .tx { flex: 1; font-size: 30rpx; color: var(--ink-1); }
.irow .rt { font-size: 28rpx; color: var(--ink-3); }
.irow .chev { color: #C7C7CC; font-size: 30rpx; margin-left: 10rpx; flex: none; }

/* 按压态 */
.tap { transition: background .15s ease, opacity .15s ease; }
.tap:active { background: var(--fill); }

/* 安全区底部留白 */
.safe-bottom { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
